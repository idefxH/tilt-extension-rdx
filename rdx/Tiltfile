# tilt-extension-rdx — rdx_app() helper.
#
# Wraps Cloud Native Buildpacks (via `pack`), Helm install, and service
# port-forwarding into a single declarative call. Designed for projects
# scaffolded by `rdx new` from an RDX opinion
# bundle, but usable from any Tiltfile that wants the same conventions.
#
# Usage in a project's Tiltfile:
#
#   load_dynamic('https://raw.githubusercontent.com/idefxH/tilt-extension-rdx/main/Tiltfile')
#   rdx_app(
#       name='my-app',
#       language='nodejs',
#   )
#
# That replaces ~30 lines of docker_build / helm / k8s_resource boilerplate
# with one call. Service port-forwards are auto-discovered from the
# project's values.yaml (under deploy/ on bundle 0.11.13+ scaffolds, or
# chart/ on older ones — chart_path defaults to auto-detection): every
# `rdx-library.services[]` entry (the unified DSL written by `rdx
# add-service`) is registered. The app's HTTP port is read from
# `rdx-library.port` in the same values.yaml — values.yaml is the source
# of truth, so the Tiltfile stays terse. Pass builder='bci' to build with
# the BCI builder (Paketo buildpacks) instead of the default heroku one.
#
# Pass `services={'<binding>': '<type>'}` explicitly only when you want to
# register a service the chart doesn't deploy itself, or narrow the
# auto-discovered set to a subset.

# Allow `local()` against whatever kube context is currently active.
# Tilt refuses to run `local()` when the active context isn't on its
# built-in allowlist (kind, microk8s, minikube, docker-desktop, …)
# because a `local()` against a prod cluster could nuke prod from a
# dev's laptop. This extension shells out via `local()` for helm
# dep-update bootstrap, the chart-alignment script, `rdx namespace
# expand`, etc. — all unavoidable — so the refusal blocks the whole
# Tiltfile. CI runs (GitHub Actions + k3s, context `rancher-desktop`)
# and any custom context name (k3d-*, a user's kubectl rename) trip it.
#
# Must be called at module top level: Tilt resolves the allowlist
# before any function body runs, so calling it from inside rdx_app()
# is too late — the first `local()` inside rdx_app() blows up before
# the allowlist mutation takes effect.
#
# Safe to allow whatever context is active: the user already pointed
# kubectl at it and ran `tilt up` against it — that's the trust
# decision. allow_k8s_contexts is additive and idempotent.
allow_k8s_contexts(k8s_context())

# Heroku CNB builder. Multi-arch (linux/amd64 + linux/arm64) so the
# buildpack inner loop runs natively on Apple Silicon — no Rosetta, no
# binfmt_misc shenanigans, no /usr/bin/env: 'node': No such file or
# directory at the npm-install step.
#
# Why not Paketo: paketobuildpacks/builder-* are amd64-only as of
# 2026-04-27. Running them on arm64 hosts forces the lifecycle through
# Rosetta inside Rancher Desktop's containerd VM, where binfmt_misc
# handler resolution is unreliable for nested execve in pack's
# ephemeral-lifecycle container. Reproduces with every Paketo tag we
# tested (jammy-base, jammy-full, all versions). Net: not actionable on
# our side until Paketo or SUSE publishes an arm64 builder. Tracked in
# tilt-extension-rdx#1 for the SUSE migration.
#
# Heroku 24 series: builder ~400MB (vs Paketo full 1.5GB), ships
# heroku/nodejs (active, v5.5.8 on 2026-04-16), heroku/python,
# heroku/go, heroku/java, heroku/ruby. Run image: heroku/heroku:24.
DEFAULT_BUILDER = 'heroku/builder:24'

# BCI CNB builder. Multi-arch (linux/amd64 + linux/arm64) builder built
# on the SUSE BCI 16.0 stack and shipping Paketo buildpacks. Selected via
# rdx_app(builder='bci'). Unlike upstream paketobuildpacks/builder-* (still
# amd64-only as of 2026-04-27, hence the arm64 Rosetta problems noted
# above) this image is published native for both arches, so the buildpack
# inner loop runs natively on Apple Silicon.
#
# The image lives in a private registry, so `pack` needs local credentials
# for ghcr.io at build time (`docker login ghcr.io`). See the preflight in
# the build block below.
BCI_BUILDER = 'ghcr.io/idefxh/builder-bci-base:16.0.2'

# Builder selector -> builder image. `builder='heroku'` (default) keeps the
# heroku/builder:24 + heroku/* buildpacks; `builder='bci'` switches to the
# BCI builder, which ships Paketo buildpacks and resolves them by its own
# detection order. A raw `builder_image` argument still overrides the
# resolved image for either selector.
BUILDER_IMAGES = {
    'heroku': DEFAULT_BUILDER,
    'bci': BCI_BUILDER,
}

# BCI builder live-update uid fix.
#
# The BCI builder builds as CNB_USER_ID=1001, but its run image
# (ghcr.io/idefxh/base-bci-run) launches the container as uid 1002. The
# CNB lifecycle exports the application layer (/workspace) owned by the
# BUILD user (1001) with 0755 directories and 0644 files, so the LAUNCH
# user (1002) has no write access under /workspace/src. Tilt's
# live_update sync runs in the container as the pod's user, so its file
# copy silently fails with EACCES — the synced file is never replaced,
# the dev server (nodemon, the Procfile `dev` process) never observes a
# change, and the app stays "updating" without ever reloading.
#
# The heroku builder uses a single uid for build AND launch, so the
# launch user owns its own source files and live_update works — which is
# why the bug only reproduces with builder='bci'.
#
# Fix: run the app pod as the builder's BUILD uid/gid so it owns the
# source files it needs to overwrite. Verified locally: with
# `--user 1001:1000` the in-container overwrite succeeds and nodemon
# logs "restarting due to changes...". Applied via the library chart's
# `podSecurityContext` (pod-scoped, so only the app pod is affected;
# sub-charts keep their own security contexts).
#
# These track the BCI builder's CNB_USER_ID / CNB_GROUP_ID
# (1001 / 1000 for builder-bci-base:16.0.x — confirmed via
# `docker inspect ... CNB_USER_ID`). If a future BCI builder changes its
# CNB user, override with RDX_BCI_RUNAS_UID / RDX_BCI_RUNAS_GID; set
# RDX_BCI_RUNAS_UID=-1 to disable the override entirely (e.g. a builder
# whose run image already matches its build uid).
BCI_RUNAS_UID = 1001
BCI_RUNAS_GID = 1000

# Per-builder, per-language build-time env (pack --env) layered on top of
# the language defaults' pack_build_env. heroku/nodejs decides dev-vs-prod
# dependency install purely from NODE_ENV (set in LANGUAGE_DEFAULTS, honoured
# by both builders). Paketo's nodejs buildpack additionally exposes BP_*
# knobs: BP_NODE_RUN_SCRIPTS controls which npm scripts run at build time —
# pinned empty here so no production `build` script fires during the dev
# inner loop (the 'dev' Procfile process runs nodemon against ./src instead).
# devDependencies (nodemon) are retained because NODE_ENV=development keeps
# them in the install layer.
BUILDER_BUILD_ENV = {
    'bci': {
        'nodejs': {'BP_NODE_RUN_SCRIPTS': ''},
    },
}


# Resolve the dynamic Paketo BP_*/BPE_* build-env for the BCI builder from
# the rdx_app() convenience knobs. Layered ON TOP of BUILDER_BUILD_ENV (the
# static per-language baseline) at `pack build --env` time.
#
# Pure function (no I/O, no globals) so tests/test_bci_paketo_env.py mirrors
# it 1:1 — the Tiltfile is Starlark and can't be imported by pytest, so the
# only way to test this construction is to keep a byte-aligned copy in the
# test and assert on its output. Keep the two in lockstep.
#
# Every knob here maps to a documented Paketo build-time variable and is a
# no-op on the heroku builder (heroku/* buildpacks don't read BP_*), so the
# build block only calls this for builder='bci' and warns when a knob is set
# for any other builder.
def _resolve_bci_build_env(language, live_reload, reload_supported,
                           node_version, bp_log_level, image_labels,
                           runtime_cert_binding, debug, debug_port):
    env = {}
    # BP_LIVE_RELOAD_ENABLED=true makes the language buildpack install
    # watchexec (present in builder-bci-base) and wrap its `web` process in
    # it. Only emit when the language actually supports it (see
    # LANGUAGE_DEFAULTS['bci_reload']) — emitting it for go would bake a
    # watchexec layer that nothing runs.
    if live_reload and reload_supported:
        env['BP_LIVE_RELOAD_ENABLED'] = 'true'
    # BP_NODE_VERSION pins the Node runtime (node-engine buildpack). Paketo
    # ALSO reads .node-version / .nvmrc / package.json#engines.node
    # automatically; this is the explicit override. Node-only.
    if node_version and language == 'nodejs':
        env['BP_NODE_VERSION'] = str(node_version)
    # BP_LOG_LEVEL=DEBUG turns on verbose buildpack logging — the first
    # thing to reach for when a BCI build misbehaves.
    if bp_log_level:
        env['BP_LOG_LEVEL'] = str(bp_log_level)
    # BP_IMAGE_LABELS: space-delimited key=value pairs applied as OCI labels
    # by the image-labels buildpack. Sorted for a stable, testable string.
    if image_labels:
        env['BP_IMAGE_LABELS'] = ' '.join(
            ['%s=%s' % (k, image_labels[k]) for k in sorted(image_labels)])
    # Runtime cert binding is ON by default in Paketo's ca-certificates
    # buildpack (a `ca-certificates` service binding is read at launch), so
    # only emit the flag when the caller explicitly opts OUT with False.
    if runtime_cert_binding == False:
        env['BP_ENABLE_RUNTIME_CERT_BINDING'] = 'false'
    # debug bakes a LAUNCH-time default via the environment-variables
    # buildpack (BPE_DEFAULT_<NAME> sets the var only if unset at runtime),
    # so the process starts its debug agent without a chart change. BPL_DEBUG_*
    # is honoured by the JVM (bellsoft-liberica); for Node use
    # additional_env={'BPE_DEFAULT_NODE_OPTIONS': '--inspect=0.0.0.0:9229'}.
    if debug:
        env['BPE_DEFAULT_BPL_DEBUG_ENABLED'] = 'true'
        if debug_port:
            env['BPE_DEFAULT_BPL_DEBUG_PORT'] = str(debug_port)
    return env


# Pick the pack --default-process for the BCI builder under live_reload.
#
# IMPORTANT: there is no `reload` process. With BP_LIVE_RELOAD_ENABLED=true
# the Paketo language buildpack (e.g. npm-start) wraps its OWN default `web`
# process in watchexec — verified from a real BCI build log:
#   web (default): watchexec --restart --watch /workspace ... -- sh start.sh
#   no-reload:     sh start.sh
# So the watchexec-wrapped process is named `web`, not `reload`. Selecting a
# non-existent `reload` hard-fails the build with
#   ERROR: tried to set reload to default but it doesn't exist
# Hence we select `web`. (The Procfile, if present, would clobber this `web`
# with a plain command — that's handled separately by excluding the Procfile
# from the build context; see _bci_procfile_exclude_action.)
#
# Returns None to mean "fall back to the Procfile-gated default". Pure —
# mirrored in the test.
def _bci_reload_default_process(live_reload, reload_supported):
    if live_reload and reload_supported:
        return 'web'
    return None


# Decide how to stop the heroku/procfile-style process types from clobbering
# Paketo's watchexec-wrapped `web` process when live_reload is on for the BCI
# builder. The procfile buildpack runs AFTER npm-start in the BCI builder's
# detection order, and a `web:` Procfile entry OVERWRITES npm-start's
# watchexec `web` with a plain command — killing live reload (confirmed from
# a real build log). The fix is to exclude the Procfile from the build
# context (a pack project descriptor with `exclude = ["Procfile"]`), so the
# procfile buildpack detects nothing and npm-start's watchexec `web` survives.
#
# Returns:
#   'exclude' -> write/pass a project descriptor that excludes the Procfile
#   'warn'    -> a user project.toml already exists; we won't clobber it, so
#                warn that live reload won't take effect until they exclude
#                the Procfile themselves
#   'none'    -> nothing to do (not bci+live_reload, or no Procfile present)
# Pure — mirrored in the test.
def _bci_procfile_exclude_action(builder_kind, live_reload, reload_supported,
                                 procfile_exists, project_toml_exists):
    if builder_kind != 'bci' or not live_reload or not reload_supported:
        return 'none'
    if not procfile_exists:
        return 'none'
    if project_toml_exists:
        return 'warn'
    return 'exclude'

# Per-language defaults. Live-update paths follow each buildpack's
# expected workspace layout. Languages requiring a full rebuild on every
# change (compiled) leave live_update_paths empty — Tilt rebuilds via
# pack on file change, with Paketo's layer cache providing the speed-up.
LANGUAGE_DEFAULTS = {
    'nodejs': {
        # heroku/nodejs in v5+ is a unified single buildpack that handles
        # engine resolution + npm install internally. The previous
        # sub-buildpacks are deprecated in v5.
        # Requires a committed package-lock.json so heroku/nodejs runs
        # npm ci (the bundle template ships one).
        # heroku/procfile reads ./Procfile to register processes —
        # 'web' for prod, 'dev' for tilt builds (nodemon -L src/index.js).
        'buildpacks': ['heroku/nodejs', 'heroku/procfile'],
        'live_update_paths': ['./src'],
        'live_update_install_trigger': ['./package.json', './package-lock.json'],
        'live_update_install_cmd': 'cd /workspace && npm install --production=false',
        # Tilt builds run the 'dev' process (nodemon -L src/index.js).
        # nodemon polls every 1s — robust against containerd/overlayfs
        # inotify quirks that break node --watch in some k8s setups.
        # Production builds (no --default-process flag) default to 'web'.
        'pack_default_process': 'dev',
        # Force NODE_ENV=development at build so heroku/nodejs runs
        # 'npm ci' instead of 'npm ci --omit=dev' and includes nodemon
        # (which is in devDependencies of the template package.json).
        'pack_build_env': {'NODE_ENV': 'development'},
        # BCI/Paketo only: with BP_LIVE_RELOAD_ENABLED=true npm-start wraps
        # its own `web` process in watchexec, so the heroku nodemon `dev:`
        # hack isn't needed (see rdx_app live_reload=). Requires an npm
        # `start` script (or a Procfile `web:` — but the Procfile is excluded
        # under live_reload so the watchexec `web` isn't clobbered).
        'bci_reload': True,
    },
    'python': {
        'buildpacks': ['heroku/python', 'heroku/procfile'],
        'live_update_paths': ['./src'],
        'live_update_install_trigger': ['./requirements.txt', './pyproject.toml', './Pipfile'],
        'live_update_install_cmd': 'cd /workspace && pip install -r requirements.txt 2>/dev/null || true',
        # python-start wraps its `web` process in watchexec under
        # BP_LIVE_RELOAD_ENABLED=true.
        'bci_reload': True,
    },
    'java': {
        # heroku/java compiles via Maven/Gradle. heroku/procfile
        # reads ./Procfile to register web/dev process types.
        # Without procfile, the CNB launcher has no default process
        # and the container crashes with "no default process".
        'buildpacks': ['heroku/java', 'heroku/procfile'],
        'live_update_paths': [],
        'live_update_install_trigger': [],
        'live_update_install_cmd': None,
        # executable-jar / spring-boot / dist-zip wrap their `web` process in
        # watchexec under BP_LIVE_RELOAD_ENABLED=true. Restarts the JVM (not
        # the whole container) on a synced class/jar change.
        'bci_reload': True,
    },
    'go': {
        # heroku/go + heroku/procfile. Go SDK is NOT in the CNB
        # runtime image (heroku/heroku:24), so in-container
        # recompilation (air, go build) is impossible. Every source
        # change triggers a full `pack build` — heroku/go's layer
        # cache keeps rebuilds to ~10-15s after the first one.
        #
        # If a future builder ships Go in the launch image (e.g.
        # RDX-SUSE builder with a `-dev` variant), re-enable
        # live_update_paths and switch dev: to air.
        'buildpacks': ['heroku/go', 'heroku/procfile'],
        'live_update_paths': [],
        'live_update_install_trigger': [],
        'live_update_install_cmd': None,
        # The BCI go-build buildpack (4.x in builder-bci-base:16.0.x) does
        # NOT support BP_LIVE_RELOAD_ENABLED / watchexec wrapping
        # (paketo-buildpacks/go-build#238 is still open), and Go is not in
        # the run image, so live_reload= can't help here. Source changes
        # fall back to a full layer-cached pack rebuild.
        'bci_reload': False,
    },
}

# Optional registry redirect for CI / local-mirror / air-gapped setups.
# When RDX_DEFAULT_REGISTRY is set, register it as Tilt's default
# registry so custom_build's $EXPECTED_REF and any chart images get
# rewritten to that host. The e2e harness uses this to point at the
# local kind-mirror (localhost:5000) without having to inject a
# default_registry() into every project Tiltfile.
#
# Top-level on purpose: Tilt requires default_registry() before any
# image builds are registered, so it has to run at extension load
# time — not inside rdx_app().
_rdx_default_registry = os.getenv('RDX_DEFAULT_REGISTRY', '')
if _rdx_default_registry:
    default_registry(_rdx_default_registry)

# Disable Tilt's secret-value scrubber for binding-secret values.
#
# The rdx library-chart writes Service-Binding-Spec-compliant Secrets
# whose stringData contains the chart `type` (`postgresql`, `prometheus`,
# `grafana`, `dex`, ...) and `provider` (`rdx-suse`). The SBS REQUIRES
# `type` to live in the Secret data — that's not optional. Tilt then
# harvests every Secret value it deploys and substitutes the literal
# strings everywhere in its log/UI output, so a workload named
# `app-prometheus-server` displays as
# `app-[redacted secret app-mon-binding:type]-server`. The k8s_resource
# registrations themselves are correct (verified via
# `tilt alpha tiltfile-result` — manifest names are clean) but the dev's
# Tilt UI shows garbled resource names that don't match what `kubectl
# get` returns.
#
# Trade-off: with scrubbing off, real Secret VALUES (passwords, OIDC
# client_secret, OAuth cookie_secret) ALSO appear in Tilt logs. In a
# `tilt up` dev session this is fine — the dev owns those secrets and
# created them locally. In a `tilt ci` CI run the test fixtures use
# throwaway random passwords (`grafpw-<sha>`, `dexpw-<sha>`) by
# convention. The alternative — scrubbing on by default — gives
# unintelligible workload names AND doesn't actually protect against
# anything since `type=prometheus` isn't a secret in the first place.
#
# Set RDX_ENABLE_TILT_SCRUB=1 to opt back in (e.g. for screen-shared
# demos where the dev wants password redaction in the UI).
if os.getenv('RDX_ENABLE_TILT_SCRUB', '') != '1':
    secret_settings(disable_scrub=True)

def _detect_lib_key(chart_path):
    """Return the top-level values key the project nests its DSL under.

    The opinionated library chart is a vendored dependency
    (chart_path/charts/<name>/) and a project's values place the DSL
    (`services[]`, `workloads[]`, `port`, per-chart `<chart>.enabled`)
    under a top-level key equal to that dependency's name (Helm nests a
    sub-chart's values under its dep name/alias). Bundles ship the library
    under different names, so this key is NOT a constant: it must be read
    from the chart, not assumed. Detect it instead of hardcoding so the
    extension tracks whatever the bundle vendors.

    Resolution order:
      1. A dependency whose vendored dir carries dsl-mappings.yaml — the
         unambiguous signature of the library chart (only available once
         `helm dep update` has run).
      2. Cold start (deps not vendored yet): a dependency whose name ends
         in `-library`.
      3. A conventionally-named dir present on disk.
      4. The modern default.
    """
    chart_meta = read_yaml(chart_path + '/Chart.yaml', default={})
    deps = chart_meta.get('dependencies') or []
    for dep in deps:
        nm = dep.get('alias') or dep.get('name') or ''
        if nm and os.path.exists(chart_path + '/charts/' + nm + '/dsl-mappings.yaml'):
            return nm
    for dep in deps:
        nm = dep.get('alias') or dep.get('name') or ''
        if nm.endswith('-library'):
            return nm
    for cand in ['rdx-library', 'suse-library']:
        if os.path.exists(chart_path + '/charts/' + cand):
            return cand
    return 'rdx-library'


# ─── CoreDNS hairpin DNS fix ────────────────────────────────────────────
#
# In k3s dev clusters, wildcard-loopback domains (`*.localtest.me`,
# `*.lvh.me`, …) resolve to 127.0.0.1 EVERYWHERE — including inside pods.
# A pod that calls an ingress-exposed peer by its public hostname
# (`auth.localtest.me`) therefore hits its OWN loopback instead of the
# Traefik ingress controller. The classic "hairpin" failure.
#
# k3s ships CoreDNS with `import /etc/coredns/custom/*.server` in its
# Corefile and auto-mounts a ConfigMap named `coredns-custom` in
# `kube-system` at `/etc/coredns/custom/` (`optional: true`). Adding a
# `<name>.server` key there defines a new DNS zone. We point the dev
# domain at the Traefik ClusterIP so in-cluster name resolution of the
# public hostname lands on the ingress controller, which then routes by
# Host header exactly as it does for external traffic.
#
# The ConfigMap is applied via k8s_yaml() so Tilt owns its lifecycle:
# created at `tilt up`, deleted at `tilt down`. The fixed name
# `coredns-custom` is a k3s convention (it's the specific name k3s
# CoreDNS imports) — note that with that fixed name a single Tilt
# session owns the object; running two rdx workspaces with different
# loopback domains at once would have them contend for it.

# Curated wildcard-loopback dev domains: every subdomain resolves to
# 127.0.0.1 by design. Matched as the bare domain or any suffix. Extend
# as new services appear; anything not listed falls through to a live
# resolve so a custom loopback domain still works and a real domain
# (staging.corp.com) never gets its DNS hijacked.
_LOOPBACK_DOMAINS = [
    'localtest.me',
    'localhost.direct',
    'lvh.me',
    'vcap.me',
    'sslip.io',
    'nip.io',
]


def _domain_is_loopback(domain):
    """True iff `domain` should have its DNS overridden to the ingress.

    Fast path: the curated wildcard-loopback list. Slow path: resolve
    the bare name on the dev's machine and accept it only when it answers
    with a loopback address. This is the safety gate the spec requires —
    we must never override DNS for a real domain.
    """
    if not domain:
        return False
    for known in _LOOPBACK_DOMAINS:
        if domain == known or domain.endswith('.' + known):
            return True
    # Resolve with whatever the host has. getent (Linux), dig, then
    # python3's resolver (macOS has no getent) — first non-empty wins.
    # `|| true` keeps a fully tool-less host from failing the Tiltfile.
    resolved = str(local(
        "_d=" + domain + "; " +
        "ip=$(getent hosts \"$_d\" 2>/dev/null | awk '{print $1; exit}'); " +
        "[ -z \"$ip\" ] && ip=$(dig +short \"$_d\" A 2>/dev/null | " +
        "grep -E '^[0-9.]+$' | head -1); " +
        "[ -z \"$ip\" ] && ip=$(python3 -c " +
        "'import socket,sys; print(socket.gethostbyname(sys.argv[1]))' " +
        "\"$_d\" 2>/dev/null); " +
        "echo \"$ip\" || true",
        quiet=True, echo_off=True,
    )).strip()
    return resolved == '127.0.0.1' or resolved == '::1'


def _ingress_cluster_ip():
    """ClusterIP of the in-cluster ingress controller, or '' if absent.

    Tries the common Traefik label selectors, then the conventional k3s
    `kube-system/traefik` Service. Returns '' (caller warns, doesn't
    fail) when nothing matches or the Service is headless (clusterIP
    None), since a headless IP can't be used as a DNS target.
    """
    # The Traefik ClusterIP is stable for the life of a cluster, but this
    # ran up to 3 kubectl round-trips on every reload for loopback domains
    # (issue #7 M3). Cache the resolved IP to /tmp, keyed on the active
    # k8s context so a context switch re-resolves rather than reusing a
    # stale cluster's IP. The cache lives in /tmp, so a reboot starts
    # clean. Only a valid (non-empty, non-"None") IP is cached.
    _cache = '/tmp/rdx-traefik-clusterip-' + k8s_context().replace('/', '_')
    ip = str(local(
        '_cf="' + _cache + '"; ' +
        'if [ -s "$_cf" ]; then cat "$_cf"; else ' +
        "ip=$(kubectl get svc -A -l 'app.kubernetes.io/name=traefik' " +
        "-o jsonpath='{.items[0].spec.clusterIP}' 2>/dev/null); " +
        "[ -z \"$ip\" ] && ip=$(kubectl get svc -A " +
        "-l 'app.kubernetes.io/name=traefik-proxy' " +
        "-o jsonpath='{.items[0].spec.clusterIP}' 2>/dev/null); " +
        "[ -z \"$ip\" ] && ip=$(kubectl get svc traefik -n kube-system " +
        "-o jsonpath='{.spec.clusterIP}' 2>/dev/null); " +
        'if [ -n "$ip" ] && [ "$ip" != None ]; then printf "%s" "$ip" > "$_cf"; fi; ' +
        'echo "$ip"; ' +
        'fi',
        quiet=True, echo_off=True,
    )).strip()
    if ip == 'None':
        return ''
    return ip


def _coredns_hairpin_yaml(domain, ip, workspace):
    """Render the `coredns-custom` ConfigMap manifest as a string.

    The `{{ .Name }}` token in the CoreDNS `template` plugin is a Go
    template evaluated by CoreDNS at query time — it MUST reach the
    cluster verbatim. It survives Starlark because this is a plain string
    literal (no .format()) and the `%`-substitution below only consumes
    the `%s` placeholders; braces pass through untouched.
    """
    slug = domain.replace('.', '-')
    return """apiVersion: v1
kind: ConfigMap
metadata:
  name: coredns-custom
  namespace: kube-system
  labels:
    app.kubernetes.io/managed-by: rdx
  annotations:
    rdx.io/workspace: "%s"
data:
  %s.server: |
    %s:53 {
        template IN A %s {
            answer "{{ .Name }} 60 IN A %s"
        }
    }
""" % (workspace, slug, domain, domain, ip)


def _apply_coredns_hairpin(domain, workspace):
    """Apply the CoreDNS hairpin ConfigMap for a loopback dev domain.

    No-op (with a one-line note) for non-loopback domains, and a warning
    — never a failure — when the ingress ClusterIP can't be found.
    """
    if not domain:
        return
    if not _domain_is_loopback(domain):
        return
    ip = _ingress_cluster_ip()
    if not ip:
        warn('[rdx] hairpin DNS: could not find the ingress controller ' +
             'ClusterIP (looked for Traefik by label and kube-system/' +
             'traefik). In-cluster calls to *.' + domain + ' will keep ' +
             'hitting pod loopback. Skipping the coredns-custom override.')
        return
    print('[rdx] hairpin DNS: pointing *.' + domain + ' at ingress ' +
          'ClusterIP ' + ip + ' via coredns-custom (kube-system).')
    k8s_yaml(blob(_coredns_hairpin_yaml(domain, ip, workspace)))


# Conventional ports for service types declared in `services`. Used by
# port_forwards so a developer can `psql -h localhost -p 5432`, etc.
# Legacy hardcoded ports — used as fallback when dsl-mappings.yaml
# doesn't declare a port for the chart type (older bundles, charts
# not in the catalog). New charts should declare their port in
# dsl-mappings.yaml instead of adding to this dict.
def rdx_app(
        name,
        language=None,
        port=None,
        services=None,
        chart_path=None,
        chart_values_files=None,
        builder='heroku',
        builder_image=None,
        extra_buildpacks=[],
        additional_env={},
        live_reload=False,
        node_version=None,
        bp_log_level=None,
        image_labels=None,
        runtime_cert_binding=None,
        debug=False,
        debug_port=None,
        live_update_paths=None,
        ui_labels=None,
        image_ref=None,
        helm_only=False,
        build_path='.'):
    """Build a project image with pack, deploy its Helm chart, and surface
    convenient port-forwards for the app and any declared services.

    Required:
        name (str): project name. Must equal the Helm release name and the
            chart's metadata.name (so the Deployment resource name matches).
        language (str|None): one of 'nodejs', 'python', 'java', 'go'. Drives
            the default buildpacks and live-update behaviour. Optional when
            image_ref or helm_only is set; an empty / None value also
            implies helm_only mode (chart-only deploy, no pack build).

    Common:
        port (int|None): HTTP port exposed by the app container. **Default
            None — derived from `rdx-library.port` in chart/values.yaml.**
            The library chart already reads `.Values.port` as the
            container's port AND the Service's targetPort, so values.yaml
            is the source of truth. Don't pass this argument unless you
            need to override; if you pass a value that mismatches
            values.yaml, the Tiltfile fails fast (forcing the dev to fix
            the duplication rather than carry two drifting numbers). When
            values.yaml has no `rdx-library.port` entry, falls back to
            the library chart's own default of 8080.
        services (dict|None): map of service binding name -> service type.
            Port-forwards are resolved from dsl-mappings.yaml (data-driven).
            Example: {'database': 'postgresql'}.
            **When None (default), services are auto-discovered from
            chart_values_files** — every entry in `rdx-library.services[]`
            (the unified DSL) and every chart with `rdx-library.<chart>.enabled:
            true` (the legacy gate) is registered. This is the recommended
            mode: `rdx service add <type> <binding>` updates values.yaml,
            and Tilt picks up the change on the next reload — nothing in the
            Tiltfile needs to be in lockstep with values.yaml.
            Pass an explicit dict to opt out of auto-discovery (e.g. to
            register a service the chart doesn't deploy itself).
        chart_path (str|None): path to the Helm chart relative to the Tiltfile.
            **Default None — auto-detected.** Prefers 'deploy/' (the new
            convention from bundle 0.11.13+ scaffolds, where the directory
            name signals the directory's purpose: it's what gets deployed
            to Kubernetes). Falls back to 'chart/' for projects scaffolded
            before the rename. Pass a path explicitly to override (e.g.
            'helm/' for a non-scaffold project, or 'chart' to force the
            legacy name during migration).
        chart_values_files (list[str]): values files passed to helm. Default
            [chart_path + '/values.yaml'] (so values.yaml is resolved inside
            the chart directory). Override with paths relative to the Tiltfile
            if your project keeps values somewhere else.

    Brownfield:
        image_ref (str|None): pre-built container image (e.g.
            'registry.corp.com/my-app:v2.3.1'). Skips pack build entirely
            and passes image.repository + image.tag to helm.
        helm_only (bool): when True, skip ALL image management. The user
            provides their image through their own mechanism. Just helm
            deploy + port-forwards.

    Override:
        builder (str): CNB builder family. 'heroku' (default) uses
            heroku/builder:24 with heroku/* buildpacks; 'bci' uses the BCI
            builder (ghcr.io/idefxh/builder-bci-base), which ships Paketo
            buildpacks and resolves the language buildpacks by its own
            detection order — callers don't restate buildpack IDs. With
            'bci', `pack` needs local ghcr.io credentials (run
            `docker login ghcr.io` once); a preflight warns if none are
            found.
        builder_image (str): raw CNB builder image, overriding the image
            resolved from `builder` while keeping that builder's buildpack
            family. E.g. pin a digest:
            builder_image='ghcr.io/idefxh/builder-bci-base:16.0.2'.
        extra_buildpacks (list[str]): additional CNB buildpacks. Useful for
            the future RDX OTel buildpack or a service-binding buildpack.
            These are passed verbatim — namespace them for the selected
            builder (paketo-buildpacks/* when builder='bci') and pin a
            version, since the BCI builder bundles multiple versions of each
            buildpack. With builder='heroku' they are appended to the
            language defaults; with builder='bci' they are the only
            buildpacks named explicitly (the builder detects the rest).
        additional_env (dict): build-time env vars passed via `pack build --env`.
            E.g. {'BP_NODE_VERSION': '22'}. This is the raw escape hatch for
            any Paketo BP_*/BPE_* knob not surfaced as a dedicated argument
            (e.g. Go: BP_GO_TARGETS / BP_GO_BUILD_LDFLAGS; Java:
            BP_JVM_VERSION / BP_MAVEN_BUILD_ARGUMENTS / BP_GRADLE_BUILD_ARGUMENTS;
            Python: BP_CPYTHON_VERSION). The dedicated args below win over
            additional_env on a key clash (curated defaults applied last).

        Paketo / BCI builder knobs (builder='bci' only — these map to Paketo
        BP_*/BPE_* build vars that the heroku/* buildpacks don't read. Setting
        any of them with builder='heroku' prints one warning and is ignored;
        the heroku path already live-reloads via the Procfile `dev:` process):

        live_reload (bool): default False. When True, sets
            BP_LIVE_RELOAD_ENABLED=true (Paketo wraps the buildpack's own
            `web` process in watchexec), selects `--default-process web`, and
            EXCLUDES the project's Procfile from the build context via a pack
            project descriptor — otherwise the procfile buildpack's `web:`
            entry overwrites the watchexec-wrapped `web` and reload silently
            stops working. A Tilt live_update file sync then restarts just
            the app process (the Paketo-native equivalent of the heroku
            nodemon `dev:` hack). Requires an npm `start` script (Node) /
            equivalent native entrypoint, since the Procfile is excluded.
            Supported for nodejs/python/java; ignored with a warning for go
            (its BCI buildpack doesn't support watchexec reload and Go isn't
            in the run image). If the project ships its own project.toml, the
            Procfile is left in place (we don't clobber a user descriptor)
            and a warning explains how to exclude it. NOTE: watchexec uses
            inotify by default, which can miss events on some
            containerd/overlayfs setups — if reloads don't fire, the default
            nodemon path (live_reload=False) is the safe fallback.
        node_version (str): pin the Node runtime via BP_NODE_VERSION
            (nodejs only). Paketo ALSO auto-reads .node-version, .nvmrc and
            package.json#engines.node — prefer committing one of those; this
            argument is the explicit override.
        bp_log_level (str): BP_LOG_LEVEL for verbose buildpack logs, e.g.
            'DEBUG'. First thing to reach for when a BCI build misbehaves.
        image_labels (dict): OCI labels baked by the image-labels buildpack
            via BP_IMAGE_LABELS (space-delimited key=value pairs).
        runtime_cert_binding (bool): the ca-certificates buildpack reads a
            `ca-certificates` service binding at LAUNCH by default (already
            on). Pass False to disable (BP_ENABLE_RUNTIME_CERT_BINDING=false);
            True/None leave the Paketo default untouched.
        debug (bool): bake a launch-time debug default via the
            environment-variables buildpack
            (BPE_DEFAULT_BPL_DEBUG_ENABLED=true), so the runtime process
            starts its debug agent. Honoured by the JVM (bellsoft-liberica);
            for Node set additional_env={'BPE_DEFAULT_NODE_OPTIONS':
            '--inspect=0.0.0.0:<port>'} instead. Forward the debug port
            yourself (`kubectl port-forward` / a Tilt port_forward) — this
            flag only configures the image, it does not open a port.
        debug_port (int): paired with debug=True, sets
            BPE_DEFAULT_BPL_DEBUG_PORT.

        Monorepos: pass build_path='<subdir>' (it becomes `pack build
        --path <subdir>`), which scopes the build context to that directory
        for every builder — no separate BP_NODE_PROJECT_PATH needed.

        live_update_paths (list[str]): override default sync paths. Pass an
            empty list to disable live_update entirely.
        ui_labels (dict): map of resource name -> Tilt UI label. Defaults
            map the app to 'app', services to 'services'.
    """
    if not helm_only and not image_ref:
        if not language:
            helm_only = True
        elif language not in LANGUAGE_DEFAULTS:
            fail('rdx_app: unsupported language %r. Supported: %s' % (
                language, ', '.join(sorted(LANGUAGE_DEFAULTS.keys()))))

    # Auto-detect chart_path when caller didn't pass one. Prefer deploy/
    # (bundle template 0.11.13+ scaffolds) and fall back to chart/ (older
    # scaffolds). Project Tiltfiles that pass chart_path='chart' or
    # chart_path='deploy' explicitly bypass this — explicit always wins.
    # Final fallback to 'chart' for projects with neither directory yet
    # (preserves the historical default so existing tests / fixtures keep
    # working).
    # Note: Tilt's Starlark `os.path` exposes `exists()` but NOT `isdir()`
    # (verified at runtime — the latter raises 'module has no .isdir field
    # or method'). We probe for `<dir>/Chart.yaml` instead, which is a
    # tighter signal anyway: a deploy/ or chart/ that doesn't carry a
    # Chart.yaml is useless to helm regardless of its directory-ness.
    if chart_path == None:
        if os.path.exists('deploy/Chart.yaml'):
            chart_path = 'deploy'
        elif os.path.exists('chart/Chart.yaml'):
            chart_path = 'chart'
        else:
            chart_path = 'chart'

    # ─── Library values key detection ──────────────────────────────────
    # Every read of the project's DSL nests under this key. Detect it from
    # the vendored library dependency rather than assuming a fixed name —
    # bundles ship the library chart under different names and a hardcoded
    # key silently reads nothing (no services discovered, no charts kept by
    # the dep filter, wrong workload names).
    _lib_key = _detect_lib_key(chart_path)

    # ─── Stage auto-detection ──────────────────────────────────────────
    # Resolve the RDX stage once, used by every `rdx render --stage`
    # call below. Priority:
    #   1. RDX_STAGE env var (explicit override, e.g. CI).
    #   2. .rdx/stage file at the project root (written by `rdx stage`).
    #   3. Fallback to 'dev' (safe default for inner-loop).
    _stage = os.getenv('RDX_STAGE', '')
    if not _stage:
        _stage_file = os.path.join(chart_path, '..', '.rdx', 'stage')
        if os.path.exists(_stage_file):
            _stage = str(read_file(_stage_file)).strip()
    if not _stage:
        _stage = 'dev'

    labels = ui_labels or {}

    # ─── Namespace + pullsecret mirror (must run EARLY) ─────────────────
    # Resolve the deploy namespace, ensure it exists, and mirror the
    # application-collection imagePullSecret BEFORE any image builds are
    # registered or `helm dep update` work begins. Two reasons:
    #
    #   1. Race window: registering custom_build / k8s_yaml later in this
    #      function queues those for Tilt's reconciler. Pods that pull
    #      from dp.apps.rancher.io land on ImagePullBackOff if the secret
    #      isn't already in the target NS the moment kubelet first sees
    #      the pod spec. With this block at the bottom of the function,
    #      slow `helm dep update` runs left a window where pods could be
    #      scheduled before kubectl finished the mirror. The e2e harness
    #      worked around this by pre-creating namespaces (and the secret)
    #      itself — that workaround can go away now that the mirror runs
    #      before any workload registration in this function.
    #
    #   2. Same `local()` calls, same logic — only the position moved.
    #      Functionally identical for the single-NS case; the win is the
    #      ordering guarantee versus image-build / k8s_yaml registration
    #      below.
    #
    # Namespace expansion: shell out to `rdx namespace expand` (single
    # source of truth, rdx-cli 0.1.47+), with a Starlark fallback for
    # older rdx binaries. Reads `.rdx/project.yaml` namespace.local,
    # substitutes {{.project}} / {{.user}}.
    # Probe for the rdx binary once per rdx_app() call and reuse the result
    # at every downstream site (namespace expansion here, `rdx render`
    # later). A single shell-out reports both whether rdx is on PATH and
    # whether it understands the `namespace` subcommand (rdx-cli 0.1.47+,
    # which owns canonical namespace expansion), so we don't pay for
    # repeated blocking probes on every Tiltfile re-eval.
    # One shell round-trip does three things that used to be two separate
    # forks every reload (issue #7 #2+#3, H3): probe rdx presence + the
    # `namespace` subcommand, then expand the namespace — with the
    # expansion cached to /tmp so steady-state reloads skip the
    # `rdx namespace expand` fork entirely (issue #7 M2). The cache is
    # keyed on the project directory (cksum of $PWD, so co-located
    # projects don't collide) and invalidated whenever .rdx/project.yaml
    # is newer than the cache file — that file plus $USER (process-stable)
    # are the only inputs the expansion depends on. Emits three
    # space-separated fields: present, can_expand, namespace (a k8s
    # namespace is a DNS label, so it never contains a space).
    _rdx_probe = str(local(
        'if command -v rdx > /dev/null 2>&1; then _p=yes; else _p=no; fi; ' +
        'if [ "$_p" = yes ] && rdx namespace --help > /dev/null 2>&1; ' +
        'then _c=yes; else _c=no; fi; ' +
        '_ns=""; ' +
        'if [ "$_c" = yes ]; then ' +
        '  _ck=/tmp/rdx-nsexpand-$(pwd | cksum | cut -d" " -f1); ' +
        '  if [ -f "$_ck" ] && [ "$_ck" -nt .rdx/project.yaml ]; then ' +
        '    _ns=$(cat "$_ck"); ' +
        '  else ' +
        '    _ns=$(rdx namespace expand) && printf "%s" "$_ns" > "$_ck"; ' +
        '  fi; ' +
        'fi; ' +
        'printf "%s %s %s\\n" "$_p" "$_c" "$_ns"',
        quiet=True, echo_off=True)).strip().split()
    _rdx_present = len(_rdx_probe) > 0 and _rdx_probe[0] == 'yes'
    _rdx_can_expand = len(_rdx_probe) > 1 and _rdx_probe[1] == 'yes'
    if _rdx_can_expand:
        namespace = _rdx_probe[2] if len(_rdx_probe) > 2 else ''
        if not namespace:
            fail('rdx_app: `rdx namespace expand` returned empty output. Check `.rdx/project.yaml`.')
    else:
        # Legacy fallback: in-Tiltfile expander (kept simple — covers UC1
        # and UC2 patterns; for richer cases the user should upgrade to
        # rdx-cli 0.1.47+ which owns the canonical logic).
        project_meta = read_yaml('.rdx/project.yaml', default={})
        ns_template = ((project_meta.get('namespace', {}) or {}).get('local', '') or '{{.project}}')
        user_value = str(local('echo "${USER:-default}"', quiet=True, echo_off=True)).strip() or 'default'
        namespace = ns_template
        for token, value in [('{{.project}}', name), ('{{ .project }}', name),
                             ('{{.user}}', user_value), ('{{ .user }}', user_value)]:
            namespace = namespace.replace(token, value)
        if '{{' in namespace or '}}' in namespace:
            fail((
                'rdx_app: namespace template %r contains an unrecognised token ' +
                'after expansion (got %r). Allowed tokens: {{.project}}, {{.user}}. ' +
                'Edit .rdx/project.yaml namespace.local to fix, or install rdx 0.1.47+ ' +
                'so this extension can shell out to `rdx namespace expand` instead.'
            ) % (ns_template, namespace))

    # ─── One-shot bootstrap guard ──────────────────────────────────────
    # Namespace creation and the pull-secret mirror below only need to run
    # once per session, but Tilt re-evaluates this whole Tiltfile on every
    # file save. Gate the blocking kubectl round-trips behind a /tmp
    # sentinel so steady-state reloads skip them (~7 cluster API calls per
    # reload otherwise). The sentinel lives in /tmp, so a reboot — a
    # genuinely fresh session — starts clean.
    #
    # The sentinel isn't trusted blindly: one `kubectl get namespace`
    # doubles as a liveness probe, so if the namespace is torn down
    # out-of-band the next re-eval rebuilds it (and re-mirrors the secret).
    # That single call replaces the handful the full bootstrap makes.
    _bootstrap_sentinel = '/tmp/rdx-' + namespace + '-bootstrapped'
    _bootstrap_done = os.path.exists(_bootstrap_sentinel) and str(local(
        'kubectl get namespace ' + namespace +
        ' > /dev/null 2>&1 && echo yes || echo no',
        quiet=True, echo_off=True)).strip() == 'yes'

    # Pre-create the namespace idempotently. Tilt invokes `helm template`
    # (not `helm install --create-namespace`) so the namespace must exist
    # before k8s_yaml applies the rendered manifests. `kubectl create
    # --dry-run=client | kubectl apply` is idempotent — succeeds whether
    # the namespace is new or already there.
    if not _bootstrap_done:
        local(
            'kubectl create namespace ' + namespace +
            ' --dry-run=client -o yaml | kubectl apply -f -',
            quiet=True, echo_off=True)

    # Mirror the application-collection imagePullSecret from `default` to
    # the deploy namespace if it's missing. Background:
    #   - The Application Collection Rancher Desktop extension installs
    #     the Secret in `default` only. With NS Phase A (rdx 0.1.43+),
    #     every project deploys to its own namespace (`{{.project}}` or
    #     a multi-dev `{{.project}}-{{.user}}` template), so the Secret
    #     is never automatically present where it's needed.
    #   - The pod's spec carries `imagePullSecrets: [application-collection]`
    #     unconditionally. Without the Secret in NS, kubelet logs
    #     `Unable to retrieve some image pull secrets`. App image pulls
    #     from dp.apps.rancher.io (BCI base, SUSE subchart images) all
    #     fail with ImagePullBackOff — locally Tilt can mask this by
    #     building images itself, but any real subchart pull cracks open.
    #
    # Strategy:
    #   1. If the target NS already has the Secret → skip silently.
    #   2. Else if `default` has it → kubectl get -o yaml | sed | apply.
    #      Strips namespace + cluster-bound metadata so apply lands in
    #      the new ns. Idempotent (apply, not create).
    #   3. Else loud failure with the remediation hint pointing at
    #      `helm registry login` + the SUSE extension docs.
    #
    # Three escape hatches to coexist with operator-managed distribution
    # (kubernetes-reflector / External Secrets / GitOps / manual):
    #
    #   1. Env var RDX_SKIP_PULLSECRET_MIRROR=1 (cluster-wide).
    #   2. Namespace label rdx.suse.com/pullsecret-managed-by=operator
    #      — set this on a project NS to declare "an operator owns the
    #      pullsecret here, hands off". Per-NS, persistent in YAML.
    #   3. Source-side annotation: if Secret/application-collection in
    #      `default` carries `external-secrets.io/owned-by` or
    #      `reflector.v1.k8s.emberstack.com/reflection-allowed=true` we
    #      take that as proof an operator distributes it and we step
    #      back — letting the operator's controller reconcile in its
    #      own time on the project NS.
    #
    # Step 0 (target-NS already has it) is the universal safety net:
    # whatever distribution mechanism wrote it first, we don't touch.
    if not _bootstrap_done and os.getenv('RDX_SKIP_PULLSECRET_MIRROR', '') != '1':
        local(
            "set -e; " +
            # Step 0: target NS already has the Secret — done.
            "if kubectl get secret -n " + namespace + " application-collection " +
            ">/dev/null 2>&1; then exit 0; fi; " +
            # Step 0b: target NS is operator-managed via label.
            "if [ \"$(kubectl get ns " + namespace + " -o " +
            "jsonpath='{.metadata.labels.rdx\\.io/pullsecret-managed-by}' " +
            "2>/dev/null)\" = 'operator' ]; then " +
            "echo '[rdx] skipping pullsecret mirror " +
            "(ns " + namespace + " labelled rdx.suse.com/pullsecret-managed-by=operator)'; " +
            "exit 0; fi; " +
            # Step 0c: source Secret is operator-managed (ESO / reflector).
            # Don't fight the operator — step back and let its controller
            # propagate to the project NS on its own.
            "if [ -n \"$(kubectl get secret -n default application-collection -o " +
            "jsonpath='{.metadata.annotations.external-secrets\\.io/owned-by}' " +
            "2>/dev/null)\" ]; then " +
            "echo '[rdx] skipping pullsecret mirror " +
            "(default Secret has external-secrets.io annotation; ESO will distribute)'; " +
            "exit 0; fi; " +
            "if [ \"$(kubectl get secret -n default application-collection -o " +
            "jsonpath='{.metadata.annotations.reflector\\.v1\\.k8s\\.emberstack\\.com/reflection-allowed}' " +
            "2>/dev/null)\" = 'true' ]; then " +
            "echo '[rdx] skipping pullsecret mirror " +
            "(default Secret has reflector annotation; kubernetes-reflector will distribute)'; " +
            "exit 0; fi; " +
            # Step 1: source missing — loud fail.
            "if ! kubectl get secret -n default application-collection " +
            ">/dev/null 2>&1; then " +
            "echo '[rdx] FATAL: Secret/application-collection not found " +
            "in `default` (the SUSE Rancher Desktop extension would normally " +
            "install it there). Either install/launch the SUSE extension, " +
            "OR run `helm registry login dp.apps.rancher.io` then bootstrap " +
            "the Secret manually via kubectl create secret docker-registry; " +
            "OR set RDX_SKIP_PULLSECRET_MIRROR=1 if your cluster uses " +
            "kubernetes-reflector / External Secrets to distribute it.' >&2; " +
            "exit 1; fi; " +
            # sed strips instance-bound metadata (namespace + uid +
            # resourceVersion + creationTimestamp) so the doc is
            # namespace-portable. kubectl apply -n <target> then anchors
            # it to the deploy NS. No jq dep — macOS doesn't ship one.
            "kubectl get secret -n default application-collection -o yaml | " +
            "sed -e '/^  namespace:/d' " +
            "-e '/^  uid:/d' " +
            "-e '/^  resourceVersion:/d' " +
            "-e '/^  creationTimestamp:/d' | " +
            "kubectl apply -n " + namespace + " -f - >/dev/null && " +
            "echo '[rdx] mirrored Secret/application-collection " +
            "default -> " + namespace + "'",
            quiet=False, echo_off=True)

    # Record that this namespace was bootstrapped so subsequent reloads
    # skip the work above. Touched on the cold path regardless of whether
    # the mirror ran (RDX_SKIP_PULLSECRET_MIRROR=1 / operator-managed
    # clusters still want the skip on later reloads).
    if not _bootstrap_done:
        local('touch ' + _bootstrap_sentinel, quiet=True, echo_off=True)

    # ─── Workloads[] detection ──────────────────────────────────────────
    # New DSL (bundle v0.11+): `rdx-library.workloads[]` array in
    # values.yaml. Each workload carries its own image, port, ingress,
    # shape. When present, custom_build and k8s_resource iterate the
    # array; when absent, we fall back to the legacy single-image mode
    # so projects that haven't migrated keep working.
    _primary_values_file = chart_path + '/values.yaml'
    if chart_values_files != None and len(chart_values_files) > 0:
        _primary_values_file = chart_values_files[0]
    _early_values = read_yaml(_primary_values_file, default={})
    _early_lib = (_early_values.get(_lib_key, {}) or {})
    _workloads = _early_lib.get('workloads') or []

    # ─── Image strategy: pack build / pre-built image / helm-only ───
    # Track the resolved builder family across the function. Set in the
    # pack-build branch below; stays None for helm_only / image_ref
    # deploys (where no builder runs). Read at the helm() step to decide
    # the BCI live-update runAsUser fix.
    _builder_kind = None
    if helm_only:
        pass
    elif image_ref:
        # Pre-built image: parse registry/repo:tag and pass to helm.
        # No pack build, no custom_build. Tilt just deploys the image.
        if ':' in image_ref:
            _img_repo, _img_tag = image_ref.rsplit(':', 1)
        else:
            _img_repo = image_ref
            _img_tag = 'latest'
    else:
        defaults = LANGUAGE_DEFAULTS[language]

        # Resolve the builder family. `builder` selects heroku (default) or
        # bci; `builder_image` is a raw image override layered on top.
        _builder_kind = builder or 'heroku'
        if _builder_kind not in BUILDER_IMAGES:
            fail('rdx_app: unknown builder %r. Supported: %s' % (
                _builder_kind, ', '.join(sorted(BUILDER_IMAGES.keys()))))
        builder = builder_image or BUILDER_IMAGES[_builder_kind]

        # Resolve the buildpack list. The BCI builder bundles multiple
        # versions of each Paketo buildpack, so naming one without a version
        # is ambiguous and `pack` refuses to build. Instead let the builder's
        # built-in detection order resolve the language buildpacks
        # (node-engine -> npm-install -> procfile, and the equivalents for
        # other languages). Only caller-supplied extra_buildpacks are passed
        # explicitly, with whatever version the caller pins.
        if _builder_kind == 'bci':
            buildpacks = list(extra_buildpacks)
        else:
            buildpacks = defaults['buildpacks'] + extra_buildpacks

        # The Paketo BP_*/BPE_* convenience knobs only affect the BCI
        # builder. Warn once (rather than baking no-op env layers) when any
        # are set for a non-bci builder, then ignore them below.
        _reload_supported = bool(defaults.get('bci_reload'))
        if _builder_kind != 'bci':
            _bci_only_knobs = []
            if live_reload:
                _bci_only_knobs.append('live_reload')
            if node_version != None:
                _bci_only_knobs.append('node_version')
            if bp_log_level != None:
                _bci_only_knobs.append('bp_log_level')
            if image_labels != None:
                _bci_only_knobs.append('image_labels')
            if runtime_cert_binding != None:
                _bci_only_knobs.append('runtime_cert_binding')
            if debug:
                _bci_only_knobs.append('debug')
            if _bci_only_knobs:
                print('rdx: warning — ' + ', '.join(_bci_only_knobs) +
                      ' only affect the BCI builder (Paketo BP_*/BPE_* knobs); ' +
                      'ignored for builder=' + repr(_builder_kind) + '. The ' +
                      'heroku path already live-reloads via the Procfile `dev:` ' +
                      'process (nodemon).')
        elif live_reload and not _reload_supported:
            # builder='bci' but this language's buildpack contributes no
            # watchexec `reload` process (e.g. go-build). Don't bake a dead
            # BP_LIVE_RELOAD layer or select a non-existent `reload` process
            # (which would hard-fail pack build) — warn and fall back to the
            # full layer-cached rebuild.
            print('rdx: warning — live_reload=True ignored for language ' +
                  repr(language) + ' on the BCI builder: its buildpack ' +
                  'contributes no watchexec `reload` process. Source changes ' +
                  'trigger a full (layer-cached) pack rebuild.')

        # Preflight: the BCI builder lives in a private registry, so `pack`
        # must be able to pull it (and its run image) with local ghcr.io
        # credentials. Warn — don't hard-fail — because credential helpers
        # (osxkeychain, ecr-login) store auth outside ~/.docker/config.json
        # where this cheap grep can't see it. Set RDX_SKIP_GHCR_CHECK=1 to
        # silence. The actual pull failure (if any) surfaces with a clear
        # 401 from pack itself.
        if _builder_kind == 'bci' and os.getenv('RDX_SKIP_GHCR_CHECK', '') != '1':
            local(
                "if [ -f \"$HOME/.docker/config.json\" ] && " +
                "grep -q 'ghcr.io' \"$HOME/.docker/config.json\" 2>/dev/null; then exit 0; fi; " +
                "echo '[rdx] WARN: no ghcr.io entry in ~/.docker/config.json. " +
                "The BCI builder (" + builder + ") is in a private registry; " +
                "run `docker login ghcr.io` if `pack build` fails to pull it. " +
                "Set RDX_SKIP_GHCR_CHECK=1 to silence this check.' >&2",
                quiet=False, echo_off=True)

        sync_paths = live_update_paths if live_update_paths != None else defaults['live_update_paths']

        # Cache flags differ by builder. The heroku/* lifecycle accepts a
        # host bind-mount cache (format=bind;source=<dir>), giving a stable
        # on-disk cache under /tmp that survives `pack` invocations.
        #
        # The Paketo lifecycle shipped in the BCI builder does NOT support
        # bind caches the same way: it stats /cache inside an ephemeral
        # exporter helper and bails with
        #   [exporter] ERROR: failed to create volume cache:
        #              stat /cache: no such file or directory
        # so for any non-heroku builder we use a NAMED Docker volume
        # (format=volume;name=<vol>). The Paketo lifecycle creates the
        # volume on first build and reuses it on subsequent builds, giving
        # the same persistent-cache speed-up the bind cache gives heroku.
        cache_dir = '/tmp/rdx-pack-cache-' + name
        cache_vol = 'rdx-pack-cache-' + name
        pack_args = ['pack', 'build', '$EXPECTED_REF']
        if _builder_kind == 'heroku':
            pack_args.extend([
                '--cache', '"type=build;format=bind;source=' + cache_dir + '"',
                '--cache', '"type=launch;format=bind;source=' + cache_dir + '-launch"',
            ])
        else:
            pack_args.extend([
                '--cache', '"type=build;format=volume;name=' + cache_vol + '"',
                '--cache', '"type=launch;format=volume;name=' + cache_vol + '-launch"',
            ])
        pack_args.extend(['--builder', builder])
        for bp in buildpacks:
            pack_args.extend(['--buildpack', bp])
        for k, v in additional_env.items():
            pack_args.extend(['--env', '%s=%s' % (k, v)])
        # Default process selection. With builder='bci' + live_reload, the
        # watchexec-wrapped process is the language buildpack's own `web`
        # (npm-start et al. wrap `web` when BP_LIVE_RELOAD_ENABLED=true), so
        # we select `web`. There is NO `reload` process — selecting one would
        # hard-fail the build. The Procfile (which would clobber `web` with a
        # plain command) is excluded from the build context below. Otherwise
        # fall back to the language's Procfile-gated default ('dev:' nodemon).
        _reload_proc = None
        if _builder_kind == 'bci':
            _reload_proc = _bci_reload_default_process(live_reload, _reload_supported)
        if _reload_proc:
            pack_args.extend(['--default-process', _reload_proc])
        else:
            dev_proc = defaults.get('pack_default_process')
            if dev_proc:
                # Only pass --default-process if the Procfile actually declares
                # that process name. Brownfield apps typically only have 'web:';
                # forcing 'dev' would crash pack build with "tried to set dev to
                # default but it doesn't exist".
                _procfile_path = build_path + '/Procfile'
                _has_dev_proc = False
                if os.path.exists(_procfile_path):
                    _pf_content = str(read_file(_procfile_path))
                    for _pf_line in _pf_content.splitlines():
                        if _pf_line.startswith(dev_proc + ':'):
                            _has_dev_proc = True
                            break
                if _has_dev_proc:
                    pack_args.extend(['--default-process', dev_proc])
        for k, v in (defaults.get('pack_build_env') or {}).items():
            pack_args.extend(['--env', '%s=%s' % (k, v)])
        # Builder-specific env (e.g. Paketo BP_* knobs for the BCI builder)
        # layered on top of the language defaults above.
        for k, v in (BUILDER_BUILD_ENV.get(_builder_kind, {}).get(language, {}) or {}).items():
            pack_args.extend(['--env', '%s=%s' % (k, v)])
        # Dynamic Paketo BP_*/BPE_* knobs derived from rdx_app() arguments
        # (live_reload, node_version, image_labels, debug, ...). BCI only;
        # see _resolve_bci_build_env. Applied last so the curated knobs win
        # on a key clash with additional_env / BUILDER_BUILD_ENV.
        if _builder_kind == 'bci':
            _bci_env = _resolve_bci_build_env(
                language, live_reload, _reload_supported, node_version,
                bp_log_level, image_labels, runtime_cert_binding,
                debug, debug_port)
            for k, v in _bci_env.items():
                # custom_build runs this command through a shell, so a value
                # with spaces (BP_IMAGE_LABELS is space-delimited key=value
                # pairs) would split into extra tokens — `team=platform`
                # becomes a stray positional arg to pack. Wrap such values in
                # double quotes (matching the --cache quoting style above) so
                # the shell keeps them as one argument. Keys/values must not
                # themselves contain a double quote.
                if ' ' in str(v):
                    pack_args.extend(['--env', '%s="%s"' % (k, v)])
                else:
                    pack_args.extend(['--env', '%s=%s' % (k, v)])
        # Procfile exclusion for builder='bci' + live_reload. The BCI
        # builder's procfile buildpack runs after npm-start and a `web:`
        # Procfile entry OVERWRITES npm-start's watchexec-wrapped `web` with
        # a plain command — killing live reload. Exclude the Procfile from
        # the build context via a pack project descriptor so the procfile
        # buildpack detects nothing and the watchexec `web` survives. Skip
        # (with a warning) when the project already ships its own
        # project.toml, so we never clobber a user descriptor.
        _excl_action = _bci_procfile_exclude_action(
            _builder_kind, live_reload, _reload_supported,
            os.path.exists(build_path + '/Procfile'),
            os.path.exists(build_path + '/project.toml'))
        if _excl_action == 'exclude':
            _descriptor_path = '/tmp/rdx-pack-descriptor-' + name + '.toml'
            _descriptor_content = '\n'.join([
                '# Generated by tilt-extension-rdx (builder=bci, live_reload=True).',
                '# Excludes the Procfile so heroku/procfile-style process types',
                "# don't overwrite Paketo npm-start's watchexec-wrapped `web`.",
                '[_]',
                'schema-version = "0.2"',
                '',
                '[io.buildpacks]',
                'exclude = ["Procfile"]',
                '',
            ])
            # Write at eval time (re-run on every Tiltfile reload — idempotent)
            # so the descriptor exists when custom_build later invokes pack.
            local(
                "cat > '" + _descriptor_path + "' <<'RDXEOF'\n" +
                _descriptor_content + "RDXEOF\n",
                quiet=True, echo_off=True)
            pack_args.extend(['--descriptor', _descriptor_path])
        elif _excl_action == 'warn':
            print('rdx: warning — live_reload=True with builder=bci, but ' +
                  build_path + '/project.toml exists, so the Procfile is NOT ' +
                  'excluded from the build. The procfile buildpack will ' +
                  "overwrite Paketo's watchexec-wrapped `web` process and live " +
                  'reload will not take effect. Add `exclude = ["Procfile"]` ' +
                  'under [io.buildpacks] in your project.toml to enable it.')

        # Everything except --path is common to all workloads. Each
        # workload entry may carry its own build_path (the real source
        # dir, written into deploy/values.yaml by the rdx CLI); append
        # --path per build below. Legacy single-workload mode uses the
        # rdx_app() build_path argument.
        pack_cmd_base = ' '.join(pack_args)
        pack_cmd = pack_cmd_base + ' --path ' + build_path

        if language == 'go' and os.path.exists('go.mod'):
            local(
                "set -e; " +
                "if ! command -v go >/dev/null 2>&1; then " +
                "echo '[rdx] go not on PATH; skipping go mod tidy preflight' >&2; " +
                "exit 0; fi; " +
                "if [ ! -f go.sum ] || [ go.mod -nt go.sum ]; then " +
                "echo '[rdx] running go mod tidy (go.sum missing or stale)'; " +
                "go mod tidy; " +
                "fi",
                quiet=False, echo_off=True,
            )

        live_update_steps = []
        for path in sync_paths:
            sync_target = '/workspace/' + path.lstrip('./')
            live_update_steps.append(sync(path, sync_target))
        install_cmd = defaults.get('live_update_install_cmd')
        install_trigger = defaults.get('live_update_install_trigger', [])
        if install_cmd and install_trigger:
            live_update_steps.append(run(install_cmd, trigger=install_trigger))

        deps = sync_paths if sync_paths else ['.']

        # custom_build push semantics: on dev machines (Rancher Desktop,
        # Mac Docker) the local Docker daemon and the cluster's container
        # runtime share containerd, so a pack build that lands in the
        # daemon is immediately visible to the cluster — no push needed.
        # That's the default: skips_local_docker=True + disable_push=True
        # ("the build command handled the push; Tilt, stay out of the way").
        #
        # In CI against a separate k8s (k3s with its own containerd, kind,
        # k3d, …) the image must reach the cluster via a real registry.
        # Pack doesn't publish without --publish, so Tilt has to push the
        # daemon-resident image to default_registry itself. Flipping both
        # flags to False lets Tilt do that: it inspects the local daemon
        # for the pack-tagged image and `docker push`-es it to the
        # registry configured by default_registry().
        #
        # Opt-in via env var so dev behaviour stays unchanged.
        _local_push = os.getenv('RDX_TILT_PUSH_TO_REGISTRY') == '1'
        _skips_local_docker = not _local_push
        _disable_push = not _local_push

        if _workloads:
            # Workloads[] mode: build each workload whose image.tag == 'dev'.
            # Workloads pointing to a real registry image (tag != 'dev') are
            # pre-built and don't need a local pack build.
            for _wl in _workloads:
                _wl_image = _wl.get('image', {}) or {}
                if _wl_image.get('tag') != 'dev':
                    continue
                _wl_repo = _wl_image.get('repository', name)
                # The rdx CLI writes the real source dir per workload into
                # values.yaml; fall back to the rdx_app() build_path arg.
                _build_path = _wl.get('build_path', build_path)
                _wl_pack_cmd = pack_cmd_base + ' --path ' + _build_path
                custom_build(
                    ref=_wl_repo,
                    command=_wl_pack_cmd,
                    deps=deps,
                    ignore=[chart_path, 'deploy', '.rdx', 'Tiltfile'],
                    # Match the image only where it appears as a container
                    # `image:` ref. match_in_env_vars would ALSO match the
                    # bare ref against env-var VALUES, and a short repository
                    # like 'app' collides with everyday env values (a DB
                    # username, a service name). That makes Tilt attach this
                    # pack build to an unrelated backing pod whose env merely
                    # carries the string — e.g. postgresql's
                    # _POSTGRES_INITIAL_USERNAME=app — and try to build it.
                    match_in_env_vars=False,
                    skips_local_docker=_skips_local_docker,
                    disable_push=_disable_push,
                    live_update=live_update_steps if live_update_steps else None,
                )
        else:
            # Legacy single-workload mode.
            custom_build(
                ref=name,
                command=pack_cmd,
                deps=deps,
                ignore=[chart_path, 'deploy', '.rdx', 'Tiltfile'],
                # See the workloads[] branch above: env-var matching on a
                # short image ref attaches the build to unrelated pods.
                match_in_env_vars=False,
                skips_local_docker=_skips_local_docker,
                disable_push=_disable_push,
                live_update=live_update_steps if live_update_steps else None,
            )

    # Helm install. Renders the chart at chart_path with the given values
    # files, applies the resulting manifests to the cluster.
    #
    # Run `helm dependency update` recursively. The parent chart vendors
    # the RDX library chart at charts/rdx-library/, and the library chart
    # itself declares oci:// dependencies on SUSE charts (e.g. postgresql).
    # `helm dep update` is non-recursive — it only pulls deps for the path
    # you pass. We walk charts/*/Chart.yaml first, update each, then update
    # the parent. Without this step the SUSE sub-charts never land in
    # charts/rdx-library/charts/ and their resources never get rendered.
    # Requires `helm registry login dp.apps.rancher.io` (one-time, typically
    # wired by the SUSE Rancher Desktop extension).
    # Strategy: only run helm dep update INSIDE vendored sub-chart directories.
    # We skip 'helm dep update' on the parent because:
    #   1. The bundle vendors sub-charts as directories under charts/*. helm
    #      template reads them directly — no parent update needed.
    #   2. Running it on the parent repackages directories into .tgz files
    #      and deletes any unmatched charts/, which interferes with the
    #      recursive dep-update step.
    # If the user introduces a non-vendored top-level dep later, they should
    # vendor it (rdx convention) or run helm dep update themselves.
    # Embed the chart-version aligning helper inline. Writing it to
    # /tmp at runtime avoids the path-discovery problem with extensions
    # loaded via ext:// (no __file__ equivalent in Starlark, and
    # read_file() resolves relative to the user's project Tiltfile).
    align_script_src = r'''#!/usr/bin/env python3
"""
Align vendored sub-chart Chart.yaml versions with the parent's dep
declarations.

SUSE (and possibly other) Helm charts publish OCI artifact tags that
don't match the chart's internal Chart.yaml version (e.g. tag
"0.4.4-29.1", chart version "0.4.4"). Helm's dep-matching at template
time uses the chart's INTERNAL version, so the alias the parent
declared silently fails to resolve and parent values never reach the
sub-chart. The pulled tgz is correct; we just need to rewrite its
Chart.yaml so the version matches what the parent says.

Usage: align_subchart_versions.py <parent-chart-dir>

Walks <parent>/charts/*.tgz; for each, peeks at Chart.yaml, if its
version differs from what <parent>/Chart.yaml's `dependencies` say for
the same chart name, rewrites the tgz with the aligned version.

Idempotent: skips if already aligned.
"""
import glob
import os
import shutil
import sys
import tarfile

def _safe_extract(tf, dest):
    # py3.12+ added the `filter` kwarg + the data_filter helper.
    # py<3.12 doesn't accept `filter=` — fall back to the legacy
    # extractall() (no member sanitisation). Acceptable here because
    # the input is a chart .tgz we just downloaded from our own
    # registry and helm dep update validated.
    if hasattr(tarfile, 'data_filter'):
        tf.extractall(dest, filter='data')
    else:
        tf.extractall(dest)



# We import yaml lazily so a missing PyYAML doesn't crash on charts that
# need no patching.
def _yaml():
    try:
        import yaml
        return yaml
    except ImportError:
        sys.stderr.write(
            "[align_subchart_versions] PyYAML not installed; " +
            "pip3 install pyyaml or run with python3 -m pip install pyyaml\n"
        )
        sys.exit(0)


def main(parent_dir):
    parent_chart_yaml = os.path.join(parent_dir, "Chart.yaml")
    if not os.path.isfile(parent_chart_yaml):
        return
    yaml = _yaml()
    with open(parent_chart_yaml) as f:
        parent = yaml.safe_load(f) or {}
    deps = parent.get("dependencies") or []
    wanted = {d["name"]: d["version"] for d in deps if "name" in d and "version" in d}
    if not wanted:
        return
    subdir = os.path.join(parent_dir, "charts")
    if not os.path.isdir(subdir):
        return
    fixed = 0
    for tgz in glob.glob(os.path.join(subdir, "*.tgz")):
        work = tgz + ".unpack"
        if os.path.isdir(work):
            shutil.rmtree(work)
        os.makedirs(work)
        try:
            with tarfile.open(tgz, "r:gz") as tf:
                _safe_extract(tf, work)  # tarfile filter handling — py3.12+ supports `filter='data'`, older python doesn't
            inner = next(
                (d for d in os.listdir(work) if os.path.isdir(os.path.join(work, d))),
                None,
            )
            if not inner:
                continue
            cy_path = os.path.join(work, inner, "Chart.yaml")
            with open(cy_path) as f:
                cy = yaml.safe_load(f) or {}
            name = cy.get("name")
            want = wanted.get(name)
            if want and cy.get("version") != want:
                cy["version"] = want
                with open(cy_path, "w") as f:
                    yaml.safe_dump(cy, f, default_flow_style=False, sort_keys=False)
                new_tgz = tgz + ".new"
                with tarfile.open(new_tgz, "w:gz") as tf:
                    tf.add(os.path.join(work, inner), arcname=inner)
                os.replace(new_tgz, tgz)
                fixed += 1
                print(
                    "[rdx] aligned {0} {1} -> {2}".format(name, cy.get("version"), want),
                    flush=True,
                )
        finally:
            if os.path.isdir(work):
                shutil.rmtree(work)
    if fixed:
        print(
            "[rdx] patched {0} sub-chart Chart.yaml version(s) under {1}".format(
                fixed, parent_dir
            ),
            flush=True,
        )


if __name__ == "__main__":
    main(sys.argv[1])
'''
    # Content-addressed path: the filename embeds a hash of the script body,
    # so the write is naturally idempotent — an unchanged script maps to a
    # path that already exists and we skip the blocking write on every
    # reload; an edited script maps to a new path and is written once.
    align_script_path = ('/tmp/_rdx_align_subchart_versions.' +
                         str(hash(align_script_src) & 0x7fffffff) + '.py')
    if not os.path.exists(align_script_path):
        local('cat > ' + align_script_path + " <<'__RDX_PY_EOF__'\n" + align_script_src + "\n__RDX_PY_EOF__", echo_off=True, quiet=True)

    # Filter the library chart's deps down to ONLY the sub-charts the
    # project has enabled. Without this, every `helm dep update` pulls
    # all 7+ SUSE charts (postgresql, redis, prometheus, grafana, dex,
    # mariadb, apache-kafka, ...) on every fresh project — even when
    # the dev only enabled mariadb. Triggers SUSE rate-limits in
    # high-iteration workflows (e2e harness, repeated `rdx new`).
    #
    # The filter reads the project's values + the rdx-render overlay,
    # builds the set of `<chart>.enabled: true` chart names, and
    # rewrites the library chart's Chart.yaml keeping only those deps.
    # Backed up to Chart.yaml.full on first run so subsequent
    # enable/disable cycles can re-derive from the full list.
    #
    # Idempotent: if Chart.yaml.full exists, restore from it before
    # filtering. Safe across rdx render re-runs (Tilt fires it on
    # every save in the chart tree).
    filter_script_src = r'''#!/usr/bin/env python3
"""
Strip the library Chart.yaml deps down to only the sub-charts the
project has enabled in its values. Cuts `helm dep update` work to
the minimum (one OCI pull per actually-used sub-chart) and dodges
SUSE rate-limits.

Usage: filter_enabled_deps.py <library-chart-dir> <values-file>...

Reads each values file, walks `rdx-library.<chart>.enabled` AND
top-level `<chart>.enabled` (rdx render's overlay shape), unions
the truthy chart names, then rewrites <library>/Chart.yaml keeping
only deps whose `name` matches.

Source-of-truth: <library>/Chart.yaml.full. Created on first run
from the live Chart.yaml. Filtering reads from .full every run so
re-enabling a previously-disabled chart still works.

Idempotent. Outputs one line per kept dep + the full count.
"""
import os
import re
import shutil
import sys


def _yaml():
    try:
        import yaml
        return yaml
    except ImportError:
        # Fail loud, NOT silent. If PyYAML is missing the filter cannot
        # run, every helm dep update pulls every catalogued sub-chart,
        # and any HTTP-source repo (e.g. dex on charts.dexidp.io) that
        # isn't in `helm repo list` triggers a confusing `no cached
        # repository for helm-manager-<hash>` error several layers down.
        # Exit 2 so the caller's `|| { ... }` branch fires with a clear
        # remediation pointing the dev at python3 -m pip install pyyaml
        # in the python3 the host's Tilt actually invokes (which on
        # macOS may differ from the conda one in the dev's shell).
        sys.stderr.write(
            ("[filter_enabled_deps] PyYAML not installed in this python3 " +
             "({0}); install with: python3 -m pip install --break-system-packages pyyaml\n" +
             "(check `which python3` from the same env Tilt runs in — on macOS " +
             "the host's /usr/bin/python3 is often distinct from your shell's.)\n"
            ).format(sys.executable)
        )
        sys.exit(2)


def _is_deploy_provisioning(value):
    """True iff `provisioning` declares an in-cluster deploy.

    `local` (legacy) and `deploy` (current README) both deploy a
    workload (and therefore pull in operator sub-charts via
    chart_defaults). Absent → defaults to `deploy` (deploy-by-default
    matches CLI scaffolds). Everything else — `connect`, `shared`,
    `external`, future values — binds via the binding secret only and
    must NOT enable the sub-chart.
    """
    if value is None or value == "":
        return True
    return value in ("local", "deploy")


def _is_redacted(s):
    """True iff `s` is an rdx redacted-secret marker.

    Used as a fallback safety net. The ROOT cause of redacted markers
    leaking into `services[].type` is documented in `_is_overlay_file`
    below: rdx render projects services[] into the overlay with
    values_mapping applied, and any service whose values_mapping
    routes `type` through a binding-secret value gets the marker
    written back. This helper catches stragglers that slip past the
    overlay-file skip — e.g. a user values file that's been
    hand-edited from overlay output.
    """
    if not isinstance(s, str):
        return False
    return "[redacted " in s or "[REDACTED " in s


def _is_overlay_file(path):
    """True iff `path` is rdx render's generated values overlay.

    rdx render projects DSL `services[]` from the user's values.yaml
    into the overlay with `values_mapping` applied. For any service
    whose mapping routes a field through a binding-secret value, the
    overlay's projected field becomes a `[redacted secret <binding>-
    binding:<field>]` marker rather than the original DSL value (e.g.
    `type: '[redacted secret demo-dashboards-binding:type]'` instead
    of `type: grafana`).

    The overlay's clean role is to carry chart-level overrides
    (`<chart>.enabled: true`, `<chart>.image.tag: ...`) for the
    `helm()` step. Its `services[]` block is a derived projection —
    NOT the source of truth — so the filter must read services[] from
    the user's values.yaml ONLY. Otherwise the last-wins merge across
    the values stack lets the overlay's redacted entries clobber the
    clean ones from values.yaml, and every downstream consumer (the
    enabled-set, dep aliasing, branch-version patching, source
    rewriting, the k8s_resource registration loop) sees garbage.

    Path-shape: the overlay is conventionally at
    `<chart-dir>/.rdx/values.generated.yaml` (rdx-cli v0.1.38+) or
    `<chart-dir>/values.generated.yaml` (legacy, pre-v0.1.38). Both
    are recognised here.
    """
    if not path:
        return False
    p = path.replace("\\", "/")
    return (p.endswith("/.rdx/values.generated.yaml") or
            p.endswith("/values.generated.yaml") or
            p == ".rdx/values.generated.yaml" or
            p == "values.generated.yaml")


def _lib_key_for(library_dir):
    """Top-level values key the project nests its DSL under.

    `library_dir` is the vendored sub-chart dir (charts/<name>/); its
    basename is the dependency name, which is exactly the key Helm nests
    the sub-chart's values under. The library chart ships under different
    names across bundles, so the key is data-driven, NOT a constant —
    assuming a fixed name silently yields an empty enabled-set and the
    filter drops every dep (`kept 0/N`).
    """
    if library_dir:
        base = os.path.basename(os.path.normpath(library_dir))
        if base:
            return base
    return "rdx-library"


def _lib_block(data, lib_key):
    """The library sub-block from one values doc, tolerant of key drift.

    Prefers the detected `lib_key`; falls back to the conventional names
    in case a dep `alias` diverges from its vendored dir name.
    """
    for k in (lib_key, "rdx-library", "suse-library"):
        if k:
            blk = data.get(k)
            if isinstance(blk, dict):
                return blk
    return None


def enabled_charts(values_files, library_dir=None):
    """Union the chart names with .enabled=true across all values files.

    Three shapes supported:
      1. Static `<chart>.enabled: true` under `rdx-library` (legacy).
      2. rdx render overlay's `rdx-library.<chart>.enabled: true`.
      3. DSL `services[]` entries — `services[i].type` + `enabled: true`
         (the modern path, what `rdx service add` writes). Critical:
         this filter runs BEFORE `rdx render` regenerates the overlay,
         so we can't rely on shape #2 alone — services[] is the only
         source of truth at filter-time on a fresh project.

    Top-level `<chart>.enabled` is also checked as a fallback for the
    rare project that pre-dates the DSL.

    Operator-enabled charts: when `library_dir` is provided, also scan
    `dsl-mappings.yaml`'s `charts.<type>.versions[].chart_defaults` for
    any `<other-chart>.enabled: true` keys, and union those chart names
    too. Required because DSL type names (e.g. `cnpg`) can differ from
    the operator sub-chart they pull in (e.g. `cloudnative-pg`). On a
    cold start (CI), values.generated.yaml is empty so the chart_defaults
    haven't been materialized into the overlay yet — without this lookup
    the operator dep gets filtered out and `k8s_resource` references to
    it fail at runtime with `unknown resource`.
    """
    yaml = _yaml()
    enabled = set()
    lib_key = _lib_key_for(library_dir)
    SKIP_TOP = {lib_key, "rdx-library", "suse-library", "global", "image",
                "ingress", "imagePullSecrets", "resources", "probes",
                "metrics", "podAnnotations", "service", "name", "replicas",
                "port", "apiVersion", "kind"}
    for path in values_files:
        if not os.path.isfile(path):
            continue
        try:
            with open(path) as f:
                data = yaml.safe_load(f) or {}
        except Exception:
            continue
        if not isinstance(data, dict):
            continue
        is_overlay = _is_overlay_file(path)
        # Shape 1+2: under <lib-key>.<chart>.enabled — read from ALL
        # files, INCLUDING the overlay. The overlay's whole point is to
        # carry chart-level `<chart>.enabled` overrides written by
        # `rdx render` for each service[] entry it processed.
        sl = _lib_block(data, lib_key)
        if isinstance(sl, dict):
            for name, sub in sl.items():
                if isinstance(sub, dict) and sub.get("enabled") is True:
                    enabled.add(name)
            # Shape 3: services[] DSL — services[i].type + enabled. The
            # CLI defaults services[].enabled to false in the scaffold,
            # so we only count entries the dev has explicitly flipped to
            # true. Same iteration the library helpers and `rdx render`
            # walk; staying consistent here matters.
            #
            # OVERLAY SKIP (root-cause fix for the redacted-type bug):
            # the overlay is a PROJECTION of services[] with
            # values_mapping applied. When a mapping routes `type`
            # through a binding-secret value, the overlay writes
            # `type: '[redacted secret demo-<binding>-binding:type]'`
            # instead of the plain DSL type. Reading services[] from
            # the overlay then lets the marker into the enabled set,
            # which propagates into Chart.yaml dep names and downstream
            # k8s_resource() lookups. The user's values.yaml is the
            # source of truth for services[]; the overlay is a
            # downstream artefact and must NOT be re-read here.
            #
            # Provisioning gate: only `local`/`deploy` modes deploy an
            # in-cluster workload (and pull in operator sub-charts via
            # chart_defaults below). `connect`/`shared`/`external` modes
            # bind to a pre-existing instance via the binding secret only
            # — they MUST NOT add the chart to the enabled set, otherwise
            # `helm dep update` pulls the operator chart and `helm install`
            # deploys it (e.g. cloudnative-pg operator for a postgresql
            # service that's actually pointing at an external DB).
            services = [] if is_overlay else (sl.get("services") or [])
            if isinstance(services, list):
                # Count types for multi-instance alias computation (#24).
                # Only count deploy-mode entries — connect-mode siblings
                # don't compete for an alias slot. Redacted-type entries
                # are also skipped so the redacted marker never reaches
                # the enabled set (which would propagate into Chart.yaml
                # dep names and `helm dep update` failures).
                type_counts = {}
                for entry in services:
                    if not isinstance(entry, dict):
                        continue
                    if not _is_deploy_provisioning(entry.get("provisioning")):
                        continue
                    t = entry.get("type")
                    if not t or _is_redacted(t):
                        continue
                    type_counts[t] = type_counts.get(t, 0) + 1
                for entry in services:
                    if not isinstance(entry, dict):
                        continue
                    if entry.get("enabled", True) is False:
                        continue
                    if not _is_deploy_provisioning(entry.get("provisioning")):
                        continue
                    chart_type = entry.get("type")
                    binding = entry.get("binding", "")
                    if not chart_type:
                        continue
                    if _is_redacted(chart_type):
                        sys.stderr.write(
                            ("[filter_enabled_deps] skipping services[binding={0!r}]: " +
                             "type={1!r} is a redacted secret marker. The DSL type " +
                             "must be a plain string (e.g. 'grafana'); a redacted " +
                             "value here usually means dsl-mappings.yaml chained " +
                             "`services[].type` through a binding-secret value_mapping. " +
                             "Sub-chart is not added to the enabled set; fix the " +
                             "mapping in the bundle to route `type` from project " +
                             "values, not from a secret.\n").format(binding, chart_type)
                        )
                        continue
                    enabled.add(chart_type)
                    # Multi-instance: also add the aliased name.
                    if type_counts.get(chart_type, 0) > 1 and binding:
                        enabled.add(chart_type + "-" + binding)
        # Top-level fallback (legacy / non-DSL projects).
        for name, sub in data.items():
            if name in SKIP_TOP:
                continue
            if isinstance(sub, dict) and sub.get("enabled") is True:
                enabled.add(name)

    # Operator chart_defaults expansion: for each enabled DSL type, pull
    # any `<chart>.enabled: true` keys out of its dsl-mappings entry's
    # chart_defaults and union those chart names too. Snapshot the set
    # first so we only expand from user-declared types, not transitively.
    if library_dir:
        dsl_path = os.path.join(library_dir, "dsl-mappings.yaml")
        if os.path.isfile(dsl_path):
            try:
                with open(dsl_path) as f:
                    dsl = yaml.safe_load(f) or {}
            except Exception:
                dsl = {}
            charts_dsl = dsl.get("charts") or {}
            for t in list(enabled):
                entry = charts_dsl.get(t) or {}
                for ver in (entry.get("versions") or []):
                    if not isinstance(ver, dict):
                        continue
                    for k, v in (ver.get("chart_defaults") or {}).items():
                        if k.endswith(".enabled") and v is True:
                            enabled.add(k[:-len(".enabled")])
    return enabled


def main(library_dir, *values_files):
    chart_yaml = os.path.join(library_dir, "Chart.yaml")
    full_backup = chart_yaml + ".full"
    lib_key = _lib_key_for(library_dir)
    if not os.path.isfile(chart_yaml):
        return

    # First run: snapshot the live Chart.yaml as the source-of-truth.
    if not os.path.isfile(full_backup):
        shutil.copy2(chart_yaml, full_backup)

    yaml = _yaml()
    with open(full_backup) as f:
        full = yaml.safe_load(f) or {}

    full_deps = full.get("dependencies") or []
    if not full_deps:
        return  # nothing to filter

    enabled = enabled_charts(values_files, library_dir=library_dir)

    # Multi-instance aliasing (#24): expand deps for types with
    # multiple bindings. Read services[] to find multi-instance types,
    # then duplicate the original dep entry with per-binding aliases.
    # SYNC: alias formula is <type>-<binding>. Must match
    # rdx-cli/internal/render/alias.go:ComputeAliases.
    expanded_deps = list(full_deps)
    multi_aliases = {}  # type → [alias1, alias2, ...]
    for path in values_files:
        if not os.path.isfile(path):
            continue
        # See _is_overlay_file: services[] in the overlay is a projection
        # with values_mapping applied (potentially with redacted types) —
        # always read services[] from the user's values.yaml only.
        if _is_overlay_file(path):
            continue
        try:
            with open(path) as f:
                data = _yaml().safe_load(f) or {}
        except Exception:
            continue
        sl = _lib_block(data, lib_key)
        if not isinstance(sl, dict):
            continue
        services = sl.get("services") or []
        if not isinstance(services, list):
            continue
        type_bindings = {}
        for entry in services:
            if not isinstance(entry, dict):
                continue
            # Connect/shared/external entries don't add a sub-chart, so
            # they MUST NOT count toward multi-instance alias splitting.
            # Otherwise a (deploy, connect) sibling pair would aliase the
            # one deploy dep to <type>-<binding1>, drop it from `enabled`
            # (which still has the bare type), and filter it out — the
            # sub-chart silently disappears.
            if not _is_deploy_provisioning(entry.get("provisioning")):
                continue
            if entry.get("enabled", True) is False:
                continue
            t = entry.get("type", "")
            b = entry.get("binding", "")
            # Redacted types can't be aliased — the resulting key would
            # propagate the marker into `multi_aliases` and ultimately
            # into Chart.yaml dep names. Skip; enabled_charts already
            # warned.
            if _is_redacted(t) or _is_redacted(b):
                continue
            if t and b:
                type_bindings.setdefault(t, []).append(b)
        for t, bindings in type_bindings.items():
            if len(bindings) > 1:
                multi_aliases[t] = [t + "-" + b for b in bindings]

    if multi_aliases:
        new_deps = []
        for d in expanded_deps:
            ename = d.get("alias", d.get("name"))
            if ename in multi_aliases:
                # Replace single dep with N aliased deps.
                for alias in multi_aliases[ename]:
                    aliased = dict(d)
                    aliased["alias"] = alias
                    aliased["condition"] = alias + ".enabled"
                    new_deps.append(aliased)
            else:
                new_deps.append(d)
        expanded_deps = new_deps

    # Branch version patching (DO-0005 Phase 2): when a service declares
    # branch: "16" and dsl-mappings has branches."16".chart_version, patch
    # the dep's version: field so helm dep update pulls the correct chart.
    dsl_path = os.path.join(library_dir, "dsl-mappings.yaml")
    if os.path.isfile(dsl_path):
        try:
            with open(dsl_path) as f:
                dsl = _yaml().safe_load(f) or {}
        except Exception:
            dsl = {}
        charts_dsl = dsl.get("charts") or {}
        branch_versions = {}  # chart_type -> chart_version from branch
        for path in values_files:
            if not os.path.isfile(path):
                continue
            # Skip the overlay — services[] is a derived projection there.
            if _is_overlay_file(path):
                continue
            try:
                with open(path) as f:
                    data = _yaml().safe_load(f) or {}
            except Exception:
                continue
            sl = _lib_block(data, lib_key)
            if not isinstance(sl, dict):
                continue
            for entry in (sl.get("services") or []):
                if not isinstance(entry, dict):
                    continue
                t = entry.get("type", "")
                if _is_redacted(t):
                    continue  # fallback guard if overlay-skip missed
                branch = str(entry.get("branch", ""))
                if t and branch and t in charts_dsl:
                    branches = charts_dsl[t].get("branches") or {}
                    if branch in branches:
                        cv = branches[branch].get("chart_version", "")
                        if cv:
                            branch_versions[t] = cv
        for d in expanded_deps:
            dep_name = d.get("alias", d.get("name", ""))
            base_type = dep_name.split("-")[0] if "-" in dep_name else dep_name
            if base_type in branch_versions:
                d["version"] = branch_versions[base_type]

    # Per-service source rewriting (DO-0012): services[] can override
    # the project source with a per-service `source:` field. Read each
    # service's source, look up the target source in dsl-mappings, and
    # rewrite the dep's repo/name/version accordingly.
    if charts_dsl:
        service_sources = {}  # chart_type -> source
        project_source = ""
        project_dir = os.path.dirname(library_dir)
        project_root = os.path.dirname(project_dir)
        project_yaml = os.path.join(project_root, ".rdx", "project.yaml")
        if os.path.isfile(project_yaml):
            try:
                with open(project_yaml) as f:
                    proj_meta = _yaml().safe_load(f) or {}
                project_source = proj_meta.get("chart_source", "")
            except Exception:
                pass
        for path in values_files:
            if not os.path.isfile(path):
                continue
            # Skip overlay; services[].source lives in values.yaml.
            if _is_overlay_file(path):
                continue
            try:
                with open(path) as f:
                    data = _yaml().safe_load(f) or {}
            except Exception:
                continue
            sl = _lib_block(data, lib_key)
            if not isinstance(sl, dict):
                continue
            for entry in (sl.get("services") or []):
                if not isinstance(entry, dict):
                    continue
                t = entry.get("type", "")
                if _is_redacted(t):
                    continue  # fallback guard if overlay-skip missed
                svc_source = entry.get("source", "")
                if t and svc_source:
                    service_sources[t] = svc_source

        for d in expanded_deps:
            dep_alias = d.get("alias", "")
            dep_name = d.get("name", "")
            chart_type = dep_alias or dep_name
            # infra deps (e.g. cloudnative-pg operator) follow the source
            # of their parent DSL type (cnpg). Check infra_only flag.
            chart_entry_meta = charts_dsl.get(chart_type, {})
            parent_type = chart_type
            if chart_entry_meta.get("infra_only"):
                # Find DSL type that enables this infra dep via chart_defaults
                for svc_t, svc_src in service_sources.items():
                    svc_entry = charts_dsl.get(svc_t, {})
                    for ver in (svc_entry.get("versions") or []):
                        defaults = ver.get("chart_defaults") or {}
                        if any(chart_type in str(k) for k in defaults):
                            parent_type = svc_t
                            break
            svc_source = service_sources.get(parent_type, project_source)
            if not svc_source:
                continue
            chart_entry = charts_dsl.get(chart_type, {})
            sources = chart_entry.get("sources", {})
            target_src = sources.get(svc_source, {})
            if not target_src:
                continue
            target_repo = target_src.get("chart_ref", "")
            target_name = target_src.get("chart_name", "")
            if not target_repo:
                continue
            if d.get("repository", "") != target_repo:
                d["repository"] = target_repo
            if target_name and dep_name != target_name:
                d["name"] = target_name
                if not dep_alias:
                    d["alias"] = chart_type
            elif not target_name and dep_alias and dep_name != chart_type:
                d["name"] = chart_type
                d.pop("alias", None)
            if svc_source == "community":
                ver = d.get("version", "")
                base = re.sub(r'-\d+\.\d+$', '', ver)
                if base != ver:
                    d["version"] = base

    if not enabled:
        kept = []
    else:
        kept = [d for d in expanded_deps if d.get("alias", d.get("name")) in enabled]

    # Final defense: even if a redacted marker slipped past every upstream
    # filter (corrupted Chart.yaml.full, third-party rewrite, future code
    # path), drop any dep whose name or alias contains it. `helm dep update`
    # would fail with a confusing message on such an entry, and we'd rather
    # the user see the warning here than try to debug a chart-resolution
    # error three layers down.
    safe_kept = []
    for d in kept:
        n = d.get("name", "")
        a = d.get("alias", "")
        if _is_redacted(n) or _is_redacted(a):
            sys.stderr.write(
                ("[filter_enabled_deps] dropping dep with redacted-secret " +
                 "marker in name/alias: name={0!r}, alias={1!r}. This usually " +
                 "means a per-service source-rewrite or Chart.yaml.full backup " +
                 "captured a redacted value; delete <library>/Chart.yaml.full " +
                 "and re-run to recover from a clean snapshot.\n").format(n, a)
            )
            continue
        safe_kept.append(d)
    kept = safe_kept

    out = dict(full)  # shallow copy
    out["dependencies"] = kept

    new_content = yaml.safe_dump(out, default_flow_style=False, sort_keys=False)
    # IDEMPOTENT WRITE: only touch Chart.yaml if the content actually
    # differs. Without this guard, Tilt sees Chart.yaml change every
    # reload (because we always rewrite), reloads the Tiltfile (the chart
    # tree is in its watch set), which re-runs this script, which writes
    # again — infinite loop. Tilt's fast-path
    # `Chart.lock newer than Chart.yaml` also never triggers because
    # we keep bumping Chart.yaml's mtime. See tilt-extension #URGENT.
    try:
        with open(chart_yaml) as f:
            cur_content = f.read()
    except OSError:
        cur_content = None
    wrote = (cur_content != new_content)
    if wrote:
        with open(chart_yaml, "w") as f:
            f.write(new_content)
        # When repos changed (source switch), delete stale .tgz files
        # and Chart.lock to force helm dep update to re-pull.
        charts_subdir = os.path.join(library_dir, "charts")
        if os.path.isdir(charts_subdir):
            for tgz in os.listdir(charts_subdir):
                if tgz.endswith(".tgz"):
                    os.remove(os.path.join(charts_subdir, tgz))
        lock = os.path.join(library_dir, "Chart.lock")
        if os.path.isfile(lock):
            os.remove(lock)

    skipped = len(full_deps) - len(kept)
    suffix = "" if wrote else " (unchanged on disk)"
    print(
        ("[rdx] filter_enabled_deps: kept {0}/{1} sub-chart(s) " +
         "[{2}]; skipped {3} disabled{4}").format(
            len(kept), len(full_deps),
            ", ".join(sorted([d.get("name", "?") for d in kept])) or "none",
            skipped, suffix,
        ),
        flush=True,
    )


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("usage: filter_enabled_deps.py <library-chart-dir> <values-file>...",
              file=sys.stderr)
        sys.exit(2)
    main(*sys.argv[1:])
'''
    # Content-addressed path — written once per script body (see align note).
    filter_script_path = ('/tmp/_rdx_filter_enabled_deps.' +
                          str(hash(filter_script_src) & 0x7fffffff) + '.py')
    if not os.path.exists(filter_script_path):
        local('cat > ' + filter_script_path + " <<'__RDX_PY_EOF__'\n" + filter_script_src + "\n__RDX_PY_EOF__", echo_off=True, quiet=True)

    # Pre-flight helper: ensure every non-OCI repo URL referenced by the
    # library Chart.yaml is registered with `helm repo add` BEFORE
    # `helm dep update --skip-refresh` runs. Without this, the first
    # `tilt up` of any project that vendors a library with a fresh HTTP
    # source (e.g. dex on charts.dexidp.io) crashes with a confusing
    #   `Error: no cached repository for helm-manager-<sha>`
    # because `--skip-refresh` forbids the on-the-fly index fetch.
    #
    # OCI repos (oci://dp.apps.rancher.io/charts) are skipped — Helm
    # talks to them directly without an index cache.
    bootstrap_repos_script_src = r'''#!/usr/bin/env python3
"""
Walk a library chart's Chart.yaml.full (or Chart.yaml as fallback) and
ensure every HTTP/HTTPS repository: URL is registered with helm. We
read .full because filter_enabled_deps strips Chart.yaml down to the
enabled subset — but a previously-disabled chart on an HTTP repo could
get re-enabled later, and we want the index ready when it does.

OCI repos are skipped (Helm doesn't cache an index for them).
Idempotent: helm repo add fails when a name+url is already registered;
we tolerate that.

Usage: bootstrap_helm_repos.py <library-chart-dir>
"""
import hashlib
import os
import re
import subprocess
import sys


def _yaml():
    try:
        import yaml
        return yaml
    except ImportError:
        sys.stderr.write(
            ("[bootstrap_helm_repos] PyYAML not installed in this python3 " +
             "({0}); install with: python3 -m pip install --break-system-packages pyyaml\n"
            ).format(sys.executable)
        )
        sys.exit(2)


def _existing_repo_urls():
    try:
        out = subprocess.check_output(
            ["helm", "repo", "list", "-o", "yaml"],
            stderr=subprocess.DEVNULL,
        )
    except (subprocess.CalledProcessError, FileNotFoundError):
        return set()
    yaml = _yaml()
    data = yaml.safe_load(out) or []
    return {(item.get("name"), item.get("url")) for item in data if isinstance(item, dict)}


def _safe_name_for_url(url):
    # Helm repo names are short ascii. Use a slugified host + 6-char hash
    # so reruns produce the same name and `helm repo add` is idempotent.
    host = re.sub(r"^https?://", "", url).split("/")[0]
    slug = re.sub(r"[^a-z0-9]+", "-", host.lower()).strip("-") or "repo"
    short = hashlib.sha256(url.encode()).hexdigest()[:6]
    return "rdx-{0}-{1}".format(slug, short)


def main(library_dir):
    chart_yaml = os.path.join(library_dir, "Chart.yaml.full")
    if not os.path.isfile(chart_yaml):
        chart_yaml = os.path.join(library_dir, "Chart.yaml")
    if not os.path.isfile(chart_yaml):
        return
    yaml = _yaml()
    with open(chart_yaml) as f:
        doc = yaml.safe_load(f) or {}
    deps = doc.get("dependencies") or []
    http_urls = sorted({
        d.get("repository", "").strip()
        for d in deps if isinstance(d, dict)
        and isinstance(d.get("repository"), str)
        and d["repository"].startswith(("http://", "https://"))
    })
    if not http_urls:
        return
    existing = _existing_repo_urls()
    existing_urls = {url for _, url in existing}
    added = []
    for url in http_urls:
        if url in existing_urls:
            continue
        name = _safe_name_for_url(url)
        try:
            subprocess.check_call(
                ["helm", "repo", "add", name, url],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.STDOUT,
            )
            added.append((name, url))
        except subprocess.CalledProcessError:
            # Likely already registered under a different name — fine,
            # let the subsequent --skip-refresh step succeed regardless.
            pass
    if added:
        print(
            "[rdx] bootstrapped {0} HTTP helm repo(s): {1}".format(
                len(added), ", ".join(u for _, u in added)
            ),
            flush=True,
        )
        # The added repos have no cached index yet; refresh just them.
        # `helm repo update <names>` is the targeted form (3.13+).
        try:
            subprocess.check_call(
                ["helm", "repo", "update"] + [n for n, _ in added],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.STDOUT,
            )
        except subprocess.CalledProcessError:
            # Older helm: untargeted update is the fallback.
            subprocess.call(["helm", "repo", "update"], stdout=subprocess.DEVNULL)


if __name__ == "__main__":
    if len(sys.argv) != 2:
        print("usage: bootstrap_helm_repos.py <library-chart-dir>", file=sys.stderr)
        sys.exit(2)
    main(sys.argv[1])
'''
    # Content-addressed path — written once per script body (see align note).
    bootstrap_repos_script_path = ('/tmp/_rdx_bootstrap_helm_repos.' +
                                   str(hash(bootstrap_repos_script_src) & 0x7fffffff) + '.py')
    if not os.path.exists(bootstrap_repos_script_path):
        local('cat > ' + bootstrap_repos_script_path + " <<'__RDX_PY_EOF__'\n" + bootstrap_repos_script_src + "\n__RDX_PY_EOF__", echo_off=True, quiet=True)

    # Speed: skip helm dep update when the cache is fresh.
    #   - --skip-refresh: don't update the 15+ helm repos (metallb, harbor,
    #     longhorn, rancher, ...). Wasted work because our deps use oci://
    #     URLs that bypass helm's repo cache entirely.
    #   - "Chart.lock newer than Chart.yaml + charts/*.tgz exists" guard:
    #     skip the dep update + alignment loop entirely. Saves ~5-15s per
    #     Tiltfile reload — these reloads happen on every save in the chart
    #     tree, so the win compounds. helm dep build would be even faster
    #     but requires a lock; we keep `update --skip-refresh` for the
    #     first-run / after-upgrade case where the lock isn't present yet.
    helm_dep_script = (
        'set -e; ' +
        'if [ -d "' + chart_path + '/charts" ]; then ' +
        '  for sub in "' + chart_path + '"/charts/*/; do ' +
        '    [ -d "$sub" ] || continue; ' +
        '    [ -f "$sub/Chart.yaml" ] || continue; ' +
        '    grep -q "^dependencies:" "$sub/Chart.yaml" || continue; ' +
        # Filter the library's deps down to only what's enabled in the
        # project's values. Cuts SUSE OCI pulls from N (every catalog
        # chart) to k (only the ones services[] turned on) per scenario.
        # Reads the project's values.yaml + rdx render's overlay so the
        # filter sees both static + DSL-derived enabled flags. Idempotent:
        # backs up to Chart.yaml.full on first run, re-derives every run
        # so disable→enable cycles work.
        # No `|| true` here: a missing PyYAML / parse error / write error
        # in the filter would leave Chart.yaml un-filtered and helm
        # would pull every catalog entry, including HTTP-source repos
        # the user hasn't registered. Better to fail loud with the
        # filter's own remediation message than to mask it as a
        # downstream `helm-manager-<sha>` cache miss two layers later.
        '    python3 "' + filter_script_path + '" "$sub" ' +
        '      "' + chart_path + '/values.yaml" ' +
        '      "' + chart_path + '/.rdx/values.generated.yaml" || ' +
        '      { echo "[rdx] FATAL: filter_enabled_deps.py failed for $sub"; exit 1; }; ' +
        # Pre-flight: register any non-OCI helm repo referenced by the
        # library Chart.yaml.full, so the subsequent
        # `helm dep update --skip-refresh` can find their indexes.
        # Idempotent + cheap. PyYAML required (already enforced above).
        '    python3 "' + bootstrap_repos_script_path + '" "$sub" || ' +
        '      { echo "[rdx] FATAL: bootstrap_helm_repos.py failed for $sub"; exit 1; }; ' +
        # Fast-path: lock fresh AND charts/ populated -> skip update.
        '    if [ -f "$sub/Chart.lock" ] && [ "$sub/Chart.lock" -nt "$sub/Chart.yaml" ] && ' +
        '       [ -d "$sub/charts" ] && [ -n "$(ls -A "$sub/charts" 2>/dev/null)" ]; then ' +
        '      echo "[rdx] $sub deps up to date, skipping helm dep update"; ' +
        '      python3 "' + align_script_path + '" "$sub"; ' +
        '      continue; ' +
        '    fi; ' +
        '    echo "[rdx] helm dep update --skip-refresh $sub"; ' +
        '    helm dependency update --skip-refresh "$sub"; ' +
        # SUSE packaging quirk: their Helm charts publish OCI artifact
        # tags like "0.4.4-29.1" but Chart.yaml inside says version
        # "0.4.4". Helm matches deps against the INTERNAL version, so
        # when the library declares postgresql at "0.4.4-29.1" the alias
        # silently fails to resolve at template time and parent values
        # never reach the sub-chart (no app user, no auth db). Patch
        # each pulled sub-chart to align its internal version with what
        # the parent expects. Drop when SUSE aligns version<->tag.
        '    python3 "' + align_script_path + '" "$sub"; ' +
        '  done; ' +
        'fi'
    )
    local(helm_dep_script, echo_off=True, quiet=False)

    # Note: values.yaml is NOT explicitly watched here. Tilt already
    # watches the chart tree (via helm()), so dev edits to values.yaml
    # trigger a reload naturally. An explicit watch_file would cause an
    # infinite loop when reconcileHints or rdx render writes back to
    # values.yaml during the reload.

    # Ignore helm-managed paths so Tilt doesn't reload-loop. helm dep update
    # writes .tgz files into charts/<sub>/charts/, plus tmpcharts-* dirs and
    # Chart.lock. Tilt watches the project tree by default; without these
    # ignores every helm dep update triggers a reload that re-runs helm dep
    # update -> infinite loop.
    # watch_settings(ignore=...) is GLOBAL — files matched are removed
    # from ALL watch trees including live_update sync. So we keep this
    # list narrow: only the helm-managed dynamic paths that would
    # otherwise cause infinite Tiltfile reload loops on helm dep update
    # output. We do NOT include src/ here even though src/ changes do
    # trigger a Tiltfile reload (because helm() watches chart_path
    # recursively) — ignoring src/ would also stop live_update from
    # syncing src/ into the running container.
    #
    # The Tiltfile reload cost on src/ saves is acceptable because:
    #   - the local() helm dep update / alignment cache via Helm's own
    #     state and complete in <1s when nothing changed
    #   - live_update's sync runs in parallel and the runtime watcher
    #     (nodemon -L for nodejs) still picks up the change
    # If users find the reload too noisy, the longer-term fix is to
    # split the chart into a sub-directory so helm() doesn't watch the
    # app source — out of scope for v0.7.
    watch_settings(ignore=[
        chart_path + '/charts/*/charts',
        chart_path + '/charts/*/tmpcharts-*',
        chart_path + '/charts/*/Chart.lock',
        chart_path + '/Chart.lock',
    ])

    # Default values file follows chart_path. Bundle v0.8+ ships values.yaml
    # under chart/, so when chart_path='chart' the defaults are 'chart/values.yaml'.
    # Users overriding chart_values_files pass paths relative to the Tiltfile.
    if chart_values_files == None:
        chart_values_files = [chart_path + '/values.yaml']

    # ─── DSL projection (rdx render) ────────────────────────────────────
    # Helm resolves sub-chart values BEFORE templates run, so the library
    # chart's _helpers.tpl can't inject services[].auth.user.name into
    # postgresql.auth.username at template time. The projection has to
    # happen out of band — `rdx render` does it pre-helm. We call it here,
    # right before `helm(...)`, so chart/values.generated.yaml is fresh
    # for every tilt up. Spec: idefxH/rdx-cli/rdx.md BEHAVIOR: render.
    # Closes idefxH/rdx-opinion-bundle-example#66.
    #
    # Wiring choices:
    #   - We call `rdx render` (NOT --check) at every tilt up. Generating
    #     is fast (millisecond-class for typical projects); --check would
    #     just defer the same work to a second invocation if it found
    #     drift. CI is the right place for --check.
    #   - The generated overlay is APPENDED to chart_values_files so helm
    #     reads the user's values + the projection. Order matters: user
    #     values first (they're the truth), generated overlay second
    #     (Helm's value-merge convention is later-wins, which is what we
    #     want — the projected values_mapping output overrides any stale
    #     manual entries the user may have left from before they adopted
    #     `rdx render`).
    #   - Missing rdx binary: graceful warning, no fail. Inner-loop dev
    #     against an unreleased rdx branch shouldn't be blocked. The
    #     downstream helm template will fail loud anyway via
    #     validateConsistency if the user hasn't manually maintained the
    #     equivalent values.
    # Reuse the rdx-presence probe taken once at the top of rdx_app().
    if _rdx_present:
        # Run from chart_path's parent: `rdx render` resolves the project
        # via cwd, and the project's chart_dir is computed relative to
        # the .rdx/project.yaml location.
        # Watch .rdx/stage at project root (parent of chart_path).
        # No touch — the file must exist before tilt up. If absent,
        # watch_file is a no-op (Tilt ignores missing paths).
        stage_path_root = os.path.join(os.path.dirname(chart_path), '.rdx', 'stage')
        watch_file(stage_path_root)
        local('rdx render --stage %s' % _stage, quiet=True, echo_off=False)
        # Look for the overlay at the new path first (rdx-cli v0.1.38+:
        # chart/.rdx/values.generated.yaml), then fall back to the old
        # path (chart/values.generated.yaml) for projects that were
        # rendered with an older CLI. Both are valid; whichever exists
        # is what `helm` should consume. The fallback gets the dev a
        # working tilt up while they upgrade.
        new_overlay = chart_path + '/.rdx/values.generated.yaml'
        old_overlay = chart_path + '/values.generated.yaml'
        if os.path.exists(new_overlay):
            generated_overlay = new_overlay
        elif os.path.exists(old_overlay):
            generated_overlay = old_overlay
            print('rdx: note — using legacy ' + old_overlay +
                  '. rdx-cli v0.1.38+ writes to chart/.rdx/values.generated.yaml; ' +
                  'next `rdx render` will migrate. You can delete the legacy ' +
                  'file once chart/.rdx/values.generated.yaml exists.')
        else:
            generated_overlay = ''
        # Only append when render actually produced the file (it does
        # unconditionally — see render.go's writeAtomic — but stay
        # defensive in case the user is on an older rdx binary that
        # predates BEHAVIOR: render).
        if generated_overlay != '':
            # De-dup: if the user already passed the overlay in
            # chart_values_files, don't add it twice (Helm tolerates
            # dup files but the warning would confuse).
            if generated_overlay not in chart_values_files:
                chart_values_files = chart_values_files + [generated_overlay]
    else:
        print('rdx: warning — `rdx` not on PATH; chart/.rdx/values.generated.yaml ' +
              'will not be regenerated. Install rdx CLI to keep services[] DSL ' +
              'in sync with sub-chart values. See idefxH/rdx-cli.')

    helm_set = []
    if image_ref:
        helm_set.append('image.repository=' + _img_repo)
        helm_set.append('image.tag=' + _img_tag)

    # BCI builder live-update uid fix (see BCI_RUNAS_UID note up top).
    # Run the app pod as the BCI builder's BUILD uid/gid so the launched
    # container owns its /workspace source files and Tilt's live_update
    # sync (which runs as the pod user) can overwrite them — otherwise the
    # build-user-owned, launch-user-unwritable files block every reload.
    # Scoped to the library subchart's podSecurityContext so only the app
    # pod is touched; the heroku builder (single build/launch uid) and
    # helm_only / image_ref deploys are left untouched.
    if _builder_kind == 'bci':
        _bci_uid = int(os.getenv('RDX_BCI_RUNAS_UID', str(BCI_RUNAS_UID)))
        _bci_gid = int(os.getenv('RDX_BCI_RUNAS_GID', str(BCI_RUNAS_GID)))
        if _bci_uid >= 0:
            helm_set.append('%s.podSecurityContext.runAsUser=%d' % (_lib_key, _bci_uid))
            helm_set.append('%s.podSecurityContext.runAsGroup=%d' % (_lib_key, _bci_gid))

    # Check for ingress hostname conflicts with other namespaces.
    # Two projects with the same ingress host (e.g. auth.localtest.me)
    # cause Traefik to route to the wrong service silently.
    _check_ingress_conflicts(chart_path, chart_values_files, namespace)

    k8s_yaml(helm(
        chart_path,
        name=name,
        namespace=namespace,
        values=chart_values_files,
        set=helm_set,
    ))

    # Surface the application Service on the requested port. Convention:
    # local port == container port, so curl http://localhost:<port> works
    # the same as in production behind an Ingress.
    #
    # Auto-discover ingress hosts from the project's values.yaml so the
    # Tilt resource card shows clickable Ingress links alongside the
    # port-forward. Reads `rdx-library.ingress` for the app, and each
    # sub-chart's own ingress block for the services (grafana follows
    # the standard `<chart>.ingress` shape; prometheus puts it under
    # `<chart>.server.ingress`). User-defined values files override
    # these via Tilt's standard --values stacking.
    parsed_values = []
    parsed_values_paths = []
    for vfile in chart_values_files:
        parsed_values.append(read_yaml(vfile, default={}))
        parsed_values_paths.append(vfile)

    # Match the embedded filter's _is_overlay_file. The rdx render
    # overlay is appended LAST to chart_values_files (line ~1538), so a
    # last-wins merge of services[] across parsed_values lets the
    # overlay's projected entries overwrite the clean ones from
    # values.yaml. The overlay's services[] can carry redacted-secret
    # markers (when a values_mapping routes a field through a binding
    # secret) and those markers must not reach the services-discovery
    # loop. The chart-level overrides the overlay carries
    # (`<chart>.enabled`, image tags, etc.) ARE still read — only the
    # services[] block is skipped.
    def _is_overlay_path(p):
        if not p:
            return False
        return (p.endswith('/.rdx/values.generated.yaml') or
                p.endswith('/values.generated.yaml') or
                p == '.rdx/values.generated.yaml' or
                p == 'values.generated.yaml')

    # Derive `port` from chart/values.yaml when the caller didn't pass one.
    # The library chart's deployment.yaml renders `containerPort: {{ .Values.port }}`
    # and the Service maps Service.targetPort to the same value, so
    # `rdx-library.port` is the canonical container port. Reading it
    # here keeps the Tiltfile DRY: callers don't have to remember to set
    # the same number in two places. Closes the same drift class as
    # rdx-cli#65 (single source of truth).
    #
    # Resolution order (last wins, matches Helm's --values stacking):
    #   1. library chart default (8080)
    #   2. user's chart/values.yaml rdx-library.port
    #   3. user-overridden values files
    #   4. explicit port=NNN in rdx_app(...) — fails fast on mismatch
    if not _workloads:
        # Legacy single-workload port discovery.
        discovered_port = 8080
        for cfg in parsed_values:
            lib = (cfg.get(_lib_key, {}) or {}) if cfg else {}
            if 'port' in lib:
                discovered_port = lib['port']
        if port == None:
            port = discovered_port
        elif port != discovered_port:
            fail((
                'rdx_app: port=%d passed explicitly but chart/values.yaml has ' +
                '%s.port=%d. The two would drift on every edit. ' +
                'Drop the port argument from rdx_app(...) — values.yaml is the ' +
                'source of truth (see rdx-docs/concepts/dsl.md). If you really ' +
                'need to override, change values.yaml.'
            ) % (port, _lib_key, discovered_port))

    # Auto-discover services from `rdx-library.services[]` (the unified
    # DSL in bundle v0.10+). Each entry has {binding, type, provisioning}
    # and maps to (binding -> type) for the port-forward registration
    # below.
    #
    # An explicit `services={...}` argument disables auto-discovery so a
    # caller can register services the chart doesn't deploy itself, or
    # narrow the surface to a subset.
    #
    # We dropped the pre-DSL legacy path (`rdx-library.<chart>.enabled`
    # without `services[]`) when the bundle moved to DSL-only at v0.10.
    # If you're on a bundle <= v0.9, pin the extension to its 0.1.x line
    # or pass `services={...}` explicitly.
    if services == None:
        services = {}
        # Merged view across parsed_values:
        #   - services[] entries come from chart/values.yaml (the user's
        #     DSL) — overlay never has services[].
        #   - chart-level <chart>.enabled comes from the overlay (written
        #     by `rdx render` for every enabled local service) OR from
        #     chart/values.yaml on pre-0.1.38 projects that wrote it
        #     manually. Either source counts.
        #
        # Earlier impl looped per-cfg and looked up <chart>.enabled in
        # the SAME cfg as the services[] entry. That broke for the
        # canonical post-0.1.38 split: services[] is in values.yaml,
        # <chart>.enabled is in the overlay, so the check failed for
        # every service and Tilt never registered the workloads. Result:
        # auto-Ingress link never showed up in the UI for grafana /
        # prometheus / etc. Discovered live Apr 30 (issue #14, kind of).
        #
        # The fix: collect services[] and chart-level enabled separately
        # across ALL cfgs, then intersect. Last-wins on binding-name
        # de-dup matches Helm's --values stacking semantics.
        all_lib_blocks = []
        all_services_by_binding = {}
        for i in range(len(parsed_values)):
            cfg = parsed_values[i]
            cfg_path = parsed_values_paths[i]
            lib = (cfg.get(_lib_key, {}) or {}) if cfg else {}
            # Always collect lib blocks — `_chart_enabled` below needs
            # to see chart-level `<chart>.enabled` flags written into
            # the overlay by `rdx render`.
            all_lib_blocks.append(lib)
            # Services[] DSL is sourced from values.yaml ONLY. The
            # overlay re-projects it with values_mapping applied —
            # which, when a mapping pulls a field through a binding
            # secret, writes `[redacted secret …]` into the projected
            # fields. With last-wins merge the overlay's redacted
            # entries would clobber the clean values.yaml entries
            # here. See `_is_overlay_path` above for the full why.
            if _is_overlay_path(cfg_path):
                continue
            for entry in (lib.get('services') or []):
                if entry.get('binding'):
                    all_services_by_binding[entry['binding']] = entry

        def _chart_enabled(stype, binding=''):
            for lib in all_lib_blocks:
                if (lib.get(stype, {}) or {}).get('enabled'):
                    return True
                # Multi-instance: check aliased block (<type>-<binding>).
                if binding:
                    alias = stype + '-' + binding
                    if (lib.get(alias, {}) or {}).get('enabled'):
                        return True
            return False

        for binding in all_services_by_binding:
            entry = all_services_by_binding[binding]
            stype = entry.get('type')
            provisioning = entry.get('provisioning', '')
            # Only deploy-mode entries register a workload. `local` and
            # `deploy` both deploy in-cluster (legacy + current naming;
            # README documents `deploy`); absent defaults to deploy.
            # `connect` (external instance via binding secret),
            # `shared` and `external` deploy NOTHING — registering a
            # phantom k8s_resource for them fails with "unknown
            # resource", and worse, in connect mode the host template
            # often points at the binding secret which rdx's renderer
            # surfaces as `[redacted secret <binding>-binding:host]`,
            # producing the exact symptom we're guarding against.
            if provisioning not in ('', 'local', 'deploy'):
                continue
            # services[].enabled drives deployment (rdx-cli v0.1.38+,
            # bundle v0.11.6+). Default true if absent (back-compat with
            # pre-0.1.38 scaffolds; fresh scaffolds opt-in explicitly).
            # When false, the entry is inert: no binding-secret rendered,
            # no chart-level enable flipped by rdx render, no sub-chart
            # deployed.
            if entry.get('enabled', True) == False:
                continue
            # Redacted-type guard: services[].type should always be a
            # plain DSL type name (e.g. 'grafana'). If it's an
            # `[redacted secret …]` marker, a bundle bug or a chained
            # value_mapping is routing the type through rdx's redactor.
            # Using that string as a chart key produces resources like
            # `<release>-[redacted secret <binding>-binding:type]` —
            # bizarre, unmatchable by k8s_resource, and the Tiltfile
            # aborts loading. Skip cleanly and tell the dev where to
            # look; the underlying sub-chart still renders (or fails
            # loudly at helm time, which is where a values-pipeline bug
            # belongs anyway).
            if type(stype) == "string" and "[redacted" in stype:
                warn(("[rdx] skipping services[binding=%r]: type=%r " +
                      "is a redacted secret marker. The DSL type should be " +
                      "a plain string (e.g. 'grafana'). Check the bundle's " +
                      "dsl-mappings.yaml for a values_mapping that routes " +
                      "`services[].type` through a binding secret — that's " +
                      "the layer to fix; the Tiltfile cannot recover a real " +
                      "type from the redacted marker.") % (binding, stype))
                continue
            # Belt-and-braces: at least one cfg must have <chart>.enabled
            # true, otherwise the sub-chart isn't deployed and we'd
            # register a phantom k8s_resource.
            if not _chart_enabled(stype, binding):
                continue
            if stype:
                services[binding] = stype

    # Resolve {{.domain}} from the project's rdx-library.domain value.
    _domain_value = ''
    for _cfg in parsed_values:
        _dl = (_cfg.get(_lib_key, {}) or {}) if _cfg else {}
        if 'domain' in _dl:
            _domain_value = _dl['domain']

    # Hairpin DNS fix: when the workspace uses a loopback dev domain,
    # override its in-cluster resolution so pods reaching peers by their
    # public ingress hostname land on the Traefik ClusterIP instead of
    # their own loopback. Tilt owns the ConfigMap's lifecycle (applied
    # here, removed on `tilt down`). No-op for real domains.
    _apply_coredns_hairpin(_domain_value, name)

    def _ingress_links(block, ingress_key='ingress', domain=''):
        """Extract clickable ingress links from a values block."""
        ing = block.get(ingress_key, {}) if block else {}
        hosts = ing.get('hosts', [])
        if not hosts:
            if not ing.get('enabled'):
                return []
        scheme = 'https' if ing.get('tls') else 'http'
        out = []
        for h in hosts:
            if type(h) == "string":
                host = h
            elif type(h) == "dict":
                host = h.get('host', '')
            else:
                continue
            if not host:
                continue
            # Resolve {{.domain}} placeholder using the project's domain
            # setting so Tilt shows clickable links for templated hosts.
            if "{{" in host or "}}" in host:
                if domain:
                    host = host.replace("{{.domain}}", domain).replace("{{ .domain }}", domain)
                else:
                    continue
            if "{{" in host or "}}" in host:
                continue
            out.append(link(scheme + '://' + host, host))
        return out

    def _rdx_lib_block(values_dict, *path):
        block = values_dict.get(_lib_key, {}) or {}
        for key in path:
            block = (block.get(key, {}) or {}) if hasattr(block, 'get') else {}
        return block

    if _workloads:
        # ─── Workloads[] mode: per-workload k8s_resource ────────────────
        # Re-read workloads from the fully-merged parsed_values so any
        # overlay values are included (last-wins, matches Helm stacking).
        _merged_workloads = []
        for cfg in parsed_values:
            lib = (cfg.get(_lib_key, {}) or {}) if cfg else {}
            wls = lib.get('workloads')
            if wls:
                _merged_workloads = wls
        if not _merged_workloads:
            _merged_workloads = _workloads

        # The library chart names each workload Deployment with the
        # `rdx-library.name` helper, defined as `default .Release.Name
        # .Values.name` — so when the project's values set `<lib>.name`,
        # THAT (not the Helm release name) is the workload prefix. The
        # release name (this function's `name` arg, passed to helm() as
        # name=name) is NOT always that value: a project can deploy under
        # a release that differs from its DSL name. Compute the SAME
        # effective prefix the chart uses, last-wins across parsed_values
        # to match Helm's --values stacking, so our `workload=` matches
        # the rendered Deployment. Using `name` blindly registered
        # `<release>-<wl>` against a manifest carrying `<lib-name>-<wl>`,
        # which aborts the Tiltfile with `unknown resource`.
        _chart_name = name
        for cfg in parsed_values:
            lib = (cfg.get(_lib_key, {}) or {}) if cfg else {}
            if lib.get('name'):
                _chart_name = lib['name']

        for _wl in _merged_workloads:
            _wl_name = _wl.get('name', 'app')
            _wl_port = _wl.get('port')
            # Asymmetric compose mapping (`8071:8000`): the import writes a
            # localPort holding the host side so the forward becomes
            # localhost:8071 → Service:8000. Default to the Service port
            # when localPort is absent (symmetric `8080:8080`).
            _local_port = _wl.get('localPort', _wl_port)
            _wl_links = _ingress_links(_wl, domain=_domain_value)
            _resource_name = _chart_name + '-' + _wl_name
            if _wl_port:
                # Forward local <localPort> to the Service port, which equals
                # the workload's containerPort: service.yaml renders
                # `port: {{ $wl.port }}` with `targetPort: http`, so the
                # Service is reached on the same number the container
                # listens on (no fixed :80 indirection). Forwarding to a
                # hardcoded :80 would miss a Service exposing e.g. 8083.
                # The local side matches the compose-published host port so
                # the dev hits localhost:<localPort>.
                k8s_resource(
                    workload=_resource_name,
                    port_forwards='%d:%d' % (_local_port, _wl_port),
                    labels=[labels.get(_resource_name, 'app')],
                    links=_wl_links,
                    auto_init=True,
                )
            else:
                k8s_resource(
                    workload=_resource_name,
                    labels=[labels.get(_resource_name, 'app')],
                    links=_wl_links,
                )
    else:
        # ─── Legacy single-workload mode ────────────────────────────────
        app_links = []
        for cfg in parsed_values:
            app_links.extend(_ingress_links(cfg.get(_lib_key, {}) or {}, domain=_domain_value))

        k8s_resource(
            workload=name,
            port_forwards='%d:%d' % (port, port),
            labels=[labels.get(name, 'app')],
            links=app_links,
        )

    # Surface each declared service on its conventional port. The
    # workload name is NOT always <release>-<chart-name> — some SUSE
    # charts add a master/replica suffix (redis → <release>-redis-master,
    # prometheus → <release>-prometheus-server, mariadb-galera variants
    # → <release>-mariadb-primary, etc.). The authoritative source of the
    # actual K8s resource name is the `service.host` template in the
    # bundle's library-chart/dsl-mappings.yaml — the same template the
    # library helper uses to build the binding-secret's `host` key.
    # We read that file (vendored at chart_path/charts/rdx-library/
    # dsl-mappings.yaml after `helm dep update`), pick the chart-type's
    # entry, render the host template by substituting .Release.Name.
    # Fallback when the file is absent (older bundle) or the type isn't
    # catalogued: the legacy <release>-<service_type> assumption.
    mappings_path = chart_path + '/charts/' + _lib_key + '/dsl-mappings.yaml'
    mappings_doc = read_yaml(mappings_path, default={'charts': {}})
    catalogued_charts = mappings_doc.get('charts', {})

    def workload_name_for(release, chart_alias, service_type):
        """Compute the rendered K8s workload name for a chart alias.

        For single-instance types, chart_alias == service_type (backward compat).
        For multi-instance types, chart_alias == <type>-<binding> and the
        host template is adjusted accordingly.

        For operator-managed types (e.g. cnpg), the `service.host` template
        points at a Service that is created at RUNTIME by the operator
        once the CR is reconciled (e.g. `<release>-cnpg-rw`). That name is
        NOT in the helm-rendered manifest, so registering it with
        k8s_resource() fails with "unknown resource". Instead, when the
        mapping declares `operator_managed: true`, use `operator_resource`
        — the chart-rendered operator/cluster handle that Tilt CAN see.
        """
        chart_entry = catalogued_charts.get(service_type, {})
        versions = chart_entry.get('versions', [])
        if not versions:
            return release + '-' + chart_alias
        ver = versions[0]
        if ver.get('operator_managed', False):
            op_tpl = ver.get('operator_resource', '')
            if op_tpl:
                if chart_alias != service_type:
                    op_tpl = op_tpl.replace('-' + service_type, '-' + chart_alias, 1)
                return op_tpl.replace('{{ .Release.Name }}', release).replace('{{.Release.Name}}', release)
        host_tpl = ver.get('service', {}).get('host', '')
        if not host_tpl:
            return release + '-' + chart_alias
        # For multi-instance, replace the type in the host template with the alias.
        if chart_alias != service_type:
            host_tpl = host_tpl.replace('-' + service_type + '.', '-' + chart_alias + '.', 1)
        rendered = host_tpl.replace('{{ .Release.Name }}', release).replace('{{.Release.Name}}', release)
        if '.' in rendered:
            rendered = rendered.split('.', 1)[0]
        return rendered

    # Compute chart aliases for multi-instance support (#24).
    # Same convention as the CLI: single-instance types keep the bare type,
    # multi-instance types get <type>-<binding> for ALL instances.
    type_counts = {}
    for binding_name, service_type in services.items():
        type_counts[service_type] = type_counts.get(service_type, 0) + 1

    aliases = {}  # binding → chart_alias
    for binding_name, service_type in services.items():
        if type_counts[service_type] == 1:
            aliases[binding_name] = service_type
        else:
            aliases[binding_name] = service_type + '-' + binding_name

    # Register CRD kinds for operator-managed charts so Tilt
    # recognises them as claimable objects in k8s_resource(objects=...).
    _registered_kinds = {}
    for _stype in services.values():
        _ce = catalogued_charts.get(_stype, {})
        _cvs = _ce.get('versions', [])
        if _cvs and _cvs[0].get('operator_managed'):
            _cr_kind_info = _cvs[0].get('cr_kind', {})
            if _cr_kind_info:
                _kind_key = _cr_kind_info.get('kind', '')
                _api_ver = _cr_kind_info.get('api_version', '')
                if _kind_key and _kind_key not in _registered_kinds:
                    k8s_kind(_kind_key, api_version=_api_ver, pod_readiness='wait')
                    _registered_kinds[_kind_key] = True

    def _bad_workload_name(s):
        """True if a computed workload name is unsafe to pass to k8s_resource.

        Catches three failure shapes we've actually hit:
          - empty / whitespace
          - unresolved Helm template tokens ("{{") — dsl-mappings entry
            referenced a value the Tiltfile can't substitute (e.g.
            `{{ .Values.<binding>.host }}`)
          - rdx's redacted-secret marker ("[redacted secret ...]") —
            seen when the host template points at a binding-secret key
            in connect mode and the rendered manifest leaks the marker
            into a resource name. Registering a k8s_resource for such a
            name fails with `unknown resource` and aborts the Tiltfile.

        Skipping registration is strictly safer than aborting: Tilt will
        still auto-discover the actual workload by its real name from
        the manifest stream, just without our port-forward/labels overlay.
        """
        if not s or not s.strip():
            return True
        if '{{' in s or '}}' in s:
            return True
        if '[redacted' in s or 'redacted secret' in s:
            return True
        return False

    # ─── Operator admission-webhook lifecycle hooks ─────────────────────
    # Catalog-driven webhook lifecycle for any chart that bundles an
    # operator with cluster-scoped Mutating/ValidatingWebhookConfiguration
    # objects. Two failure modes the catalog metadata defends against:
    #
    # (B1) Stale-webhook prune — `tilt down` does NOT reliably remove
    # cluster-scoped webhook configs whose names are helm-templated off
    # the release. A leftover config from a prior scenario points its
    # `clientConfig.service.namespace` at a now-deleted namespace; the
    # apiserver then blocks every admission in the new scenario with
    # `no endpoints available for service "<svc>"`. We prune any configs
    # whose target namespace no longer exists BEFORE Tilt applies the new
    # helm output. Label-scoped via `webhook_app_label` so we don't touch
    # unrelated configs.
    #
    # (B2) Endpoint-ready gate — on a cold cluster the operator pod image
    # pull can run >5s. The operator's CR is rendered in the same helm
    # stream as the operator Deployment + webhook configs; the apiserver
    # tries to validate the CR via the webhook the moment kubectl apply
    # lands. With no operator pod yet, validation fails. We register a
    # local_resource that waits for the operator's webhook Service to have
    # at least one Endpoints address, and add it to the CR's resource_deps.
    #
    # An operator entry in dsl-mappings.yaml opts in by setting
    # `operator_managed: true` AND declaring `webhook_service_name`.
    # Optional: `webhook_namespace` (default: release namespace),
    # `webhook_app_label` (selector value for the prune scan, default
    # from _OPERATOR_DEFAULTS table below).
    #
    # _OPERATOR_DEFAULTS lets older bundles (whose catalog doesn't yet
    # declare webhook_* fields) keep the same hook behavior. New operators
    # should declare these in their dsl-mappings entry instead of adding
    # to this table.
    _OPERATOR_DEFAULTS = {
        'cnpg': {
            'webhook_service_name': 'cnpg-webhook-service',
            'webhook_app_label': 'cloudnative-pg',
        },
    }
    _op_hooks = []
    _op_seen_types = {}
    for _binding, _stype in services.items():
        if _stype in _op_seen_types:
            continue
        _ce = catalogued_charts.get(_stype, {})
        _cvs = _ce.get('versions', [])
        if not _cvs:
            continue
        _ver = _cvs[0]
        if not _ver.get('operator_managed'):
            continue
        _defaults = _OPERATOR_DEFAULTS.get(_stype, {})
        _wh_svc = _ver.get('webhook_service_name',
                           _defaults.get('webhook_service_name', ''))
        if not _wh_svc:
            continue
        _op_seen_types[_stype] = True
        _wh_ns = _ver.get('webhook_namespace', '') or namespace
        _wh_label = _ver.get('webhook_app_label',
                             _defaults.get('webhook_app_label', ''))
        _op_res = ''
        _op_tpl = _ver.get('operator_resource', '')
        if _op_tpl:
            _op_res = (_op_tpl
                .replace('{{ .Release.Name }}', name)
                .replace('{{.Release.Name}}', name))
        _op_hooks.append({
            'service_type': _stype,
            'webhook_service_name': _wh_svc,
            'webhook_namespace': _wh_ns,
            'webhook_app_label': _wh_label,
            'operator_resource': _op_res,
            'ready_resource': name + '-' + _stype + '-webhook-ready',
        })

    # service_type → ready_resource name. Consumed in the CR-registration
    # loop below to attach the gate to the CR's resource_deps.
    _op_ready_by_type = {}
    for _h in _op_hooks:
        _op_ready_by_type[_h['service_type']] = _h['ready_resource']

    for _hook in _op_hooks:
        # (B1) Prune orphaned webhook configs scoped by app label.
        # Skip when no label is configured: a label-less kubectl get
        # would return EVERY cluster-scoped webhook config — far too
        # broad to safely mass-prune.
        # Gated to cold start (issue #7 M4): this is a stale-cluster
        # safety net, not something that needs re-running on every save.
        # _bootstrap_done means this session already brought the namespace
        # up once, so any stale webhook configs were already pruned.
        if _hook['webhook_app_label'] and not _bootstrap_done:
            _sel = 'app.kubernetes.io/name=' + _hook['webhook_app_label']
            local(
                "set -e; " +
                "for wc in " +
                "$(kubectl get mutatingwebhookconfigurations.admissionregistration.k8s.io " +
                "-l " + _sel + " -o name 2>/dev/null) " +
                "$(kubectl get validatingwebhookconfigurations.admissionregistration.k8s.io " +
                "-l " + _sel + " -o name 2>/dev/null); do " +
                "ns=$(kubectl get \"$wc\" -o " +
                "jsonpath='{.webhooks[0].clientConfig.service.namespace}' 2>/dev/null); " +
                "if [ -n \"$ns\" ] && ! kubectl get namespace \"$ns\" " +
                ">/dev/null 2>&1; then " +
                "kubectl delete \"$wc\" --ignore-not-found >/dev/null && " +
                "echo \"[rdx] pruned stale " + _hook['service_type'] +
                " webhook $wc (target ns $ns missing)\"; " +
                "fi; " +
                "done",
                quiet=False, echo_off=True)

        # (B2) Endpoint-ready gate. Polls every 2s for up to 180s.
        # `resource_deps` on the operator Deployment makes Tilt run this
        # only after the operator pod is past Pending. The CR's
        # k8s_resource (below) deps on this resource, which gates the
        # kubectl apply of the CR.
        _wait_deps = []
        if _hook['operator_resource']:
            _wait_deps = [_hook['operator_resource']]
        local_resource(
            _hook['ready_resource'],
            cmd=(
                "set -e; " +
                "for i in $(seq 1 90); do " +
                "ips=$(kubectl get endpoints " + _hook['webhook_service_name'] + " " +
                "-n " + _hook['webhook_namespace'] + " " +
                "-o jsonpath='{.subsets[*].addresses[*].ip}' " +
                "2>/dev/null || true); " +
                "if [ -n \"$ips\" ]; then " +
                "echo \"[rdx] " + _hook['webhook_service_name'] +
                " endpoints ready in " + _hook['webhook_namespace'] + ": $ips\"; " +
                "exit 0; " +
                "fi; " +
                "sleep 2; " +
                "done; " +
                "echo \"[rdx] FATAL: " + _hook['webhook_service_name'] +
                " has no endpoints after 180s in ns " + _hook['webhook_namespace'] + "\" >&2; " +
                "exit 1"
            ),
            resource_deps=_wait_deps,
            labels=[_hook['service_type']],
            allow_parallel=True,
        )

    used_local_ports = {}
    for binding_name, service_type in services.items():
        chart_alias = aliases[binding_name]
        workload = workload_name_for(name, chart_alias, service_type)
        if _bad_workload_name(workload):
            warn(('[rdx] skipping k8s_resource for binding %r ' +
                  '(type=%r): computed workload name %r is not a valid ' +
                  'k8s resource name. This usually means dsl-mappings.yaml ' +
                  'has a host/cr_object template that references a value ' +
                  'the Tiltfile cannot resolve (e.g. a binding-secret key ' +
                  'in `provisioning: connect` mode). Set provisioning ' +
                  'explicitly if you meant to deploy in-cluster, or ignore ' +
                  'this warning if Tilt auto-discovers the workload.') %
                 (binding_name, service_type, workload))
            continue

        # Sub-chart ingress lookup. Use chart_alias for values lookup
        # (multi-instance values are keyed by alias, not bare type).
        svc_port = 0
        chart_entry = catalogued_charts.get(service_type, {})
        chart_versions = chart_entry.get('versions', [])

        # Derive ingress_path from values_mapping['ingress.enabled'].
        # e.g. 'minio.consoleIngress.enabled' -> ['consoleIngress']
        #      'prometheus.server.ingress.enabled' -> ['server', 'ingress']
        #      'grafana.ingress.enabled' -> ['ingress']
        # Segments: drop first (chart name) and last ('enabled') to get path within chart block.
        _ingress_vm = (chart_versions[0].get('values_mapping', {}) or {}).get('ingress.enabled', '') if chart_versions else ''
        if _ingress_vm:
            _segs = _ingress_vm.split('.')
            ingress_path = _segs[1:-1] if len(_segs) > 2 else ['ingress']
        else:
            ingress_path = ['ingress']
        svc_links = []
        for cfg in parsed_values:
            parent = _rdx_lib_block(cfg, chart_alias, *ingress_path[:-1])
            svc_links.extend(_ingress_links(parent, ingress_path[-1], domain=_domain_value))
        is_operator_managed = False
        pod_selector = {}
        cr_object = ''
        operator_resource = ''
        if chart_versions:
            svc_spec = chart_versions[0].get('service', {})
            svc_port = svc_spec.get('port', 0)
            is_operator_managed = chart_versions[0].get('operator_managed', False)
            raw_selector = chart_versions[0].get('pod_selector', {})
            for sel_k, sel_v in raw_selector.items():
                pod_selector[sel_k] = sel_v.replace('{{ .Release.Name }}', name).replace('{{.Release.Name}}', name)
            raw_cr = chart_versions[0].get('cr_object', '')
            if raw_cr:
                cr_object = raw_cr.replace('{{ .Release.Name }}', name).replace('{{.Release.Name}}', name)
            raw_op = chart_versions[0].get('operator_resource', '')
            if raw_op:
                operator_resource = raw_op.replace('{{ .Release.Name }}', name).replace('{{.Release.Name}}', name)
            # Multi-port: find the primary port
            if not svc_port and svc_spec.get('ports'):
                for pname, pspec in svc_spec['ports'].items():
                    if pspec.get('primary', False):
                        svc_port = pspec.get('port', 0)
                        break
                # No primary? Take the first one.
                if not svc_port:
                    for pname, pspec in svc_spec['ports'].items():
                        svc_port = pspec.get('port', 0)
                        break

        if is_operator_managed and cr_object:
            # Operator-managed charts (e.g. CNPG): k8s_kind() registered
            # the CRD kind above, so Tilt auto-discovers the CR as a
            # workload. Keep its discovered name (cr_name) — do NOT
            # rename to the DSL workload name, because that name is
            # already taken by the operator's auto-discovered Deployment
            # (e.g. app-cloudnative-pg). Attach operator-created pods
            # via label selectors.
            cr_name = cr_object.split(':')[0]
            if _bad_workload_name(cr_name):
                warn(('[rdx] skipping k8s_resource for operator CR ' +
                      'of binding %r (type=%r): computed cr_name %r is ' +
                      'not a valid k8s resource name. The CRD entry in ' +
                      'dsl-mappings.yaml has a `cr_object` template the ' +
                      'Tiltfile cannot resolve.') %
                     (binding_name, service_type, cr_name))
                continue
            resource_kwargs = {
                'workload': cr_name,
                'labels': [labels.get(workload, 'services')],
                'links': svc_links,
            }
            if pod_selector:
                resource_kwargs['extra_pod_selectors'] = [pod_selector]
            _cr_deps = []
            if operator_resource:
                _cr_deps.append(operator_resource)
            # Operator-managed services that ship admission webhooks
            # (catalog opts in via `webhook_service_name`): wait for the
            # operator's webhook Service to have endpoints before applying
            # the CR. See the (B2) gate registered above.
            _wh_ready = _op_ready_by_type.get(service_type, '')
            if _wh_ready:
                _cr_deps.append(_wh_ready)
            if _cr_deps:
                resource_kwargs['resource_deps'] = _cr_deps
            if svc_port:
                local_port = svc_port
                if local_port < 1024:
                    local_port = svc_port + 10000
                while local_port in used_local_ports:
                    local_port += 1
                used_local_ports[local_port] = True
                resource_kwargs['port_forwards'] = '%d:%d' % (local_port, svc_port)
            k8s_resource(**resource_kwargs)
        elif svc_port:
            local_port = svc_port
            if local_port < 1024:
                local_port = svc_port + 10000
            while local_port in used_local_ports:
                local_port += 1
            used_local_ports[local_port] = True
            k8s_resource(
                workload=workload,
                port_forwards='%d:%d' % (local_port, svc_port),
                labels=[labels.get(workload, 'services')],
                links=svc_links,
            )
        else:
            k8s_resource(
                workload=workload,
                labels=[labels.get(workload, 'services')],
                links=svc_links,
            )


# ─── helm_rdx_chart() — helm-rdx plugin integration (rdx-cli v0.2.0+) ──
#
# Thin chart-rendering primitive that uses the helm-rdx plugin's
# `helm rdx template` (DSL projection + helm template in one shell call,
# no values.generated.yaml on disk) when available, and falls back to
# `rdx render` + Tilt's helm() builtin when not.
#
# Usage in a project Tiltfile:
#
#   load('ext://rdx', 'helm_rdx_chart')
#   helm_rdx_chart(name='my-app', stage='dev')
#   k8s_resource('my-app', port_forwards='8080:8080')
#
# Unlike rdx_app(), helm_rdx_chart() does NOT do pack build, helm dep
# update, namespace creation, port-forwarding, or pull-secret mirror —
# it's the chart-rendering step only. Compose with k8s_resource() for
# port-forwards. For the batteries-included experience, stick with
# rdx_app(); for projects already on rdx-cli v0.2.0+ that want the
# plugin's one-step flow without the legacy machinery, this is the hook.

def _check_ingress_conflicts(chart_path, values_files, namespace):
    """Warn if any ingress hostname is already claimed by another namespace."""
    lib_key = _detect_lib_key(chart_path)
    hosts = []
    for vfile in values_files:
        vals = read_yaml(vfile, default={})
        sl = vals.get(lib_key, {})
        domain = sl.get('domain', '')
        for svc in sl.get('services', []):
            if not svc.get('enabled', False):
                continue
            ing = svc.get('ingress', {})
            svc_hosts = ing.get('hosts', [])
            if ing.get('host'):
                svc_hosts = svc_hosts + [ing['host']]
            for h in svc_hosts:
                h = h.replace('{{.domain}}', domain)
                if h:
                    hosts.append(h)
    if not hosts:
        return
    out = str(local(
        'kubectl get ingress --all-namespaces -o ' +
        "jsonpath='{range .items[*]}{.metadata.namespace} {.spec.rules[*].host}{\"\\n\"}{end}' " +
        '2>/dev/null || true',
        quiet=True, echo_off=True,
    )).strip()
    for line in out.split('\n'):
        parts = line.strip().split(' ', 1)
        if len(parts) < 2:
            continue
        ing_ns, ing_host = parts[0], parts[1]
        if ing_ns == namespace:
            continue
        for h in hosts:
            if h == ing_host:
                warn(
                    ('[rdx] INGRESS CONFLICT: hostname %s is already claimed ' +
                     'by namespace %s — Traefik will route to the wrong service! ' +
                     'Fix: kubectl delete ingress -n %s -l app.kubernetes.io/instance ' +
                     'or tilt down the other project first.') % (h, ing_ns, ing_ns))


def _helm_rdx_plugin_present():
    """True iff `helm plugin list` reports a plugin named 'rdx'."""
    out = str(local(
        "helm plugin list 2>/dev/null | grep -qE '^rdx[[:space:]]' && " +
        "echo yes || echo no",
        quiet=True, echo_off=True,
    )).strip()
    return out == 'yes'


def helm_rdx_chart(
        name,
        chart_path=None,
        stage=None,
        values=None,
        namespace=None,
        set=[]):
    """Render a Helm chart with `helm rdx template` and apply the result.

    Detects the helm-rdx plugin (rdx-cli v0.2.0+); when present, runs
    `helm rdx template` directly — DSL projection and `helm template`
    happen in one shell call, no intermediate file on disk. When the
    plugin is absent, falls back to running `rdx render` and then
    Tilt's helm() builtin, with a one-line warning so the dev knows to
    install the plugin for the faster path.

    Args:
        name (str): Helm release name.
        chart_path (str|None): path to the Helm chart relative to the
            Tiltfile. Default: auto-detected — prefers `deploy/` (bundle
            v0.11.13+ scaffolds), falls back to `chart/`.
        stage (str|None): rdx stage (e.g. 'dev', 'staging'). Passed to
            `helm rdx template --stage`. When None, the plugin uses its
            own default (typically the project's current `.rdx/stage`).
        values (list[str]|None): values files passed to helm (-f).
            Default [chart_path + '/values.yaml'].
        namespace (str|None): target Kubernetes namespace. Default:
            helm's default. Pass an explicit value to land the release
            in a project-scoped namespace.
        set (list[str]): inline value overrides (helm --set). E.g.
            ['image.tag=v2.3.1', 'replicaCount=3'].
    """
    if chart_path == None:
        if os.path.exists('deploy/Chart.yaml'):
            chart_path = 'deploy'
        elif os.path.exists('chart/Chart.yaml'):
            chart_path = 'chart'
        else:
            chart_path = 'chart'

    if values == None:
        values = [chart_path + '/values.yaml']

    # Stage auto-detection for the fallback path (same logic as rdx_app).
    if stage == None:
        _fb_stage = os.getenv('RDX_STAGE', '')
        if not _fb_stage:
            _fb_stage_file = os.path.join(chart_path, '..', '.rdx', 'stage')
            if os.path.exists(_fb_stage_file):
                _fb_stage = str(read_file(_fb_stage_file)).strip()
        if not _fb_stage:
            _fb_stage = 'dev'
        stage = _fb_stage

    if _helm_rdx_plugin_present():
        # Plugin path: one shell call. `helm rdx template` does the DSL
        # projection AND `helm template` — no values.generated.yaml on
        # disk for Tilt to garbage-collect.
        args = ['helm', 'rdx', 'template', name, chart_path]
        if namespace:
            args.extend(['--namespace', namespace])
        if stage:
            args.extend(['--stage', stage])
        for vfile in values:
            args.extend(['-f', vfile])
        for kv in set:
            args.extend(['--set', kv])
        k8s_yaml(local(' '.join(args), quiet=True, echo_off=True))
        return

    # Fallback: helm-rdx plugin absent. Run `rdx render` (writes
    # chart/.rdx/values.generated.yaml) then layer the overlay onto the
    # user's values list before handing off to Tilt's helm() builtin.
    rdx_present = str(local(
        'command -v rdx > /dev/null 2>&1 && echo yes || echo no',
        quiet=True, echo_off=True,
    )).strip()
    if rdx_present == 'yes':
        print('helm_rdx_chart: helm-rdx plugin not installed; falling back ' +
              'to `rdx render` + helm template. Install the plugin for the ' +
              'one-step flow (rdx-cli v0.2.0+).')
        local('rdx render --stage %s' % stage, quiet=True, echo_off=False)
        overlay = chart_path + '/.rdx/values.generated.yaml'
        if os.path.exists(overlay) and overlay not in values:
            values = values + [overlay]
    else:
        print('helm_rdx_chart: warning — neither the helm-rdx plugin nor ' +
              'the `rdx` CLI is on PATH. The chart will render without DSL ' +
              'projection; sub-chart values from rdx-library.services[] ' +
              'will not reach their targets. Install rdx-cli v0.2.0+.')

    k8s_yaml(helm(
        chart_path,
        name=name,
        namespace=namespace or '',
        values=values,
        set=set,
    ))
