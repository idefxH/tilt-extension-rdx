# tilt-extension-rdx — rdx_app() helper.
#
# Wraps Cloud Native Buildpacks (via `pack`), Helm install, and service
# port-forwarding into a single declarative call. Designed for projects
# scaffolded by `rdx new` from an RDX opinion
# bundle, but usable from any Tiltfile that wants the same conventions.
#
# Usage in a project's Tiltfile:
#
#   load_dynamic('https://raw.githubusercontent.com/idefxH/tilt-extension-rdx/main/Tiltfile')
#   rdx_app(
#       name='my-app',
#       language='nodejs',
#   )
#
# That replaces ~30 lines of docker_build / helm / k8s_resource boilerplate
# with one call. Service port-forwards are auto-discovered from the
# project's values.yaml (under deploy/ on bundle 0.11.13+ scaffolds, or
# chart/ on older ones — chart_path defaults to auto-detection): every
# `rdx-library.services[]` entry (the unified DSL written by `rdx
# add-service`) is registered. The app's HTTP port is read from
# `rdx-library.port` in the same values.yaml — values.yaml is the source
# of truth, so the Tiltfile stays terse. Pass builder='bci' to build with
# the BCI builder (Paketo buildpacks) instead of the default heroku one.
#
# Pass `services={'<binding>': '<type>'}` explicitly only when you want to
# register a service the chart doesn't deploy itself, or narrow the
# auto-discovered set to a subset.

# Allow `local()` against whatever kube context is currently active.
# Tilt refuses to run `local()` when the active context isn't on its
# built-in allowlist (kind, microk8s, minikube, docker-desktop, …)
# because a `local()` against a prod cluster could nuke prod from a
# dev's laptop. This extension shells out via `local()` for helm
# dep-update bootstrap, the chart-alignment script, `rdx namespace
# expand`, etc. — all unavoidable — so the refusal blocks the whole
# Tiltfile. CI runs (GitHub Actions + k3s, context `rancher-desktop`)
# and any custom context name (k3d-*, a user's kubectl rename) trip it.
#
# Must be called at module top level: Tilt resolves the allowlist
# before any function body runs, so calling it from inside rdx_app()
# is too late — the first `local()` inside rdx_app() blows up before
# the allowlist mutation takes effect.
#
# Safe to allow whatever context is active: the user already pointed
# kubectl at it and ran `tilt up` against it — that's the trust
# decision. allow_k8s_contexts is additive and idempotent.
allow_k8s_contexts(k8s_context())

# Heroku CNB builder. Multi-arch (linux/amd64 + linux/arm64) so the
# buildpack inner loop runs natively on Apple Silicon — no Rosetta, no
# binfmt_misc shenanigans, no /usr/bin/env: 'node': No such file or
# directory at the npm-install step.
#
# Why not Paketo: paketobuildpacks/builder-* are amd64-only as of
# 2026-04-27. Running them on arm64 hosts forces the lifecycle through
# Rosetta inside Rancher Desktop's containerd VM, where binfmt_misc
# handler resolution is unreliable for nested execve in pack's
# ephemeral-lifecycle container. Reproduces with every Paketo tag we
# tested (jammy-base, jammy-full, all versions). Net: not actionable on
# our side until Paketo or SUSE publishes an arm64 builder. Tracked in
# tilt-extension-rdx#1 for the SUSE migration.
#
# Heroku 24 series: builder ~400MB (vs Paketo full 1.5GB), ships
# heroku/nodejs (active, v5.5.8 on 2026-04-16), heroku/python,
# heroku/go, heroku/java, heroku/ruby. Run image: heroku/heroku:24.
DEFAULT_BUILDER = 'heroku/builder:24'

# BCI CNB builder. Multi-arch (linux/amd64 + linux/arm64) builder built
# on the SUSE BCI 16.0 stack and shipping Paketo buildpacks. Selected via
# rdx_app(builder='bci'). Unlike upstream paketobuildpacks/builder-* (still
# amd64-only as of 2026-04-27, hence the arm64 Rosetta problems noted
# above) this image is published native for both arches, so the buildpack
# inner loop runs natively on Apple Silicon.
#
# The image lives in a private registry, so `pack` needs local credentials
# for ghcr.io at build time (`docker login ghcr.io`). See the preflight in
# the build block below.
BCI_BUILDER = 'ghcr.io/idefxh/builder-bci-base:16.0.2'

# Builder selector -> builder image. `builder='heroku'` (default) keeps the
# heroku/builder:24 + heroku/* buildpacks; `builder='bci'` switches to the
# BCI builder, which ships Paketo buildpacks and resolves them by its own
# detection order. A raw `builder_image` argument still overrides the
# resolved image for either selector.
BUILDER_IMAGES = {
    'heroku': DEFAULT_BUILDER,
    'bci': BCI_BUILDER,
}


# Recognize a BCI builder by its IMAGE, not just the 'bci' shorthand. The
# idefxh BCI builders are published as .../builder-bci-*:<tag> (e.g.
# builder-bci-base:16.0.2). A developer who passes the raw image directly —
# builder='ghcr.io/idefxh/builder-bci-base:16.0.2', a values.yaml
# build.builder, a config default_builder, or a builder_image override —
# instead of the 'bci' shorthand must STILL take the bci-only code paths.
# Otherwise _builder_kind stays the raw string, the `== 'bci'` branches in
# rdx_app() don't fire, and the heroku defaults (heroku/nodejs +
# heroku/procfile) get injected. heroku/procfile then fails detection on BCI
# (no Procfile in the project), aborting the whole build with
# "No buildpack groups passed detection".
def _is_bci_builder_image(image):
    return image != None and 'builder-bci' in image

# ─── Contract v1 resolved blocks (values.generated.yaml) ───
#
# The rdx CLI publishes the resolved language projection and the
# effective builder in the project overlay (bundle SPEC "VALUES-
# GENERATED CONTRACT v1": top-level language_resolved / builder_resolved
# next to contract_version). This extension PREFERS those blocks;
# LANGUAGE_DEFAULTS' core live-update fields and the explicit-arg →
# values → config → heroku builder chain below stay strictly as
# PRE-CONTRACT FALLBACKS — overlays written by older CLIs, projects
# with no overlay yet, or a language_resolved whose name doesn't match
# (stale overlay after a language switch).
#
# Freshness: in the image phase the overlay on disk is the previous
# evaluation's (this eval's `rdx render` runs later, in the projection
# phase). That's fine — language_resolved is static per language/CLI
# version, and builder_resolved is self-healing: read_yaml() registers
# the file with Tilt's watcher, so the projection phase rewriting it
# re-triggers evaluation and the next pass reads the fresh copy. The
# declared-build phase runs after projection and always sees the fresh
# overlay.
#
# All three helpers are pure (dict in, value out) and mirrored 1:1 in
# tests/test_contract_resolved.py — keep them in lockstep.

def _contract_language_block(overlay, language):
    if not overlay or overlay.get('contract_version', 0) < 1:
        return None
    lr = overlay.get('language_resolved') or {}
    if lr.get('name') != language:
        return None
    return lr

def _contract_builder_image(overlay):
    if not overlay or overlay.get('contract_version', 0) < 1:
        return ''
    return (overlay.get('builder_resolved') or {}).get('image') or ''

def _contract_pack_block(overlay, language, effective_builder_image):
    # pack_resolved is computed for (language_resolved.name,
    # builder_resolved.image) — the bundle SPEC's coupling rule. Consume
    # it only when THIS evaluation's language and final builder image
    # match the pair the CLI resolved; any divergence (explicit
    # builder=/builder_image= override, stale overlay after a language
    # switch, fresher values) falls back wholesale to the pre-contract
    # tables — never mix tiers.
    if not overlay or overlay.get('contract_version', 0) < 1:
        return None
    pr = overlay.get('pack_resolved')
    if not pr:
        return None
    lr = overlay.get('language_resolved') or {}
    if lr.get('name') != language:
        return None
    br = (overlay.get('builder_resolved') or {}).get('image') or ''
    if br != effective_builder_image:
        return None
    return pr

def _builder_kind_for_image(image):
    # Contract images are full refs; normalize back to the kind that
    # drives the bci/heroku code paths (cache format, buildpack
    # injection, uid fix). Unknown refs stay verbatim — same behaviour
    # as passing a raw image through the legacy chain.
    if _is_bci_builder_image(image):
        return 'bci'
    if image == DEFAULT_BUILDER or (image or '').startswith('heroku/builder'):
        return 'heroku'
    return image

# ─── Runtime default builder from ~/.config/rdx/config.yaml ───
#
# A user-level config knob (`default_builder:`) lets a developer pick the
# builder family ONCE for their whole machine instead of passing
# builder='bci' in every project's Tiltfile or carrying a `build.builder`
# in every values.yaml.
#
# It applies at RUNTIME, not at `rdx workspace import` time: the value is
# read here, on every Tiltfile evaluation, so editing the config file and
# saving lets Tilt pick the change up on the next reload — existing,
# already-imported projects included. (Contrast with baking the builder
# into the generated Tiltfile at import time, which would freeze it.)
#
# Resolution precedence inside rdx_app() is: explicit builder= argument >
# values.yaml `build.builder` > this config default > 'heroku'. The value
# is a shorthand ('bci' / 'heroku') OR a raw CNB builder image, which is
# used as-is (see the builder-resolution block in rdx_app()).
#
# Path follows the XDG Base Directory spec: $XDG_CONFIG_HOME/rdx/config.yaml
# when XDG_CONFIG_HOME is set, else ~/.config/rdx/config.yaml. read_yaml()
# returns the default {} when the file is absent, so a machine with no
# config simply falls through to 'heroku'. Read ONCE at load into a
# module-level constant so repeated rdx_app() calls in one Tiltfile don't
# re-parse it.
def _rdx_config_path():
    _xdg = os.getenv('XDG_CONFIG_HOME', '')
    if _xdg:
        return _xdg + '/rdx/config.yaml'
    return os.getenv('HOME', '') + '/.config/rdx/config.yaml'

_RDX_CONFIG = read_yaml(_rdx_config_path(), default={}) or {}
_RDX_DEFAULT_BUILDER = _RDX_CONFIG.get('default_builder') or ''

# BCI builder live-update uid fix.
#
# The BCI builder builds as CNB_USER_ID=1001, but its run image
# (ghcr.io/idefxh/base-bci-run) launches the container as uid 1002. The
# CNB lifecycle exports the application layer (/workspace) owned by the
# BUILD user (1001) with 0755 directories and 0644 files, so the LAUNCH
# user (1002) has no write access under /workspace/src. Tilt's
# live_update sync runs in the container as the pod's user, so its file
# copy silently fails with EACCES — the synced file is never replaced,
# the dev server (nodemon, the Procfile `dev` process) never observes a
# change, and the app stays "updating" without ever reloading.
#
# The heroku builder uses a single uid for build AND launch, so the
# launch user owns its own source files and live_update works — which is
# why the bug only reproduces with builder='bci'.
#
# Fix: run the app pod as the builder's BUILD uid/gid so it owns the
# source files it needs to overwrite. Verified locally: with
# `--user 1001:1000` the in-container overwrite succeeds and nodemon
# logs "restarting due to changes...". Applied via the library chart's
# `podSecurityContext` (pod-scoped, so only the app pod is affected;
# sub-charts keep their own security contexts).
#
# These track the BCI builder's CNB_USER_ID / CNB_GROUP_ID
# (1001 / 1000 for builder-bci-base:16.0.x — confirmed via
# `docker inspect ... CNB_USER_ID`). If a future BCI builder changes its
# CNB user, override with RDX_BCI_RUNAS_UID / RDX_BCI_RUNAS_GID; set
# RDX_BCI_RUNAS_UID=-1 to disable the override entirely (e.g. a builder
# whose run image already matches its build uid).
BCI_RUNAS_UID = 1001
BCI_RUNAS_GID = 1000

# Per-builder, per-language build-time env (pack --env) layered on top of
# the language defaults' pack_build_env. heroku/nodejs decides dev-vs-prod
# dependency install purely from NODE_ENV (set in LANGUAGE_DEFAULTS, honoured
# by both builders). Paketo's nodejs buildpack additionally exposes BP_*
# knobs: BP_NODE_RUN_SCRIPTS controls which npm scripts run at build time —
# pinned empty here so no production `build` script fires during the dev
# inner loop (the 'dev' Procfile process runs nodemon against ./src instead).
# devDependencies (nodemon) are retained because NODE_ENV=development keeps
# them in the install layer.
BUILDER_BUILD_ENV = {
    'bci': {
        'nodejs': {'BP_NODE_RUN_SCRIPTS': ''},
    },
}


# Resolve the dynamic Paketo BP_*/BPE_* build-env for the BCI builder from
# the rdx_app() convenience knobs. Layered ON TOP of BUILDER_BUILD_ENV (the
# static per-language baseline) at `pack build --env` time.
#
# Pure function (no I/O, no globals) so tests/test_bci_paketo_env.py mirrors
# it 1:1 — the Tiltfile is Starlark and can't be imported by pytest, so the
# only way to test this construction is to keep a byte-aligned copy in the
# test and assert on its output. Keep the two in lockstep.
#
# Every knob here maps to a documented Paketo build-time variable and is a
# no-op on the heroku builder (heroku/* buildpacks don't read BP_*), so the
# build block only calls this for builder='bci' and warns when a knob is set
# for any other builder.
def _resolve_bci_build_env(language, live_reload, reload_supported,
                           node_version, bp_log_level, image_labels,
                           runtime_cert_binding, debug, debug_port):
    env = {}
    # BP_LIVE_RELOAD_ENABLED=true makes the language buildpack install
    # watchexec (present in builder-bci-base) and wrap its `web` process in
    # it. Only emit when the language actually supports it (see
    # LANGUAGE_DEFAULTS['bci_reload']) — emitting it for go would bake a
    # watchexec layer that nothing runs.
    if live_reload and reload_supported:
        env['BP_LIVE_RELOAD_ENABLED'] = 'true'
    # BP_NODE_VERSION pins the Node runtime (node-engine buildpack). Paketo
    # ALSO reads .node-version / .nvmrc / package.json#engines.node
    # automatically; this is the explicit override. Node-only.
    if node_version and language == 'nodejs':
        env['BP_NODE_VERSION'] = str(node_version)
    # BP_LOG_LEVEL=DEBUG turns on verbose buildpack logging — the first
    # thing to reach for when a BCI build misbehaves.
    if bp_log_level:
        env['BP_LOG_LEVEL'] = str(bp_log_level)
    # BP_IMAGE_LABELS: space-delimited key=value pairs applied as OCI labels
    # by the image-labels buildpack. Sorted for a stable, testable string.
    if image_labels:
        env['BP_IMAGE_LABELS'] = ' '.join(
            ['%s=%s' % (k, image_labels[k]) for k in sorted(image_labels)])
    # Runtime cert binding is ON by default in Paketo's ca-certificates
    # buildpack (a `ca-certificates` service binding is read at launch), so
    # only emit the flag when the caller explicitly opts OUT with False.
    if runtime_cert_binding == False:
        env['BP_ENABLE_RUNTIME_CERT_BINDING'] = 'false'
    # debug bakes a LAUNCH-time default via the environment-variables
    # buildpack (BPE_DEFAULT_<NAME> sets the var only if unset at runtime),
    # so the process starts its debug agent without a chart change. BPL_DEBUG_*
    # is honoured by the JVM (bellsoft-liberica); for Node use
    # additional_env={'BPE_DEFAULT_NODE_OPTIONS': '--inspect=0.0.0.0:9229'}.
    if debug:
        env['BPE_DEFAULT_BPL_DEBUG_ENABLED'] = 'true'
        if debug_port:
            env['BPE_DEFAULT_BPL_DEBUG_PORT'] = str(debug_port)
    return env


# Pick the pack --default-process for the BCI builder under live_reload.
#
# IMPORTANT: there is no `reload` process. With BP_LIVE_RELOAD_ENABLED=true
# the Paketo language buildpack (e.g. npm-start) wraps its OWN default `web`
# process in watchexec — verified from a real BCI build log:
#   web (default): watchexec --restart --watch /workspace ... -- sh start.sh
#   no-reload:     sh start.sh
# So the watchexec-wrapped process is named `web`, not `reload`. Selecting a
# non-existent `reload` hard-fails the build with
#   ERROR: tried to set reload to default but it doesn't exist
# Hence we select `web`. (The Procfile, if present, would clobber this `web`
# with a plain command — that's handled separately by excluding the Procfile
# from the build context; see _bci_procfile_exclude_action.)
#
# Returns None to mean "fall back to the Procfile-gated default". Pure —
# mirrored in the test.
def _bci_reload_default_process(live_reload, reload_supported):
    if live_reload and reload_supported:
        return 'web'
    return None


# Decide how to stop the heroku/procfile-style process types from clobbering
# Paketo's watchexec-wrapped `web` process when live_reload is on for the BCI
# builder. The procfile buildpack runs AFTER npm-start in the BCI builder's
# detection order, and a `web:` Procfile entry OVERWRITES npm-start's
# watchexec `web` with a plain command — killing live reload (confirmed from
# a real build log). The fix is to exclude the Procfile from the build
# context (a pack project descriptor with `exclude = ["Procfile"]`), so the
# procfile buildpack detects nothing and npm-start's watchexec `web` survives.
#
# Returns:
#   'exclude' -> write/pass a project descriptor that excludes the Procfile
#   'warn'    -> a user project.toml already exists; we won't clobber it, so
#                warn that live reload won't take effect until they exclude
#                the Procfile themselves
#   'none'    -> nothing to do (not bci+live_reload, or no Procfile present)
# Pure — mirrored in the test.
def _bci_procfile_exclude_action(builder_kind, live_reload, reload_supported,
                                 procfile_exists, project_toml_exists):
    if builder_kind != 'bci' or not live_reload or not reload_supported:
        return 'none'
    if not procfile_exists:
        return 'none'
    if project_toml_exists:
        return 'warn'
    return 'exclude'

# Per-language defaults. Live-update paths follow each buildpack's
# expected workspace layout. Languages requiring a full rebuild on every
# change (compiled) leave live_update_paths empty — Tilt rebuilds via
# pack on file change, with Paketo's layer cache providing the speed-up.
LANGUAGE_DEFAULTS = {
    'nodejs': {
        # heroku/nodejs in v5+ is a unified single buildpack that handles
        # engine resolution + npm install internally. The previous
        # sub-buildpacks are deprecated in v5.
        # Requires a committed package-lock.json so heroku/nodejs runs
        # npm ci (the bundle template ships one).
        # heroku/procfile reads ./Procfile to register processes —
        # 'web' for prod, 'dev' for tilt builds (nodemon -L src/index.js).
        'buildpacks': ['heroku/nodejs', 'heroku/procfile'],
        'live_update_paths': ['./src'],
        'live_update_install_trigger': ['./package.json', './package-lock.json'],
        'live_update_install_cmd': 'cd /workspace && npm install --production=false',
        # Tilt builds run the 'dev' process (nodemon -L src/index.js).
        # nodemon polls every 1s — robust against containerd/overlayfs
        # inotify quirks that break node --watch in some k8s setups.
        # Production builds (no --default-process flag) default to 'web'.
        'pack_default_process': 'dev',
        # Force NODE_ENV=development at build so heroku/nodejs runs
        # 'npm ci' instead of 'npm ci --omit=dev' and includes nodemon
        # (which is in devDependencies of the template package.json).
        'pack_build_env': {'NODE_ENV': 'development'},
        # BCI/Paketo only: with BP_LIVE_RELOAD_ENABLED=true npm-start wraps
        # its own `web` process in watchexec, so the heroku nodemon `dev:`
        # hack isn't needed (see rdx_app live_reload=). Requires an npm
        # `start` script (or a Procfile `web:` — but the Procfile is excluded
        # under live_reload so the watchexec `web` isn't clobbered).
        'bci_reload': True,
    },
    'python': {
        'buildpacks': ['heroku/python', 'heroku/procfile'],
        'live_update_paths': ['./src'],
        'live_update_install_trigger': ['./requirements.txt', './pyproject.toml', './Pipfile'],
        'live_update_install_cmd': 'cd /workspace && pip install -r requirements.txt 2>/dev/null || true',
        # python-start wraps its `web` process in watchexec under
        # BP_LIVE_RELOAD_ENABLED=true.
        'bci_reload': True,
    },
    'java': {
        # heroku/java compiles via Maven/Gradle. heroku/procfile
        # reads ./Procfile to register web/dev process types.
        # Without procfile, the CNB launcher has no default process
        # and the container crashes with "no default process".
        'buildpacks': ['heroku/java', 'heroku/procfile'],
        'live_update_paths': [],
        'live_update_install_trigger': [],
        'live_update_install_cmd': None,
        # executable-jar / spring-boot / dist-zip wrap their `web` process in
        # watchexec under BP_LIVE_RELOAD_ENABLED=true. Restarts the JVM (not
        # the whole container) on a synced class/jar change.
        'bci_reload': True,
    },
    'go': {
        # heroku/go + heroku/procfile. Go SDK is NOT in the CNB
        # runtime image (heroku/heroku:24), so in-container
        # recompilation (air, go build) is impossible. Every source
        # change triggers a full `pack build` — heroku/go's layer
        # cache keeps rebuilds to ~10-15s after the first one.
        #
        # If a future builder ships Go in the launch image (e.g.
        # RDX-SUSE builder with a `-dev` variant), re-enable
        # live_update_paths and switch dev: to air.
        'buildpacks': ['heroku/go', 'heroku/procfile'],
        'live_update_paths': [],
        'live_update_install_trigger': [],
        'live_update_install_cmd': None,
        # The BCI go-build buildpack (4.x in builder-bci-base:16.0.x) does
        # NOT support BP_LIVE_RELOAD_ENABLED / watchexec wrapping
        # (paketo-buildpacks/go-build#238 is still open), and Go is not in
        # the run image, so live_reload= can't help here. Source changes
        # fall back to a full layer-cached pack rebuild.
        'bci_reload': False,
    },
}

# Optional registry redirect for CI / local-mirror / air-gapped setups.
# When RDX_DEFAULT_REGISTRY is set, register it as Tilt's default
# registry so custom_build's $EXPECTED_REF and any chart images get
# rewritten to that host. The e2e harness uses this to point at the
# local kind-mirror (localhost:5000) without having to inject a
# default_registry() into every project Tiltfile.
#
# Top-level on purpose: Tilt requires default_registry() before any
# image builds are registered, so it has to run at extension load
# time — not inside rdx_app().
_rdx_default_registry = os.getenv('RDX_DEFAULT_REGISTRY', '')
# Two-audience registries (optional): on remote-daemon setups the
# laptop often reaches the registry on a different host:port than the
# cluster nodes do (port-forwards, mirrors). RDX_REGISTRY_FROM_CLUSTER
# then carries the node-side name: pushes go to RDX_DEFAULT_REGISTRY,
# the rendered image refs use the cluster-side host. Unset = both
# audiences share RDX_DEFAULT_REGISTRY, unchanged.
_rdx_registry_from_cluster = os.getenv('RDX_REGISTRY_FROM_CLUSTER', '')
if _rdx_default_registry:
    if _rdx_registry_from_cluster:
        default_registry(_rdx_default_registry,
                         host_from_cluster=_rdx_registry_from_cluster)
    else:
        default_registry(_rdx_default_registry)

# Disable Tilt's secret-value scrubber for binding-secret values.
#
# The rdx library-chart writes Service-Binding-Spec-compliant Secrets
# whose stringData contains the chart `type` (`postgresql`, `prometheus`,
# `grafana`, `dex`, ...) and `provider` (`rdx-suse`). The SBS REQUIRES
# `type` to live in the Secret data — that's not optional. Tilt then
# harvests every Secret value it deploys and substitutes the literal
# strings everywhere in its log/UI output, so a workload named
# `app-prometheus-server` displays as
# `app-[redacted secret app-mon-binding:type]-server`. The k8s_resource
# registrations themselves are correct (verified via
# `tilt alpha tiltfile-result` — manifest names are clean) but the dev's
# Tilt UI shows garbled resource names that don't match what `kubectl
# get` returns.
#
# Trade-off: with scrubbing off, real Secret VALUES (passwords, OIDC
# client_secret, OAuth cookie_secret) ALSO appear in Tilt logs. In a
# `tilt up` dev session this is fine — the dev owns those secrets and
# created them locally. In a `tilt ci` CI run the test fixtures use
# throwaway random passwords (`grafpw-<sha>`, `dexpw-<sha>`) by
# convention. The alternative — scrubbing on by default — gives
# unintelligible workload names AND doesn't actually protect against
# anything since `type=prometheus` isn't a secret in the first place.
#
# Set RDX_ENABLE_TILT_SCRUB=1 to opt back in (e.g. for screen-shared
# demos where the dev wants password redaction in the UI).
if os.getenv('RDX_ENABLE_TILT_SCRUB', '') != '1':
    secret_settings(disable_scrub=True)

# ─── Pre-read Python helper scripts at module load time ───
#
# read_file() with a relative path resolves against the Tiltfile that
# is currently being *evaluated*. At module top level (here) that is the
# extension's own Tiltfile, so the paths resolve to rdx/*.py correctly.
# Inside a function called from a *project* Tiltfile, the resolution
# base shifts to the project directory and the scripts are not found.
# Reading them once here avoids that problem entirely.
_ALIGN_SCRIPT_SRC = str(read_file('_align_subchart_versions.py'))
_FILTER_SCRIPT_SRC = str(read_file('_filter_enabled_deps.py'))
_BOOTSTRAP_REPOS_SCRIPT_SRC = str(read_file('_bootstrap_helm_repos.py'))

def _detect_lib_key(chart_path):
    """Return the top-level values key the project nests its DSL under.

    The opinionated library chart is a vendored dependency
    (chart_path/charts/<name>/) and a project's values place the DSL
    (`services[]`, `workloads[]`, `port`, per-chart `<chart>.enabled`)
    under a top-level key equal to that dependency's name (Helm nests a
    sub-chart's values under its dep name/alias). Bundles ship the library
    under different names, so this key is NOT a constant: it must be read
    from the chart, not assumed. Detect it instead of hardcoding so the
    extension tracks whatever the bundle vendors.

    Resolution order:
      1. A dependency whose vendored dir carries dsl-mappings.yaml — the
         unambiguous signature of the library chart (only available once
         `helm dep update` has run).
      2. Cold start (deps not vendored yet): a dependency whose name ends
         in `-library`.
      3. A conventionally-named dir present on disk.
      4. The modern default.
    """
    chart_meta = read_yaml(chart_path + '/Chart.yaml', default={})
    deps = chart_meta.get('dependencies') or []
    for dep in deps:
        nm = dep.get('alias') or dep.get('name') or ''
        if nm and os.path.exists(chart_path + '/charts/' + nm + '/dsl-mappings.yaml'):
            return nm
    for dep in deps:
        nm = dep.get('alias') or dep.get('name') or ''
        if nm.endswith('-library'):
            return nm
    for cand in ['rdx-library', 'suse-library']:
        if os.path.exists(chart_path + '/charts/' + cand):
            return cand
    return 'rdx-library'


# ─── CoreDNS hairpin DNS fix ────────────────────────────────────────────
#
# In k3s dev clusters, wildcard-loopback domains (`*.localtest.me`,
# `*.lvh.me`, …) resolve to 127.0.0.1 EVERYWHERE — including inside pods.
# A pod that calls an ingress-exposed peer by its public hostname
# (`auth.localtest.me`) therefore hits its OWN loopback instead of the
# Traefik ingress controller. The classic "hairpin" failure.
#
# k3s ships CoreDNS with `import /etc/coredns/custom/*.server` in its
# Corefile and auto-mounts a ConfigMap named `coredns-custom` in
# `kube-system` at `/etc/coredns/custom/` (`optional: true`). Adding a
# `<name>.server` key there defines a new DNS zone. We point the dev
# domain at the Traefik ClusterIP so in-cluster name resolution of the
# public hostname lands on the ingress controller, which then routes by
# Host header exactly as it does for external traffic.
#
# The snippet's zone header must carry the SAME PORT the main server
# block listens on: a CoreDNS server block binds its own listener, so a
# `domain:53` snippet on a cluster whose CoreDNS serves `.:1053`
# (vcluster does this behind the kube-dns Service) binds a listener
# nothing routes to and the override is silently inert. The port is
# parsed from the kube-system/coredns Corefile (_coredns_serving_port),
# defaulting to 53 — stock k3s / Rancher Desktop. No CoreDNS restart is
# needed either way: kubelet projects the ConfigMap into the optional
# mount within ~a minute and the `reload` plugin picks up the new
# import (verified: activation ≈35 s after apply on a fresh cluster).
#
# The ConfigMap is applied via k8s_yaml() so Tilt owns its lifecycle:
# created at `tilt up`, deleted at `tilt down`. The fixed name
# `coredns-custom` is a k3s convention (it's the specific name k3s
# CoreDNS imports) — note that with that fixed name a single Tilt
# session owns the object; running two rdx workspaces with different
# loopback domains at once would have them contend for it.
# Within one session the fixed name also makes it a session-wide
# singleton — see _session_once() below for how multi-project
# workspaces register it exactly once.

# Curated wildcard-loopback dev domains: every subdomain resolves to
# 127.0.0.1 by design. Matched as the bare domain or any suffix. Extend
# as new services appear; anything not listed falls through to a live
# resolve so a custom loopback domain still works and a real domain
# (staging.corp.com) never gets its DNS hijacked.
_LOOPBACK_DOMAINS = [
    'localtest.me',
    'localhost.direct',
    'lvh.me',
    'vcap.me',
    'sslip.io',
    'nip.io',
]


def _domain_is_loopback(domain):
    """True iff `domain` should have its DNS overridden to the ingress.

    Fast path: the curated wildcard-loopback list. Slow path: resolve
    the bare name on the dev's machine and accept it only when it answers
    with a loopback address. This is the safety gate the spec requires —
    we must never override DNS for a real domain.
    """
    if not domain:
        return False
    for known in _LOOPBACK_DOMAINS:
        if domain == known or domain.endswith('.' + known):
            return True
    # Resolve with whatever the host has. getent (Linux), dig, then
    # python3's resolver (macOS has no getent) — first non-empty wins.
    # `|| true` keeps a fully tool-less host from failing the Tiltfile.
    resolved = str(local(
        "_d=" + domain + "; " +
        "ip=$(getent hosts \"$_d\" 2>/dev/null | awk '{print $1; exit}'); " +
        "[ -z \"$ip\" ] && ip=$(dig +short \"$_d\" A 2>/dev/null | " +
        "grep -E '^[0-9.]+$' | head -1); " +
        "[ -z \"$ip\" ] && ip=$(python3 -c " +
        "'import socket,sys; print(socket.gethostbyname(sys.argv[1]))' " +
        "\"$_d\" 2>/dev/null); " +
        "echo \"$ip\" || true",
        quiet=True, echo_off=True,
    )).strip()
    return resolved == '127.0.0.1' or resolved == '::1'


def _ingress_cluster_ip():
    """ClusterIP of the in-cluster ingress controller, or '' if absent.

    Tries the common Traefik label selectors, then the conventional k3s
    `kube-system/traefik` Service. Returns '' (caller warns, doesn't
    fail) when nothing matches or the Service is headless (clusterIP
    None), since a headless IP can't be used as a DNS target.
    """
    # The Traefik ClusterIP is stable for the life of a cluster, but this
    # ran up to 3 kubectl round-trips on every reload for loopback domains
    # (issue #7 M3). Cache the resolved IP to /tmp, keyed on the active
    # k8s context so a context switch re-resolves rather than reusing a
    # stale cluster's IP. The cache lives in /tmp, so a reboot starts
    # clean. Only a valid (non-empty, non-"None") IP is cached.
    _cache = '/tmp/rdx-traefik-clusterip-' + k8s_context().replace('/', '_')
    ip = str(local(
        '_cf="' + _cache + '"; ' +
        'if [ -s "$_cf" ]; then cat "$_cf"; else ' +
        "ip=$(kubectl get svc -A -l 'app.kubernetes.io/name=traefik' " +
        "-o jsonpath='{.items[0].spec.clusterIP}' 2>/dev/null); " +
        "[ -z \"$ip\" ] && ip=$(kubectl get svc -A " +
        "-l 'app.kubernetes.io/name=traefik-proxy' " +
        "-o jsonpath='{.items[0].spec.clusterIP}' 2>/dev/null); " +
        "[ -z \"$ip\" ] && ip=$(kubectl get svc traefik -n kube-system " +
        "-o jsonpath='{.spec.clusterIP}' 2>/dev/null); " +
        'if [ -n "$ip" ] && [ "$ip" != None ]; then printf "%s" "$ip" > "$_cf"; fi; ' +
        'echo "$ip"; ' +
        'fi',
        quiet=True, echo_off=True,
    )).strip()
    if ip == 'None':
        return ''
    return ip


def _coredns_serving_port():
    """Port the cluster CoreDNS main server block listens on ('53' on k3s).

    A CoreDNS server block BINDS the port in its zone header — imported
    snippets included. On stock k3s / Rancher Desktop the main block is
    `.:53` so a `domain:53` snippet shares its listener, but some
    distributions serve on an alternate port behind the kube-dns Service
    (vcluster: `.:1053`); a `:53` snippet there starts a second listener
    nothing routes to and the override is silently inert. Parse the port
    out of the conventional kube-system/coredns Corefile; fall back to
    53 whenever anything about the convention doesn't hold.

    Same /tmp cache pattern as _ingress_cluster_ip() above (issue #7
    M3): one kubectl round-trip per cluster, keyed on the k8s context.
    """
    _cache = '/tmp/rdx-coredns-port-' + k8s_context().replace('/', '_')
    port = str(local(
        '_cf="' + _cache + '"; ' +
        'if [ -s "$_cf" ]; then cat "$_cf"; else ' +
        "p=$(kubectl get cm coredns -n kube-system " +
        "-o jsonpath='{.data.Corefile}' 2>/dev/null | " +
        "sed -n 's/^[^#][^ ]*:\\([0-9][0-9]*\\)[[:space:]]*{.*/\\1/p' | " +
        'head -1); ' +
        '[ -z "$p" ] && p=53; ' +
        'printf "%s" "$p" > "$_cf"; ' +
        'echo "$p"; ' +
        'fi',
        quiet=True, echo_off=True,
    )).strip()
    if not port.isdigit():
        return '53'
    return port


def _coredns_hairpin_yaml(domain, ip, workspace, port):
    """Render the `coredns-custom` ConfigMap manifest as a string.

    The `{{ .Name }}` token in the CoreDNS `template` plugin is a Go
    template evaluated by CoreDNS at query time — it MUST reach the
    cluster verbatim. It survives Starlark because this is a plain string
    literal (no .format()) and the `%`-substitution below only consumes
    the `%s` placeholders; braces pass through untouched.
    """
    slug = domain.replace('.', '-')
    return """apiVersion: v1
kind: ConfigMap
metadata:
  name: coredns-custom
  namespace: kube-system
  labels:
    app.kubernetes.io/managed-by: rdx
  annotations:
    rdx.io/workspace: "%s"
data:
  %s.server: |
    %s:%s {
        template IN A %s {
            answer "{{ .Name }} 60 IN A %s"
        }
    }
""" % (workspace, slug, domain, port, domain, ip)


# ─── Session-wide singletons ───────────────────────────────────────────
#
# Some objects this extension registers are cluster-wide singletons
# with a fixed name — the `coredns-custom` ConfigMap below is one.
# rdx_app() runs once per project, and a multi-project workspace calls
# it several times in the same Tiltfile execution, but k8s_yaml()
# hard-fails on a second registration of the same object (Duplicate
# YAML). Singletons must therefore be registered exactly once per
# execution, by whichever rdx_app() call reaches them first.
#
# Cross-call state can't live in a module global: loaded modules are
# frozen by Starlark ("cannot insert into frozen hash table"), so the
# state lives in the process environment instead. The reset loop below
# runs at module top level, which executes exactly once per Tiltfile
# execution (load() results are cached within an execution, and every
# execution — including reloads in a running `tilt up` — re-evaluates
# the module). Each execution therefore starts with clean guards and
# re-registers every singleton exactly once.

_SESSION_ONCE_PREFIX = '_RDX_INTERNAL_ONCE_'
_SESSION_ONCE_KEYS = [
    'COREDNS_HAIRPIN',
    'KUBE_PREFLIGHT',
]
for _once_key in _SESSION_ONCE_KEYS:
    os.putenv(_SESSION_ONCE_PREFIX + _once_key, '')


def _session_once(key, identity):
    """Claim the session-wide singleton `key` for this call.

    Returns '' when the caller wins the claim (first call this
    execution: go ahead and register the object), or the identity
    recorded by the winning call (skip the registration; compare
    identities to detect conflicting intents worth a warn()).

    `key` must be listed in _SESSION_ONCE_KEYS so its guard is reset
    at module load; `identity` must be a non-empty string.
    """
    env_key = _SESSION_ONCE_PREFIX + key
    prev = os.getenv(env_key, '')
    if prev:
        return prev
    os.putenv(env_key, identity)
    return ''


def _kube_preflight():
    """Fail fast — with an actionable message — when the active kube
    context can't serve requests at Tiltfile-load time.

    rdx_app()'s bootstrap runs kubectl mutations while the Tiltfile is
    being evaluated (namespace create, pull-secret mirror). With an
    unreachable cluster — Rancher Desktop not started, a k3s that went
    away, a kubeconfig pointing at a dead endpoint — those commands die
    with raw kubectl noise (connection refused, `failed to download
    openapi`, even an interactive auth prompt) plus a traceback into
    this extension, which reads like an rdx bug instead of what it is:
    no cluster. Probe once per Tiltfile execution (session-wide
    singleton) and turn that noise into one clear failure naming the
    context and server.

    `kubectl version` costs one authenticated round-trip and no OpenAPI
    download; stdin comes from /dev/null so no kubeconfig can prompt
    and hang the load; --request-timeout bounds the wait when the
    endpoint blackholes instead of refusing.
    """
    if _session_once('KUBE_PREFLIGHT', 'ok'):
        return
    reachable = str(local(
        'kubectl version --request-timeout=5s >/dev/null 2>&1 </dev/null ' +
        '&& echo yes || echo no',
        quiet=True, echo_off=True)).strip()
    if reachable == 'yes':
        return
    server = str(local(
        "kubectl config view --minify -o " +
        "jsonpath='{.clusters[0].cluster.server}' 2>/dev/null " +
        "</dev/null || true",
        quiet=True, echo_off=True)).strip()
    fail(('[rdx] cannot reach the Kubernetes cluster for kube context ' +
          '%r (server: %s). rdx_app() creates the project namespace ' +
          'and mirrors pull-secrets while the Tiltfile loads, so ' +
          '`tilt up` needs a running, reachable cluster. Start your ' +
          'cluster (Rancher Desktop, k3s, …) or switch to a live one ' +
          '(`kubectl config use-context <ctx>`), then reload.')
         % (k8s_context(), server or 'unknown'))


def _apply_coredns_hairpin(domain, workspace):
    """Apply the CoreDNS hairpin ConfigMap for a loopback dev domain.

    No-op (with a one-line note) for non-loopback domains, and a warning
    — never a failure — when the ingress ClusterIP can't be found.

    The ConfigMap has one fixed name (kube-system/coredns-custom), so a
    multi-project workspace registers it exactly once per Tiltfile
    session: the first rdx_app() call wins, later calls with the same
    domain -> IP mapping are quiet no-ops, and a later call with a
    different mapping warns that it can't be honoured.
    """
    if not domain:
        return
    if not _domain_is_loopback(domain):
        return
    ip = _ingress_cluster_ip()
    if not ip:
        warn('[rdx] hairpin DNS: could not find the ingress controller ' +
             'ClusterIP (looked for Traefik by label and kube-system/' +
             'traefik). In-cluster calls to *.' + domain + ' will keep ' +
             'hitting pod loopback. Skipping the coredns-custom override.')
        return
    _identity = '*.' + domain + ' -> ' + ip
    _prev = _session_once('COREDNS_HAIRPIN', _identity)
    if _prev:
        if _prev != _identity:
            warn('[rdx] hairpin DNS: coredns-custom (kube-system) is ' +
                 'already registered this session for ' + _prev + '; ' +
                 'ignoring the conflicting mapping ' + _identity +
                 ' requested by ' + workspace + '. One Tilt session ' +
                 'manages a single hairpin mapping — align `domain` ' +
                 'across the workspace values.yaml files.')
        return
    port = _coredns_serving_port()
    print('[rdx] hairpin DNS: pointing *.' + domain + ' at ingress ' +
          'ClusterIP ' + ip + ' via coredns-custom (kube-system' +
          (', coredns port ' + port if port != '53' else '') + ').')
    k8s_yaml(blob(_coredns_hairpin_yaml(domain, ip, workspace, port)))


# ═══════════════════════════════════════════════════════════════════════
# Phase helpers for rdx_app() — each encapsulates one logical stage of
# the build-deploy pipeline. rdx_app() orchestrates them in order.
# ═══════════════════════════════════════════════════════════════════════

def _resolve_chart_and_stage(name, chart_path):
    """Detect chart_path, library values key, and RDX stage.

    Returns a dict with keys: chart_path, lib_key, stage.
    """
    if chart_path == None:
        if os.path.exists('deploy/Chart.yaml'):
            chart_path = 'deploy'
        elif os.path.exists('chart/Chart.yaml'):
            chart_path = 'chart'
        else:
            chart_path = 'chart'

    _lib_key = _detect_lib_key(chart_path)

    _stage = os.getenv('RDX_STAGE', '')
    if not _stage:
        _stage_file = os.path.join(chart_path, '..', '.rdx', 'stage')
        if os.path.exists(_stage_file):
            _stage = str(read_file(_stage_file)).strip()
    if not _stage:
        _stage = 'dev'

    return {'chart_path': chart_path, 'lib_key': _lib_key, 'stage': _stage}


def _bootstrap_namespace(name, chart_path, _lib_key):
    """Resolve namespace, probe rdx binary, create namespace, mirror pull-secret.

    Returns a dict with keys: namespace, rdx_present, rdx_can_expand,
    bootstrap_done.
    """
    # Everything below shells out to kubectl and mutates the cluster;
    # verify the active context answers at all before the first call so
    # a stopped cluster fails with one actionable message instead of a
    # raw kubectl error mid-bootstrap.
    _kube_preflight()

    _rdx_probe = str(local(
        'if command -v rdx > /dev/null 2>&1; then _p=yes; else _p=no; fi; ' +
        'if [ "$_p" = yes ] && rdx namespace --help > /dev/null 2>&1; ' +
        'then _c=yes; else _c=no; fi; ' +
        '_ns=""; ' +
        'if [ "$_c" = yes ]; then ' +
        '  _ck=/tmp/rdx-nsexpand-$(pwd | cksum | cut -d" " -f1); ' +
        '  if [ -f "$_ck" ] && [ "$_ck" -nt .rdx/project.yaml ]; then ' +
        '    _ns=$(cat "$_ck"); ' +
        '  else ' +
        '    _ns=$(rdx namespace expand) && printf "%s" "$_ns" > "$_ck"; ' +
        '  fi; ' +
        'fi; ' +
        '_bd=no; ' +
        'if [ -n "$_ns" ] && [ -f /tmp/rdx-"$_ns"-bootstrapped ] && ' +
        '   kubectl get namespace "$_ns" > /dev/null 2>&1 && ' +
        '   ([ "${RDX_SKIP_PULLSECRET_MIRROR:-0}" = "1" ] || kubectl get secret -n "$_ns" application-collection > /dev/null 2>&1); ' +
        'then _bd=yes; fi; ' +
        'printf "%s\\n%s\\n%s\\n%s\\n" "$_p" "$_c" "$_ns" "$_bd"',
        quiet=True, echo_off=True)).strip().split('\n')
    _rdx_present = len(_rdx_probe) > 0 and _rdx_probe[0] == 'yes'
    _rdx_can_expand = len(_rdx_probe) > 1 and _rdx_probe[1] == 'yes'
    _probe_bootstrap_done = len(_rdx_probe) > 3 and _rdx_probe[3] == 'yes'
    if _rdx_can_expand:
        namespace = _rdx_probe[2] if len(_rdx_probe) > 2 else ''
        if not namespace:
            fail('rdx_app: `rdx namespace expand` returned empty output. Check `.rdx/project.yaml`.')
    else:
        project_meta = read_yaml('.rdx/project.yaml', default={})
        ns_template = ((project_meta.get('namespace', {}) or {}).get('local', '') or '{{.project}}')
        user_value = str(local('echo "${USER:-default}"', quiet=True, echo_off=True)).strip() or 'default'
        namespace = ns_template
        for token, value in [('{{.project}}', name), ('{{ .project }}', name),
                             ('{{.user}}', user_value), ('{{ .user }}', user_value)]:
            namespace = namespace.replace(token, value)
        if '{{' in namespace or '}}' in namespace:
            fail((
                'rdx_app: namespace template %r contains an unrecognised token ' +
                'after expansion (got %r). Allowed tokens: {{.project}}, {{.user}}. ' +
                'Edit .rdx/project.yaml namespace.local to fix, or install rdx 0.1.47+ ' +
                'so this extension can shell out to `rdx namespace expand` instead.'
            ) % (ns_template, namespace))

    _bootstrap_sentinel = '/tmp/rdx-' + namespace + '-bootstrapped'
    if _rdx_can_expand:
        _bootstrap_done = _probe_bootstrap_done
    else:
        _bootstrap_done = os.path.exists(_bootstrap_sentinel) and str(local(
            'kubectl get namespace ' + namespace +
            ' > /dev/null 2>&1 && ' +
            '([ "${RDX_SKIP_PULLSECRET_MIRROR:-0}" = "1" ] || ' +
            'kubectl get secret -n ' + namespace + ' application-collection > /dev/null 2>&1) && ' +
            'echo yes || echo no',
            quiet=True, echo_off=True)).strip() == 'yes'

    if not _bootstrap_done:
        print('rdx: first-run bootstrap for namespace ' + namespace +
              ' (namespace + pull-secret + charts)…')

    if not _bootstrap_done:
        local(
            'kubectl create namespace ' + namespace +
            ' --dry-run=client -o yaml | kubectl apply -f -',
            quiet=True, echo_off=True)

    if not _bootstrap_done and os.getenv('RDX_SKIP_PULLSECRET_MIRROR', '') != '1':
        local(
            "set -e; " +
            "if kubectl get secret -n " + namespace + " application-collection " +
            ">/dev/null 2>&1; then exit 0; fi; " +
            "if [ \"$(kubectl get ns " + namespace + " -o " +
            "jsonpath='{.metadata.labels.rdx\\.io/pullsecret-managed-by}' " +
            "2>/dev/null)\" = 'operator' ]; then " +
            "echo '[rdx] skipping pullsecret mirror " +
            "(ns " + namespace + " labelled rdx.suse.com/pullsecret-managed-by=operator)'; " +
            "exit 0; fi; " +
            "if [ -n \"$(kubectl get secret -n default application-collection -o " +
            "jsonpath='{.metadata.annotations.external-secrets\\.io/owned-by}' " +
            "2>/dev/null)\" ]; then " +
            "echo '[rdx] skipping pullsecret mirror " +
            "(default Secret has external-secrets.io annotation; ESO will distribute)'; " +
            "exit 0; fi; " +
            "if [ \"$(kubectl get secret -n default application-collection -o " +
            "jsonpath='{.metadata.annotations.reflector\\.v1\\.k8s\\.emberstack\\.com/reflection-allowed}' " +
            "2>/dev/null)\" = 'true' ]; then " +
            "echo '[rdx] skipping pullsecret mirror " +
            "(default Secret has reflector annotation; kubernetes-reflector will distribute)'; " +
            "exit 0; fi; " +
            "if ! kubectl get secret -n default application-collection " +
            ">/dev/null 2>&1; then " +
            "echo '[rdx] FATAL: Secret/application-collection not found " +
            "in `default` (the SUSE Rancher Desktop extension would normally " +
            "install it there). Either install/launch the SUSE extension, " +
            "OR run `helm registry login dp.apps.rancher.io` then bootstrap " +
            "the Secret manually via kubectl create secret docker-registry; " +
            "OR set RDX_SKIP_PULLSECRET_MIRROR=1 if your cluster uses " +
            "kubernetes-reflector / External Secrets to distribute it.' >&2; " +
            "exit 1; fi; " +
            "kubectl get secret -n default application-collection -o yaml | " +
            "sed -e '/^  namespace:/d' " +
            "-e '/^  uid:/d' " +
            "-e '/^  resourceVersion:/d' " +
            "-e '/^  creationTimestamp:/d' | " +
            "kubectl apply -n " + namespace + " -f - >/dev/null && " +
            "echo '[rdx] mirrored Secret/application-collection " +
            "default -> " + namespace + "'",
            quiet=False, echo_off=True)

    if not _bootstrap_done:
        local('touch ' + _bootstrap_sentinel, quiet=True, echo_off=True)

    return {
        'namespace': namespace,
        'rdx_present': _rdx_present,
        'rdx_can_expand': _rdx_can_expand,
        'bootstrap_done': _bootstrap_done,
    }


def _resolve_image_strategy(
        name, language, builder, builder_image, extra_buildpacks,
        additional_env, live_reload, node_version, bp_log_level,
        image_labels, runtime_cert_binding, debug, debug_port,
        live_update_paths, image_ref, helm_only, build_path,
        chart_path, _lib_key, _workloads, _early_values, _early_lib):
    """Determine build strategy and register custom_build resources.

    Returns a dict with keys: builder_kind, img_repo, img_tag.
    For helm_only mode, builder_kind is None.
    """
    _builder_kind = None
    _img_repo = ''
    _img_tag = ''

    if helm_only:
        pass
    elif image_ref:
        if ':' in image_ref:
            _img_repo, _img_tag = image_ref.rsplit(':', 1)
        else:
            _img_repo = image_ref
            _img_tag = 'latest'
    else:
        # Declared non-buildpack build (DO-0016): when the live values
        # carry a build: block whose strategy isn't 'buildpack', the
        # block drives the image — the declared-build consumer registers
        # it against the workload's deployed ref after projection.
        # Registering the legacy pack path here would build the wrong
        # image AND collide with that registration on the same ref, so
        # the language argument stays a language marker only.
        _declared = (_early_values.get('build', {}) or {})
        if not _declared:
            _declared = (_early_lib.get('build', {}) or {})
        _declared_strategy = _declared.get('strategy', '')
        if _declared_strategy and _declared_strategy != 'buildpack':
            print(('[rdx] %s: values declare a %s build — the declared ' +
                   'block drives the image; language=%r is a language ' +
                   'marker only.') % (name, _declared_strategy, language))
            return {
                'builder_kind': None,
                'img_repo': '',
                'img_tag': '',
            }
        defaults = LANGUAGE_DEFAULTS[language]

        # Contract v1: prefer the overlay's resolved blocks. The
        # ext-specific knobs (buildpacks, pack_default_process,
        # pack_build_env, bci_reload) are NOT in the contract and keep
        # coming from LANGUAGE_DEFAULTS either way.
        _overlay = read_yaml(chart_path + '/.rdx/values.generated.yaml',
                             default={}) or {}
        _lang_resolved = _contract_language_block(_overlay, language)
        _builder_contract = _contract_builder_image(_overlay)

        # Builder precedence: explicit builder= argument, then the
        # values' own build.builder (live — fresher than a stale
        # overlay for the same tier), then the contract's resolved
        # image, then the pre-contract runtime chain (config default →
        # heroku) for overlays older than the contract.
        _builder_sel = builder
        if _builder_sel == None or _builder_sel == '':
            _values_build = (_early_values.get('build', {}) or {}).get('builder')
            if _values_build == None or _values_build == '':
                _values_build = (_early_lib.get('build', {}) or {}).get('builder')
            _builder_sel = _values_build
        _from_contract = False
        if (_builder_sel == None or _builder_sel == '') and _builder_contract:
            _builder_sel = _builder_contract
            _from_contract = True
        if _builder_sel == None or _builder_sel == '':
            _builder_sel = _RDX_DEFAULT_BUILDER
        if _builder_sel == None or _builder_sel == '':
            _builder_sel = 'heroku'

        if _from_contract:
            # Contract values are full image refs, already expanded
            # from any shorthand by the CLI (pinned BCI ref included).
            _builder_kind = _builder_kind_for_image(_builder_sel)
            _resolved_builder = _builder_sel
        elif _builder_sel in BUILDER_IMAGES:
            _builder_kind = _builder_sel
            _resolved_builder = BUILDER_IMAGES[_builder_sel]
        else:
            _builder_kind = _builder_sel
            _resolved_builder = _builder_sel
        builder = builder_image or _resolved_builder

        if _builder_kind != 'bci' and _is_bci_builder_image(builder):
            _builder_kind = 'bci'

        # pack_resolved (contract v1): the invocation DATA for this
        # language × the FINAL builder image. None when the pair doesn't
        # match the overlay (coupling rule) — the kind-conditional
        # tables below then stay in charge as pre-contract fallbacks.
        _pack = _contract_pack_block(_overlay, language, builder)

        if _pack != None:
            # Already resolved for the effective builder (bci → []).
            buildpacks = (_pack.get('buildpacks') or []) + extra_buildpacks
        elif _builder_kind == 'bci':
            buildpacks = list(extra_buildpacks)
        else:
            buildpacks = defaults['buildpacks'] + extra_buildpacks

        _reload_supported = bool(defaults.get('bci_reload'))
        if live_reload == None:
            live_reload = (_builder_kind == 'bci' and _reload_supported)
        if _builder_kind != 'bci':
            _bci_only_knobs = []
            if live_reload:
                _bci_only_knobs.append('live_reload')
            if node_version != None:
                _bci_only_knobs.append('node_version')
            if bp_log_level != None:
                _bci_only_knobs.append('bp_log_level')
            if image_labels != None:
                _bci_only_knobs.append('image_labels')
            if runtime_cert_binding != None:
                _bci_only_knobs.append('runtime_cert_binding')
            if debug:
                _bci_only_knobs.append('debug')
            if _bci_only_knobs:
                print('rdx: warning — ' + ', '.join(_bci_only_knobs) +
                      ' only affect the BCI builder (Paketo BP_*/BPE_* knobs); ' +
                      'ignored for builder=' + repr(_builder_kind) + '. The ' +
                      'heroku path already live-reloads via the Procfile `dev:` ' +
                      'process (nodemon).')
        elif live_reload and not _reload_supported:
            print('rdx: warning — live_reload=True ignored for language ' +
                  repr(language) + ' on the BCI builder: its buildpack ' +
                  'contributes no watchexec `reload` process. Source changes ' +
                  'trigger a full (layer-cached) pack rebuild.')

        if _builder_kind == 'bci' and os.getenv('RDX_SKIP_GHCR_CHECK', '') != '1':
            local(
                "if [ -f \"$HOME/.docker/config.json\" ] && " +
                "grep -q 'ghcr.io' \"$HOME/.docker/config.json\" 2>/dev/null; then exit 0; fi; " +
                "echo '[rdx] WARN: no ghcr.io entry in ~/.docker/config.json. " +
                "The BCI builder (" + builder + ") is in a private registry; " +
                "run `docker login ghcr.io` if `pack build` fails to pull it. " +
                "Set RDX_SKIP_GHCR_CHECK=1 to silence this check.' >&2",
                quiet=False, echo_off=True)

        # Explicit argument > contract language_resolved (authoritative
        # for its four fields, empty meaning "no sync") > pre-contract
        # LANGUAGE_DEFAULTS.
        if live_update_paths != None:
            sync_paths = live_update_paths
        elif _lang_resolved != None:
            sync_paths = _lang_resolved.get('live_update_paths') or []
        else:
            sync_paths = defaults['live_update_paths']

        cache_dir = '/tmp/rdx-pack-cache-' + name
        cache_vol = 'rdx-pack-cache-' + name
        pack_args = ['pack', 'build', '$EXPECTED_REF']
        # Cache format: contract decision first; the kind rule (heroku =
        # bind mounts, everything else = volumes) is the pre-contract
        # fallback. Cache NAMES stay this consumer's convention.
        if _pack != None and _pack.get('cache_format'):
            _cache_fmt = _pack.get('cache_format')
        else:
            _cache_fmt = 'bind' if _builder_kind == 'heroku' else 'volume'
        # Push mode publishes from pack (--publish below): every
        # lifecycle phase then runs as the builder user and the root
        # chown helper cannot fix up bind sources ("failed to chown
        # volumes"), so publish mode always rides daemon-managed volume
        # caches. The contract's bind preference keeps applying to the
        # daemon-export path.
        if os.getenv('RDX_TILT_PUSH_TO_REGISTRY') == '1':
            _cache_fmt = 'volume'
        if _cache_fmt == 'bind':
            pack_args.extend([
                '--cache', '"type=build;format=bind;source=' + cache_dir + '"',
                '--cache', '"type=launch;format=bind;source=' + cache_dir + '-launch"',
            ])
        else:
            pack_args.extend([
                '--cache', '"type=build;format=volume;name=' + cache_vol + '"',
                '--cache', '"type=launch;format=volume;name=' + cache_vol + '-launch"',
            ])
        pack_args.extend(['--builder', builder])
        for bp in buildpacks:
            pack_args.extend(['--buildpack', bp])
        for k, v in additional_env.items():
            pack_args.extend(['--env', '%s=%s' % (k, v)])
        _reload_proc = None
        if _builder_kind == 'bci':
            _reload_proc = _bci_reload_default_process(live_reload, _reload_supported)
        if _reload_proc:
            pack_args.extend(['--default-process', _reload_proc])
        else:
            # Contract preference first, table as pre-contract fallback;
            # the Procfile gate below applies to both — passing a
            # process the Procfile doesn't declare hard-fails the build.
            if _pack != None:
                dev_proc = _pack.get('default_process')
            else:
                dev_proc = defaults.get('pack_default_process')
            if dev_proc:
                _procfile_path = build_path + '/Procfile'
                _has_dev_proc = False
                if os.path.exists(_procfile_path):
                    _pf_content = str(read_file(_procfile_path))
                    for _pf_line in _pf_content.splitlines():
                        if _pf_line.startswith(dev_proc + ':'):
                            _has_dev_proc = True
                            break
                if _has_dev_proc:
                    pack_args.extend(['--default-process', dev_proc])
        if _pack != None:
            # Contract static env — already the (language, builder-kind)
            # union incl. the BCI layer. Dynamic knobs below stay code.
            for k, v in (_pack.get('env') or {}).items():
                pack_args.extend(['--env', '%s=%s' % (k, v)])
        else:
            for k, v in (defaults.get('pack_build_env') or {}).items():
                pack_args.extend(['--env', '%s=%s' % (k, v)])
            for k, v in (BUILDER_BUILD_ENV.get(_builder_kind, {}).get(language, {}) or {}).items():
                pack_args.extend(['--env', '%s=%s' % (k, v)])
        if _builder_kind == 'bci':
            _bci_env = _resolve_bci_build_env(
                language, live_reload, _reload_supported, node_version,
                bp_log_level, image_labels, runtime_cert_binding,
                debug, debug_port)
            for k, v in _bci_env.items():
                if ' ' in str(v):
                    pack_args.extend(['--env', '%s="%s"' % (k, v)])
                else:
                    pack_args.extend(['--env', '%s=%s' % (k, v)])
        _excl_action = _bci_procfile_exclude_action(
            _builder_kind, live_reload, _reload_supported,
            os.path.exists(build_path + '/Procfile'),
            os.path.exists(build_path + '/project.toml'))
        if _excl_action == 'exclude':
            _descriptor_path = '/tmp/rdx-pack-descriptor-' + name + '.toml'
            _descriptor_content = '\n'.join([
                '# Generated by tilt-extension-rdx (builder=bci, live_reload=True).',
                '# Excludes the Procfile so heroku/procfile-style process types',
                "# don't overwrite Paketo npm-start's watchexec-wrapped `web`.",
                '[_]',
                'schema-version = "0.2"',
                '',
                '[io.buildpacks]',
                'exclude = ["Procfile"]',
                '',
            ])
            local(
                "cat > '" + _descriptor_path + "' <<'RDXEOF'\n" +
                _descriptor_content + "RDXEOF\n",
                quiet=True, echo_off=True)
            pack_args.extend(['--descriptor', _descriptor_path])
        elif _excl_action == 'warn':
            print('rdx: warning — live_reload=True with builder=bci, but ' +
                  build_path + '/project.toml exists, so the Procfile is NOT ' +
                  'excluded from the build. The procfile buildpack will ' +
                  "overwrite Paketo's watchexec-wrapped `web` process and live " +
                  'reload will not take effect. Add `exclude = ["Procfile"]` ' +
                  'under [io.buildpacks] in your project.toml to enable it.')

        pack_cmd_base = ' '.join(pack_args)
        pack_cmd = pack_cmd_base + ' --path ' + build_path

        # Preflights: contract names first (unknown names ignored —
        # forward-compat), language rule as pre-contract fallback. The
        # go-mod-tidy IMPLEMENTATION is invocation code and stays here.
        if _pack != None:
            _wants_go_tidy = 'go-mod-tidy' in (_pack.get('preflights') or [])
        else:
            _wants_go_tidy = language == 'go'
        if _wants_go_tidy and os.path.exists('go.mod'):
            local(
                "set -e; " +
                "if ! command -v go >/dev/null 2>&1; then " +
                "echo '[rdx] go not on PATH; skipping go mod tidy preflight' >&2; " +
                "exit 0; fi; " +
                "if [ ! -f go.sum ] || [ go.mod -nt go.sum ]; then " +
                "echo '[rdx] running go mod tidy (go.sum missing or stale)'; " +
                "go mod tidy; " +
                "fi",
                quiet=False, echo_off=True,
            )

        live_update_steps = []
        for path in sync_paths:
            sync_target = '/workspace/' + path.lstrip('./')
            live_update_steps.append(sync(path, sync_target))
        if _lang_resolved != None:
            install_cmd = _lang_resolved.get('install_cmd')
            install_trigger = _lang_resolved.get('install_trigger') or []
        else:
            install_cmd = defaults.get('live_update_install_cmd')
            install_trigger = defaults.get('live_update_install_trigger', [])
        if install_cmd and install_trigger:
            live_update_steps.append(run(install_cmd, trigger=install_trigger))

        deps = sync_paths if sync_paths else ['.']

        _local_push = os.getenv('RDX_TILT_PUSH_TO_REGISTRY') == '1'
        if _local_push:
            # Publish straight from pack: the daemon-export path breaks
            # on daemons running the containerd image store — current
            # Docker Desktop's default — with "no suitable export target
            # found" on the run image. --publish writes EXPECTED_REF to
            # the registry with no daemon round-trip, so Tilt must
            # neither expect the image in the local daemon nor push it
            # again itself.
            pack_cmd_base += ' --publish'
            pack_cmd += ' --publish'
        _skips_local_docker = True
        _disable_push = True

        if _workloads:
            for _wl in _workloads:
                _wl_image = _wl.get('image', {}) or {}
                if _wl_image.get('tag') != 'dev':
                    continue
                _wl_repo = _wl_image.get('repository', name)
                _build_path = _wl.get('build_path', build_path)
                _wl_pack_cmd = pack_cmd_base + ' --path ' + _build_path
                custom_build(
                    ref=_wl_repo,
                    command=_wl_pack_cmd,
                    deps=deps,
                    ignore=[chart_path, 'deploy', '.rdx', 'Tiltfile'],
                    match_in_env_vars=False,
                    skips_local_docker=_skips_local_docker,
                    disable_push=_disable_push,
                    live_update=live_update_steps if live_update_steps else None,
                )
        else:
            custom_build(
                ref=name,
                command=pack_cmd,
                deps=deps,
                ignore=[chart_path, 'deploy', '.rdx', 'Tiltfile'],
                match_in_env_vars=False,
                skips_local_docker=_skips_local_docker,
                disable_push=_disable_push,
                live_update=live_update_steps if live_update_steps else None,
            )

    return {
        'builder_kind': _builder_kind,
        'img_repo': _img_repo,
        'img_tag': _img_tag,
    }


def _update_helm_deps(chart_path):
    """Run helm dependency update for vendored sub-charts.

    Handles dep filtering, repo bootstrapping, version alignment, and
    parallel OCI pulls. Also sets watch_settings to avoid reload loops.

    Short-circuits when the CLI's deps-vendored.lock sentinel is fresh:
    `rdx workspace render` already runs helm dep update and writes the
    sentinel, so re-running it here on cold start would duplicate 30-60s
    of OCI pulls per project.
    """
    # Fast path: if the CLI already vendored deps at import/render time,
    # the chart tree hasn't changed since. Skip the entire dep-update
    # pipeline. The sentinel is a SHA of Chart.yaml + Chart.lock + charts/
    # mtimes written by vendorChartDepsForRender in the Go CLI.
    _lock = chart_path + '/.rdx/deps-vendored.lock'
    if os.path.exists(_lock):
        # Validate the sentinel is still in sync with the chart tree by
        # checking that every sub-chart with dependencies has a non-empty
        # charts/ dir and its Chart.lock is newer than Chart.yaml.
        _all_fresh = True
        _charts_dir = chart_path + '/charts'
        if os.path.exists(_charts_dir):
            for _sub in listdir(_charts_dir):
                _sub_path = _sub  # listdir() returns full paths
                _sub_chart = _sub_path + '/Chart.yaml'
                if not os.path.exists(_sub_chart):
                    continue
                _sub_lock = _sub_path + '/Chart.lock'
                _sub_charts = _sub_path + '/charts'
                if not os.path.exists(_sub_lock) or not os.path.exists(_sub_charts):
                    _all_fresh = False
                    break
                # Check if Chart.yaml is newer than Chart.lock (mtime compare)
                _nt = str(local(
                    'test "%s" -nt "%s" && echo yes || echo no' % (_sub_chart, _sub_lock),
                    quiet=True, echo_off=True,
                )).strip()
                if _nt == 'yes':
                    _all_fresh = False
                    break
        if _all_fresh:
            watch_settings(ignore=[
                chart_path + '/charts/*/charts',
                chart_path + '/charts/*/tmpcharts-*',
                chart_path + '/charts/*/Chart.lock',
                chart_path + '/Chart.lock',
            ])
            return

    align_script_src = _ALIGN_SCRIPT_SRC
    align_script_path = ('/tmp/_rdx_align_subchart_versions.' +
                         str(hash(align_script_src) & 0x7fffffff) + '.py')

    filter_script_src = _FILTER_SCRIPT_SRC
    filter_script_path = ('/tmp/_rdx_filter_enabled_deps.' +
                          str(hash(filter_script_src) & 0x7fffffff) + '.py')

    bootstrap_repos_script_src = _BOOTSTRAP_REPOS_SCRIPT_SRC
    bootstrap_repos_script_path = ('/tmp/_rdx_bootstrap_helm_repos.' +
                                   str(hash(bootstrap_repos_script_src) & 0x7fffffff) + '.py')

    # Batch all three script writes into a single local() call to avoid
    # 3 sequential shell spawns (~1-2s total overhead on cold start).
    local(
        'cat > ' + align_script_path + " <<'__RDX_PY_EOF__'\n" + align_script_src + "\n__RDX_PY_EOF__\n" +
        'cat > ' + filter_script_path + " <<'__RDX_PY_EOF__'\n" + filter_script_src + "\n__RDX_PY_EOF__\n" +
        'cat > ' + bootstrap_repos_script_path + " <<'__RDX_PY_EOF__'\n" + bootstrap_repos_script_src + "\n__RDX_PY_EOF__",
        echo_off=True, quiet=True)

    helm_dep_script = (
        'set -e; ' +
        'if [ -d "' + chart_path + '/charts" ]; then ' +
        '  _need=$(mktemp); ' +
        '  for sub in "' + chart_path + '"/charts/*/; do ' +
        '    [ -d "$sub" ] || continue; ' +
        '    [ -f "$sub/Chart.yaml" ] || continue; ' +
        '    grep -q "^dependencies:" "$sub/Chart.yaml" || continue; ' +
        '    python3 "' + filter_script_path + '" "$sub" ' +
        '      "' + chart_path + '/values.yaml" ' +
        '      "' + chart_path + '/.rdx/values.generated.yaml" || ' +
        '      { echo "[rdx] FATAL: filter_enabled_deps.py failed for $sub"; exit 1; }; ' +
        '    python3 "' + bootstrap_repos_script_path + '" "$sub" || ' +
        '      { echo "[rdx] FATAL: bootstrap_helm_repos.py failed for $sub"; exit 1; }; ' +
        '    if [ -f "$sub/Chart.lock" ] && [ "$sub/Chart.lock" -nt "$sub/Chart.yaml" ] && ' +
        '       [ -d "$sub/charts" ] && [ -n "$(ls -A "$sub/charts" 2>/dev/null)" ]; then ' +
        '      python3 "' + align_script_path + '" "$sub"; ' +
        '    else ' +
        '      printf "%s\\n" "$sub" >> "$_need"; ' +
        '    fi; ' +
        '  done; ' +
        '  _fail=$(mktemp); rm -f "$_fail"; _n=0; ' +
        '  while IFS= read -r sub; do ' +
        '    [ -n "$sub" ] || continue; ' +
        '    ( echo "[rdx] helm dep update --skip-refresh $sub"; ' +
        '      helm dependency update --skip-refresh "$sub" && ' +
        '      python3 "' + align_script_path + '" "$sub" || ' +
        '      { echo "[rdx] FATAL: helm dep update/align failed for $sub" >&2; : > "$_fail"; } ' +
        '    ) & ' +
        '    _n=$((_n+1)); ' +
        '    if [ "$_n" -ge 4 ]; then wait; _n=0; fi; ' +
        '  done < "$_need"; ' +
        '  wait; ' +
        '  rm -f "$_need"; ' +
        '  if [ -f "$_fail" ]; then rm -f "$_fail"; ' +
        '    echo "[rdx] FATAL: one or more sub-chart dep updates failed" >&2; exit 1; fi; ' +
        '  rm -f "$_fail"; ' +
        'fi'
    )
    local(helm_dep_script, echo_off=True, quiet=False)

    watch_settings(ignore=[
        chart_path + '/charts/*/charts',
        chart_path + '/charts/*/tmpcharts-*',
        chart_path + '/charts/*/Chart.lock',
        chart_path + '/Chart.lock',
    ])


def _run_dsl_projection(chart_path, _rdx_present, _stage, chart_values_files):
    """Run `rdx render` and append the generated overlay to chart_values_files.

    Returns the updated chart_values_files list.
    """
    if chart_values_files == None:
        chart_values_files = [chart_path + '/values.yaml']

    if _rdx_present:
        stage_path_root = os.path.join(os.path.dirname(chart_path), '.rdx', 'stage')
        watch_file(stage_path_root)
        local('rdx render --stage %s' % _stage, quiet=True, echo_off=False)
        new_overlay = chart_path + '/.rdx/values.generated.yaml'
        old_overlay = chart_path + '/values.generated.yaml'
        if os.path.exists(new_overlay):
            generated_overlay = new_overlay
        elif os.path.exists(old_overlay):
            generated_overlay = old_overlay
            print('rdx: note — using legacy ' + old_overlay +
                  '. rdx-cli v0.1.38+ writes to chart/.rdx/values.generated.yaml; ' +
                  'next `rdx render` will migrate. You can delete the legacy ' +
                  'file once chart/.rdx/values.generated.yaml exists.')
        else:
            generated_overlay = ''
        if generated_overlay != '':
            if generated_overlay not in chart_values_files:
                chart_values_files = chart_values_files + [generated_overlay]
    else:
        print('rdx: warning — `rdx` not on PATH; chart/.rdx/values.generated.yaml ' +
              'will not be regenerated. Install rdx CLI to keep services[] DSL ' +
              'in sync with sub-chart values. See idefxH/rdx-cli.')

    return chart_values_files


def _discover_services(parsed_values, parsed_values_paths, _lib_key):
    """Auto-discover services from rdx-library.services[] in values.

    Returns a dict mapping binding_name -> service_type.
    """
    def _is_overlay_path(p):
        if not p:
            return False
        return (p.endswith('/.rdx/values.generated.yaml') or
                p.endswith('/values.generated.yaml') or
                p == '.rdx/values.generated.yaml' or
                p == 'values.generated.yaml')

    services = {}
    all_lib_blocks = []
    all_services_by_binding = {}
    for i in range(len(parsed_values)):
        cfg = parsed_values[i]
        cfg_path = parsed_values_paths[i]
        lib = (cfg.get(_lib_key, {}) or {}) if cfg else {}
        all_lib_blocks.append(lib)
        if _is_overlay_path(cfg_path):
            continue
        for entry in (lib.get('services') or []):
            if entry.get('binding'):
                all_services_by_binding[entry['binding']] = entry

    def _chart_enabled(stype, binding=''):
        for lib in all_lib_blocks:
            if (lib.get(stype, {}) or {}).get('enabled'):
                return True
            if binding:
                alias = stype + '-' + binding
                if (lib.get(alias, {}) or {}).get('enabled'):
                    return True
        return False

    for binding in all_services_by_binding:
        entry = all_services_by_binding[binding]
        stype = entry.get('type')
        provisioning = entry.get('provisioning', '')
        if provisioning not in ('', 'local', 'deploy'):
            continue
        if entry.get('enabled', True) == False:
            continue
        if type(stype) == "string" and "[redacted" in stype:
            warn(("[rdx] skipping services[binding=%r]: type=%r " +
                  "is a redacted secret marker. The DSL type should be " +
                  "a plain string (e.g. 'grafana'). Check the bundle's " +
                  "dsl-mappings.yaml for a values_mapping that routes " +
                  "`services[].type` through a binding secret — that's " +
                  "the layer to fix; the Tiltfile cannot recover a real " +
                  "type from the redacted marker.") % (binding, stype))
            continue
        if not _chart_enabled(stype, binding):
            continue
        if stype:
            services[binding] = stype

    return services


def _register_app_workloads(
        name, _workloads, _lib_key, parsed_values, labels,
        _domain_value, _app_oidc_deps, port):
    """Register k8s_resource for app workloads (workloads[] or legacy single).

    Returns None. Port is only used in legacy single-workload mode.
    """
    def _ingress_links(block, ingress_key='ingress', domain=''):
        ing = block.get(ingress_key, {}) if block else {}
        hosts = ing.get('hosts', [])
        if not hosts:
            if not ing.get('enabled'):
                return []
        scheme = 'https' if ing.get('tls') else 'http'
        out = []
        for h in hosts:
            if type(h) == "string":
                host = h
            elif type(h) == "dict":
                host = h.get('host', '')
            else:
                continue
            if not host:
                continue
            if "{{" in host or "}}" in host:
                if domain:
                    host = host.replace("{{.domain}}", domain).replace("{{ .domain }}", domain)
                else:
                    continue
            if "{{" in host or "}}" in host:
                continue
            out.append(link(scheme + '://' + host, host))
        return out

    if _workloads:
        _merged_workloads = []
        for cfg in parsed_values:
            lib = (cfg.get(_lib_key, {}) or {}) if cfg else {}
            wls = lib.get('workloads')
            if wls:
                _merged_workloads = wls
        if not _merged_workloads:
            _merged_workloads = _workloads

        _chart_name = name
        for cfg in parsed_values:
            lib = (cfg.get(_lib_key, {}) or {}) if cfg else {}
            if lib.get('name'):
                _chart_name = lib['name']

        for _wl in _merged_workloads:
            _wl_name = _wl.get('name', 'app')
            _wl_port = _wl.get('port')
            _local_port = _wl.get('localPort', _wl_port)
            _wl_links = _ingress_links(_wl, domain=_domain_value)
            _resource_name = _chart_name + '-' + _wl_name
            if _wl_port:
                k8s_resource(
                    workload=_resource_name,
                    port_forwards='%d:%d' % (_local_port, _wl_port),
                    labels=[labels.get(_resource_name, 'app')],
                    links=_wl_links,
                    resource_deps=_app_oidc_deps,
                    auto_init=True,
                )
            else:
                k8s_resource(
                    workload=_resource_name,
                    labels=[labels.get(_resource_name, 'app')],
                    links=_wl_links,
                    resource_deps=_app_oidc_deps,
                )
    else:
        app_links = []
        for cfg in parsed_values:
            app_links.extend(_ingress_links(cfg.get(_lib_key, {}) or {}, domain=_domain_value))

        k8s_resource(
            workload=name,
            port_forwards='%d:%d' % (port, port),
            labels=[labels.get(name, 'app')],
            links=app_links,
            resource_deps=_app_oidc_deps,
        )


def _register_service_workloads(
        name, namespace, services, _lib_key, parsed_values,
        parsed_values_paths, catalogued_charts, labels,
        _domain_value, _bootstrap_done):
    """Register k8s_resource for each declared service, operator hooks, and port-forwards."""

    def _ingress_links(block, ingress_key='ingress', domain=''):
        ing = block.get(ingress_key, {}) if block else {}
        hosts = ing.get('hosts', [])
        if not hosts:
            if not ing.get('enabled'):
                return []
        scheme = 'https' if ing.get('tls') else 'http'
        out = []
        for h in hosts:
            if type(h) == "string":
                host = h
            elif type(h) == "dict":
                host = h.get('host', '')
            else:
                continue
            if not host:
                continue
            if "{{" in host or "}}" in host:
                if domain:
                    host = host.replace("{{.domain}}", domain).replace("{{ .domain }}", domain)
                else:
                    continue
            if "{{" in host or "}}" in host:
                continue
            out.append(link(scheme + '://' + host, host))
        return out

    def _rdx_lib_block(values_dict, path_keys):
        block = values_dict.get(_lib_key, {}) or {}
        for key in path_keys:
            block = (block.get(key, {}) or {}) if hasattr(block, 'get') else {}
        return block

    def workload_name_for(release, chart_alias, service_type):
        chart_entry = catalogued_charts.get(service_type, {})
        versions = chart_entry.get('versions', [])
        if not versions:
            return release + '-' + chart_alias
        ver = versions[0]
        if ver.get('operator_managed', False):
            op_tpl = ver.get('operator_resource', '')
            if op_tpl:
                if chart_alias != service_type:
                    op_tpl = op_tpl.replace('-' + service_type, '-' + chart_alias, 1)
                return op_tpl.replace('{{ .Release.Name }}', release).replace('{{.Release.Name}}', release)
        host_tpl = ver.get('service', {}).get('host', '')
        if not host_tpl:
            return release + '-' + chart_alias
        if chart_alias != service_type:
            host_tpl = host_tpl.replace('-' + service_type + '.', '-' + chart_alias + '.', 1)
        rendered = host_tpl.replace('{{ .Release.Name }}', release).replace('{{.Release.Name}}', release)
        if '.' in rendered:
            rendered = rendered.split('.', 1)[0]
        return rendered

    def _bad_workload_name(s):
        if not s or not s.strip():
            return True
        if '{{' in s or '}}' in s:
            return True
        if '[redacted' in s or 'redacted secret' in s:
            return True
        return False

    # Compute chart aliases for multi-instance support.
    type_counts = {}
    for binding_name, service_type in services.items():
        type_counts[service_type] = type_counts.get(service_type, 0) + 1

    aliases = {}
    for binding_name, service_type in services.items():
        if type_counts[service_type] == 1:
            aliases[binding_name] = service_type
        else:
            aliases[binding_name] = service_type + '-' + binding_name

    # OIDC/Dex startup ordering.
    _OIDC_PROVIDER_TYPES = ['dex']
    _app_oidc_deps = []
    for _oidc_binding, _oidc_type in services.items():
        if _oidc_type not in _OIDC_PROVIDER_TYPES:
            continue
        _oidc_ce = catalogued_charts.get(_oidc_type, {})
        _oidc_cvs = _oidc_ce.get('versions', [])
        if _oidc_cvs and _oidc_cvs[0].get('operator_managed', False):
            continue
        _oidc_wl = workload_name_for(name, aliases[_oidc_binding], _oidc_type)
        if _bad_workload_name(_oidc_wl):
            continue
        if _oidc_wl not in _app_oidc_deps:
            _app_oidc_deps.append(_oidc_wl)

    # Register CRD kinds for operator-managed charts.
    _registered_kinds = {}
    for _stype in services.values():
        _ce = catalogued_charts.get(_stype, {})
        _cvs = _ce.get('versions', [])
        if _cvs and _cvs[0].get('operator_managed'):
            _cr_kind_info = _cvs[0].get('cr_kind', {})
            if _cr_kind_info:
                _kind_key = _cr_kind_info.get('kind', '')
                _api_ver = _cr_kind_info.get('api_version', '')
                if _kind_key and _kind_key not in _registered_kinds:
                    k8s_kind(_kind_key, api_version=_api_ver, pod_readiness='wait')
                    _registered_kinds[_kind_key] = True

    # Operator admission-webhook lifecycle hooks.
    _OPERATOR_DEFAULTS = {
        'cnpg': {
            'webhook_service_name': 'cnpg-webhook-service',
            'webhook_app_label': 'cloudnative-pg',
        },
    }
    _op_hooks = []
    _op_seen_types = {}
    for _binding, _stype in services.items():
        if _stype in _op_seen_types:
            continue
        _ce = catalogued_charts.get(_stype, {})
        _cvs = _ce.get('versions', [])
        if not _cvs:
            continue
        _ver = _cvs[0]
        if not _ver.get('operator_managed'):
            continue
        _defaults = _OPERATOR_DEFAULTS.get(_stype, {})
        _wh_svc = _ver.get('webhook_service_name',
                           _defaults.get('webhook_service_name', ''))
        if not _wh_svc:
            continue
        _op_seen_types[_stype] = True
        _wh_ns = _ver.get('webhook_namespace', '') or namespace
        _wh_label = _ver.get('webhook_app_label',
                             _defaults.get('webhook_app_label', ''))
        _op_res = ''
        _op_tpl = _ver.get('operator_resource', '')
        if _op_tpl:
            _op_res = (_op_tpl
                .replace('{{ .Release.Name }}', name)
                .replace('{{.Release.Name}}', name))
        _op_hooks.append({
            'service_type': _stype,
            'webhook_service_name': _wh_svc,
            'webhook_namespace': _wh_ns,
            'webhook_app_label': _wh_label,
            'operator_resource': _op_res,
            'ready_resource': name + '-' + _stype + '-webhook-ready',
        })

    _op_ready_by_type = {}
    for _h in _op_hooks:
        _op_ready_by_type[_h['service_type']] = _h['ready_resource']

    for _hook in _op_hooks:
        if _hook['webhook_app_label'] and not _bootstrap_done:
            _sel = 'app.kubernetes.io/name=' + _hook['webhook_app_label']
            local(
                "set -e; " +
                "for wc in " +
                "$(kubectl get mutatingwebhookconfigurations.admissionregistration.k8s.io " +
                "-l " + _sel + " -o name 2>/dev/null) " +
                "$(kubectl get validatingwebhookconfigurations.admissionregistration.k8s.io " +
                "-l " + _sel + " -o name 2>/dev/null); do " +
                "ns=$(kubectl get \"$wc\" -o " +
                "jsonpath='{.webhooks[0].clientConfig.service.namespace}' 2>/dev/null); " +
                "if [ -n \"$ns\" ] && ! kubectl get namespace \"$ns\" " +
                ">/dev/null 2>&1; then " +
                "kubectl delete \"$wc\" --ignore-not-found >/dev/null && " +
                "echo \"[rdx] pruned stale " + _hook['service_type'] +
                " webhook $wc (target ns $ns missing)\"; " +
                "fi; " +
                "done",
                quiet=False, echo_off=True)

        _wait_deps = []
        if _hook['operator_resource']:
            _wait_deps = [_hook['operator_resource']]
        local_resource(
            _hook['ready_resource'],
            cmd=(
                "set -e; " +
                "for i in $(seq 1 90); do " +
                "ips=$(kubectl get endpoints " + _hook['webhook_service_name'] + " " +
                "-n " + _hook['webhook_namespace'] + " " +
                "-o jsonpath='{.subsets[*].addresses[*].ip}' " +
                "2>/dev/null || true); " +
                "if [ -n \"$ips\" ]; then " +
                "echo \"[rdx] " + _hook['webhook_service_name'] +
                " endpoints ready in " + _hook['webhook_namespace'] + ": $ips\"; " +
                "exit 0; " +
                "fi; " +
                "sleep 2; " +
                "done; " +
                "echo \"[rdx] FATAL: " + _hook['webhook_service_name'] +
                " has no endpoints after 180s in ns " + _hook['webhook_namespace'] + "\" >&2; " +
                "exit 1"
            ),
            resource_deps=_wait_deps,
            labels=[_hook['service_type']],
            allow_parallel=True,
        )

    # Service port-forward registration.
    used_local_ports = {}
    for binding_name, service_type in services.items():
        chart_alias = aliases[binding_name]
        workload = workload_name_for(name, chart_alias, service_type)
        if _bad_workload_name(workload):
            warn(('[rdx] skipping k8s_resource for binding %r ' +
                  '(type=%r): computed workload name %r is not a valid ' +
                  'k8s resource name. This usually means dsl-mappings.yaml ' +
                  'has a host/cr_object template that references a value ' +
                  'the Tiltfile cannot resolve (e.g. a binding-secret key ' +
                  'in `provisioning: connect` mode). Set provisioning ' +
                  'explicitly if you meant to deploy in-cluster, or ignore ' +
                  'this warning if Tilt auto-discovers the workload.') %
                 (binding_name, service_type, workload))
            continue

        svc_port = 0
        chart_entry = catalogued_charts.get(service_type, {})
        chart_versions = chart_entry.get('versions', [])

        _ingress_vm = (chart_versions[0].get('values_mapping', {}) or {}).get('ingress.enabled', '') if chart_versions else ''
        if _ingress_vm:
            _segs = _ingress_vm.split('.')
            ingress_path = _segs[1:-1] if len(_segs) > 2 else ['ingress']
        else:
            ingress_path = ['ingress']
        svc_links = []
        for cfg in parsed_values:
            parent = _rdx_lib_block(cfg, [chart_alias] + ingress_path[:-1])
            svc_links.extend(_ingress_links(parent, ingress_path[-1], domain=_domain_value))
        is_operator_managed = False
        pod_selector = {}
        cr_object = ''
        operator_resource = ''
        if chart_versions:
            svc_spec = chart_versions[0].get('service', {})
            svc_port = svc_spec.get('port', 0)
            is_operator_managed = chart_versions[0].get('operator_managed', False)
            raw_selector = chart_versions[0].get('pod_selector', {})
            for sel_k, sel_v in raw_selector.items():
                pod_selector[sel_k] = sel_v.replace('{{ .Release.Name }}', name).replace('{{.Release.Name}}', name)
            raw_cr = chart_versions[0].get('cr_object', '')
            if raw_cr:
                cr_object = raw_cr.replace('{{ .Release.Name }}', name).replace('{{.Release.Name}}', name)
            raw_op = chart_versions[0].get('operator_resource', '')
            if raw_op:
                operator_resource = raw_op.replace('{{ .Release.Name }}', name).replace('{{.Release.Name}}', name)
            if not svc_port and svc_spec.get('ports'):
                for pname, pspec in svc_spec['ports'].items():
                    if pspec.get('primary', False):
                        svc_port = pspec.get('port', 0)
                        break
                if not svc_port:
                    for pname, pspec in svc_spec['ports'].items():
                        svc_port = pspec.get('port', 0)
                        break

        if is_operator_managed and cr_object:
            cr_name = cr_object.split(':')[0]
            if _bad_workload_name(cr_name):
                warn(('[rdx] skipping k8s_resource for operator CR ' +
                      'of binding %r (type=%r): computed cr_name %r is ' +
                      'not a valid k8s resource name. The CRD entry in ' +
                      'dsl-mappings.yaml has a `cr_object` template the ' +
                      'Tiltfile cannot resolve.') %
                     (binding_name, service_type, cr_name))
                continue
            resource_kwargs = {
                'workload': cr_name,
                'labels': [labels.get(workload, 'services')],
                'links': svc_links,
            }
            if pod_selector:
                resource_kwargs['extra_pod_selectors'] = [pod_selector]
            _cr_deps = []
            if operator_resource:
                _cr_deps.append(operator_resource)
            _wh_ready = _op_ready_by_type.get(service_type, '')
            if _wh_ready:
                _cr_deps.append(_wh_ready)
            if _cr_deps:
                resource_kwargs['resource_deps'] = _cr_deps
            if svc_port:
                local_port = svc_port
                if local_port < 1024:
                    local_port = svc_port + 10000
                while local_port in used_local_ports:
                    local_port += 1
                used_local_ports[local_port] = True
                resource_kwargs['port_forwards'] = '%d:%d' % (local_port, svc_port)
            k8s_resource(**resource_kwargs)
        elif svc_port:
            local_port = svc_port
            if local_port < 1024:
                local_port = svc_port + 10000
            while local_port in used_local_ports:
                local_port += 1
            used_local_ports[local_port] = True
            k8s_resource(
                workload=workload,
                port_forwards='%d:%d' % (local_port, svc_port),
                labels=[labels.get(workload, 'services')],
                links=svc_links,
            )
        else:
            k8s_resource(
                workload=workload,
                labels=[labels.get(workload, 'services')],
                links=svc_links,
            )

    return _app_oidc_deps


# ═══════════════════════════════════════════════════════════════════════
# rdx_app() — orchestrator
# ═══════════════════════════════════════════════════════════════════════

def _register_declared_build(name, parsed_values, _lib_key, language,
                             image_ref, helm_only):
    """Register the build declared by workloads_resolved[].build.

    P1 of the values.generated.yaml contract (DO-0015/DO-0016): the CLI
    computes and validates the block at render time; this consumer only
    wires it into Tilt. The build ref is the workload's DEPLOYED image
    reference (values image.repository[:tag]) — Tilt substitution links
    build to Deployment by that ref, so the block works on image_ref
    projects without touching chart values. No key → no-op (pull, and
    pre-contract CLIs keep today's behaviour).
    """
    block = None
    image = {}
    for _cfg in parsed_values:
        _lib = (_cfg.get(_lib_key, {}) or {}) if _cfg else {}
        for _wl in (_lib.get('workloads_resolved') or []):
            if _wl.get('build'):
                block = _wl['build']
                image = _wl.get('image') or image
            elif _wl.get('image'):
                image = _wl.get('image')
            break  # v1: app workload = first entry
    if not block:
        return
    # Legacy precedence: an explicit language arg means the pack path
    # already registered this project's build in the image phase —
    # but only when the two AGREE (buildpack block). On a disagreement
    # the image phase yielded for exactly this case, so the declared
    # block falls through and registers here.
    if language and not helm_only and not image_ref:
        # Migration window: fresh imports write a buildpack block AND
        # keep language= on rdx_app(). When the two agree the legacy
        # pack path simply keeps driving — same builder chain, same
        # semantics — so stay silent and leave it in charge.
        if block.get('strategy', '') == 'buildpack':
            return
        print(('[rdx] %s: values declare a %s build — the declared ' +
               'block drives the image; the scaffolded language=%r ' +
               'argument no longer selects the build path.')
              % (name, block.get('strategy', ''), language))
    repo = str(image.get('repository') or '')
    if not repo and image_ref:
        repo = image_ref.rsplit(':', 1)[0]
    if not repo:
        warn('[rdx] %s: build block present but no workload image ' +
             'reference to bind it to; skipping.' % name)
        return
    strategy = block.get('strategy', '')
    context = block.get('context', '')
    _lu = []
    for _w in (block.get('watch') or []):
        _s = (_w or {}).get('sync') or {}
        if _s.get('local') and _s.get('container'):
            _lu.append(sync(os.path.join(context, _s['local']),
                            _s['container']))
    if strategy == 'dockerfile':
        _kw = {'live_update': _lu}
        if block.get('target'):
            _kw['target'] = block['target']
        if block.get('args'):
            _kw['build_args'] = block['args']
        docker_build(repo, context,
                     dockerfile=os.path.join(context,
                                             block.get('dockerfile',
                                                       'Dockerfile')),
                     **_kw)
        print('[rdx] %s: building %s from %s (dockerfile, declared)' %
              (name, repo, context))
    elif strategy == 'buildpack':
        # Contract v1: builder_resolved from the SAME overlay this block
        # came from (fresh — the projection phase just wrote it) is the
        # CLI-applied chain (block builder → config default_builder →
        # heroku), shorthands already expanded to pinned refs. The chain
        # below survives solely as the pre-contract fallback for
        # overlays written by older CLIs.
        _builder_img = ''
        for _cfg in parsed_values:
            _from_overlay = _contract_builder_image(_cfg)
            if _from_overlay:
                _builder_img = _from_overlay
        if not _builder_img:
            _bb = block.get('builder', '') or _RDX_DEFAULT_BUILDER or 'heroku'
            _builder_img = ('ghcr.io/idefxh/builder-bci-base'
                            if _bb == 'bci' else 'heroku/builder:24')
        # Same containerd-image-store rule as the legacy pack path:
        # push mode publishes from pack and Tilt stays out of the
        # daemon entirely.
        _pub = os.getenv('RDX_TILT_PUSH_TO_REGISTRY') == '1'
        custom_build(
            repo,
            'pack build $EXPECTED_REF --builder ' + _builder_img +
            ' --path ' + context + (' --publish' if _pub else ''),
            deps=[context],
            skips_local_docker=_pub,
            disable_push=_pub,
        )
        print('[rdx] %s: building %s from %s (buildpack %s, declared)' %
              (name, repo, context, _builder_kind_for_image(_builder_img)))
    else:
        warn('[rdx] %s: unknown declared build strategy %r; skipping.'
             % (name, strategy))


def rdx_app(
        name,
        language=None,
        port=None,
        services=None,
        chart_path=None,
        chart_values_files=None,
        builder=None,
        builder_image=None,
        extra_buildpacks=[],
        additional_env={},
        live_reload=None,
        node_version=None,
        bp_log_level=None,
        image_labels=None,
        runtime_cert_binding=None,
        debug=False,
        debug_port=None,
        live_update_paths=None,
        ui_labels=None,
        image_ref=None,
        helm_only=False,
        build_path='.'):
    """Build a project image with pack, deploy its Helm chart, and surface
    convenient port-forwards for the app and any declared services.

    Required:
        name (str): project name. Must equal the Helm release name and the
            chart's metadata.name (so the Deployment resource name matches).
        language (str|None): one of 'nodejs', 'python', 'java', 'go'. Drives
            the default buildpacks and live-update behaviour. Optional when
            image_ref or helm_only is set; an empty / None value also
            implies helm_only mode (chart-only deploy, no pack build).

    Common:
        port (int|None): HTTP port exposed by the app container. **Default
            None — derived from `rdx-library.port` in chart/values.yaml.**
            The library chart already reads `.Values.port` as the
            container's port AND the Service's targetPort, so values.yaml
            is the source of truth. Don't pass this argument unless you
            need to override; if you pass a value that mismatches
            values.yaml, the Tiltfile fails fast (forcing the dev to fix
            the duplication rather than carry two drifting numbers). When
            values.yaml has no `rdx-library.port` entry, falls back to
            the library chart's own default of 8080.
        services (dict|None): map of service binding name -> service type.
            Port-forwards are resolved from dsl-mappings.yaml (data-driven).
            Example: {'database': 'postgresql'}.
            **When None (default), services are auto-discovered from
            chart_values_files** — every entry in `rdx-library.services[]`
            (the unified DSL) and every chart with `rdx-library.<chart>.enabled:
            true` (the legacy gate) is registered. This is the recommended
            mode: `rdx service add <type> <binding>` updates values.yaml,
            and Tilt picks up the change on the next reload — nothing in the
            Tiltfile needs to be in lockstep with values.yaml.
            Pass an explicit dict to opt out of auto-discovery (e.g. to
            register a service the chart doesn't deploy itself).
        chart_path (str|None): path to the Helm chart relative to the Tiltfile.
            **Default None — auto-detected.** Prefers 'deploy/' (the new
            convention from bundle 0.11.13+ scaffolds, where the directory
            name signals the directory's purpose: it's what gets deployed
            to Kubernetes). Falls back to 'chart/' for projects scaffolded
            before the rename. Pass a path explicitly to override (e.g.
            'helm/' for a non-scaffold project, or 'chart' to force the
            legacy name during migration).
        chart_values_files (list[str]): values files passed to helm. Default
            [chart_path + '/values.yaml'] (so values.yaml is resolved inside
            the chart directory). Override with paths relative to the Tiltfile
            if your project keeps values somewhere else.

    Brownfield:
        image_ref (str|None): pre-built container image (e.g.
            'registry.corp.com/my-app:v2.3.1'). Skips pack build entirely
            and passes image.repository + image.tag to helm.
        helm_only (bool): when True, skip ALL image management. The user
            provides their image through their own mechanism. Just helm
            deploy + port-forwards.

    Override:
        builder (str|None): CNB builder family. 'heroku' uses
            heroku/builder:24 with heroku/* buildpacks; 'bci' uses the BCI
            builder (ghcr.io/idefxh/builder-bci-base), which ships Paketo
            buildpacks and resolves the language buildpacks by its own
            detection order — callers don't restate buildpack IDs. With
            'bci', `pack` needs local ghcr.io credentials (run
            `docker login ghcr.io` once); a preflight warns if none are
            found. Any other string is treated as a raw CNB builder image
            and used as-is. **Default None — when omitted, the builder is
            resolved at runtime from (in order) values.yaml `build.builder`,
            then `default_builder` in ~/.config/rdx/config.yaml, then
            'heroku'.** This means changing config.yaml re-applies on the
            next Tilt reload without re-importing the project.
        builder_image (str): raw CNB builder image, overriding the image
            resolved from `builder` while keeping that builder's buildpack
            family. E.g. pin a digest:
            builder_image='ghcr.io/idefxh/builder-bci-base:16.0.2'.
        extra_buildpacks (list[str]): additional CNB buildpacks. Useful for
            the future RDX OTel buildpack or a service-binding buildpack.
            These are passed verbatim — namespace them for the selected
            builder (paketo-buildpacks/* when builder='bci') and pin a
            version, since the BCI builder bundles multiple versions of each
            buildpack. With builder='heroku' they are appended to the
            language defaults; with builder='bci' they are the only
            buildpacks named explicitly (the builder detects the rest).
        additional_env (dict): build-time env vars passed via `pack build --env`.
            E.g. {'BP_NODE_VERSION': '22'}. This is the raw escape hatch for
            any Paketo BP_*/BPE_* knob not surfaced as a dedicated argument
            (e.g. Go: BP_GO_TARGETS / BP_GO_BUILD_LDFLAGS; Java:
            BP_JVM_VERSION / BP_MAVEN_BUILD_ARGUMENTS / BP_GRADLE_BUILD_ARGUMENTS;
            Python: BP_CPYTHON_VERSION). The dedicated args below win over
            additional_env on a key clash (curated defaults applied last).

        Paketo / BCI builder knobs (builder='bci' only — these map to Paketo
        BP_*/BPE_* build vars that the heroku/* buildpacks don't read. Setting
        any of them with builder='heroku' prints one warning and is ignored;
        the heroku path already live-reloads via the Procfile `dev:` process):

        live_reload (bool|None): default None — ON for the BCI builder on
            languages whose Paketo buildpack supports watchexec
            (nodejs/python/java), OFF otherwise (heroku reloads via the
            Procfile `dev:` process; go rebuilds via pack). Pass True/False
            to override. When on, sets
            BP_LIVE_RELOAD_ENABLED=true (Paketo wraps the buildpack's own
            `web` process in watchexec), selects `--default-process web`, and
            EXCLUDES the project's Procfile from the build context via a pack
            project descriptor — otherwise the procfile buildpack's `web:`
            entry overwrites the watchexec-wrapped `web` and reload silently
            stops working. A Tilt live_update file sync then restarts just
            the app process (the Paketo-native equivalent of the heroku
            nodemon `dev:` hack). Requires an npm `start` script (Node) /
            equivalent native entrypoint, since the Procfile is excluded.
            Supported for nodejs/python/java; ignored with a warning for go
            (its BCI buildpack doesn't support watchexec reload and Go isn't
            in the run image). If the project ships its own project.toml, the
            Procfile is left in place (we don't clobber a user descriptor)
            and a warning explains how to exclude it. NOTE: watchexec uses
            inotify by default, which can miss events on some
            containerd/overlayfs setups — if reloads don't fire, the default
            nodemon path (live_reload=False) is the safe fallback.
        node_version (str): pin the Node runtime via BP_NODE_VERSION
            (nodejs only). Paketo ALSO auto-reads .node-version, .nvmrc and
            package.json#engines.node — prefer committing one of those; this
            argument is the explicit override.
        bp_log_level (str): BP_LOG_LEVEL for verbose buildpack logs, e.g.
            'DEBUG'. First thing to reach for when a BCI build misbehaves.
        image_labels (dict): OCI labels baked by the image-labels buildpack
            via BP_IMAGE_LABELS (space-delimited key=value pairs).
        runtime_cert_binding (bool): the ca-certificates buildpack reads a
            `ca-certificates` service binding at LAUNCH by default (already
            on). Pass False to disable (BP_ENABLE_RUNTIME_CERT_BINDING=false);
            True/None leave the Paketo default untouched.
        debug (bool): bake a launch-time debug default via the
            environment-variables buildpack
            (BPE_DEFAULT_BPL_DEBUG_ENABLED=true), so the runtime process
            starts its debug agent. Honoured by the JVM (bellsoft-liberica);
            for Node set additional_env={'BPE_DEFAULT_NODE_OPTIONS':
            '--inspect=0.0.0.0:<port>'} instead. Forward the debug port
            yourself (`kubectl port-forward` / a Tilt port_forward) — this
            flag only configures the image, it does not open a port.
        debug_port (int): paired with debug=True, sets
            BPE_DEFAULT_BPL_DEBUG_PORT.

        Monorepos: pass build_path='<subdir>' (it becomes `pack build
        --path <subdir>`), which scopes the build context to that directory
        for every builder — no separate BP_NODE_PROJECT_PATH needed.

        live_update_paths (list[str]): override default sync paths. Pass an
            empty list to disable live_update entirely.
        ui_labels (dict): map of resource name -> Tilt UI label. Defaults
            map the app to 'app', services to 'services'.
    """
    if not helm_only and not image_ref:
        if not language:
            helm_only = True
        elif language not in LANGUAGE_DEFAULTS:
            fail('rdx_app: unsupported language %r. Supported: %s' % (
                language, ', '.join(sorted(LANGUAGE_DEFAULTS.keys()))))

    # Phase 1: Resolve chart path, library key, and stage.
    _ctx = _resolve_chart_and_stage(name, chart_path)
    chart_path = _ctx['chart_path']
    _lib_key = _ctx['lib_key']
    _stage = _ctx['stage']

    labels = ui_labels or {}

    # Phase 2: Bootstrap namespace (resolve, create, mirror pull-secret).
    _ns_ctx = _bootstrap_namespace(name, chart_path, _lib_key)
    namespace = _ns_ctx['namespace']
    _rdx_present = _ns_ctx['rdx_present']
    _rdx_can_expand = _ns_ctx['rdx_can_expand']
    _bootstrap_done = _ns_ctx['bootstrap_done']

    # Phase 3: Read early values for workloads detection.
    _primary_values_file = chart_path + '/values.yaml'
    if chart_values_files != None and len(chart_values_files) > 0:
        _primary_values_file = chart_values_files[0]
    _early_values = read_yaml(_primary_values_file, default={})
    _early_lib = (_early_values.get(_lib_key, {}) or {})
    _workloads = _early_lib.get('workloads') or []

    # Phase 4: Resolve image strategy and register custom_build resources.
    _img_ctx = _resolve_image_strategy(
        name, language, builder, builder_image, extra_buildpacks,
        additional_env, live_reload, node_version, bp_log_level,
        image_labels, runtime_cert_binding, debug, debug_port,
        live_update_paths, image_ref, helm_only, build_path,
        chart_path, _lib_key, _workloads, _early_values, _early_lib)
    _builder_kind = _img_ctx['builder_kind']

    # Phase 5: Update helm dependencies.
    _update_helm_deps(chart_path)

    # Phase 6: DSL projection (rdx render).
    if chart_values_files == None:
        chart_values_files = [chart_path + '/values.yaml']
    chart_values_files = _run_dsl_projection(
        chart_path, _rdx_present, _stage, chart_values_files)

    # Phase 7: Helm deploy.
    helm_set = []
    if image_ref:
        helm_set.append('image.repository=' + _img_ctx['img_repo'])
        helm_set.append('image.tag=' + _img_ctx['img_tag'])

    if _builder_kind == 'bci':
        _bci_uid = int(os.getenv('RDX_BCI_RUNAS_UID', str(BCI_RUNAS_UID)))
        _bci_gid = int(os.getenv('RDX_BCI_RUNAS_GID', str(BCI_RUNAS_GID)))
        if _bci_uid >= 0:
            helm_set.append('%s.podSecurityContext.runAsUser=%d' % (_lib_key, _bci_uid))
            helm_set.append('%s.podSecurityContext.runAsGroup=%d' % (_lib_key, _bci_gid))

    # Every execution, not just first-run bootstrap: a conflicting
    # ingress (same hostname claimed by another namespace — typically a
    # workspace left running under an older namespace) makes Traefik
    # route that host to the wrong backend, and the resulting 502/wrong
    # -service symptoms surface on RE-runs just as much as on first
    # runs. One `kubectl get ingress -A` per project is cheap; the
    # warning must not disappear after bootstrap.
    _check_ingress_conflicts(chart_path, chart_values_files, namespace)

    k8s_yaml(helm(
        chart_path,
        name=name,
        namespace=namespace,
        values=chart_values_files,
        set=helm_set,
    ))

    # Phase 8: Parse values for service discovery and port resolution.
    parsed_values = []
    parsed_values_paths = []
    for vfile in chart_values_files:
        parsed_values.append(read_yaml(vfile, default={}))
        parsed_values_paths.append(vfile)

    # Port discovery (legacy single-workload mode).
    if not _workloads:
        discovered_port = 8080
        for cfg in parsed_values:
            lib = (cfg.get(_lib_key, {}) or {}) if cfg else {}
            if 'port' in lib:
                discovered_port = lib['port']
        if port == None:
            port = discovered_port
        elif port != discovered_port:
            fail((
                'rdx_app: port=%d passed explicitly but chart/values.yaml has ' +
                '%s.port=%d. The two would drift on every edit. ' +
                'Drop the port argument from rdx_app(...) — values.yaml is the ' +
                'source of truth (see rdx-docs/concepts/dsl.md). If you really ' +
                'need to override, change values.yaml.'
            ) % (port, _lib_key, discovered_port))

    # Phase 9: Auto-discover services.
    if services == None:
        services = _discover_services(parsed_values, parsed_values_paths, _lib_key)

    # Resolve domain for hairpin DNS and ingress links.
    _domain_value = ''
    for _cfg in parsed_values:
        _dl = (_cfg.get(_lib_key, {}) or {}) if _cfg else {}
        if 'domain' in _dl:
            _domain_value = _dl['domain']

    _apply_coredns_hairpin(_domain_value, name)

    # Phase 10: Read DSL mappings for service resource-name resolution.
    mappings_path = chart_path + '/charts/' + _lib_key + '/dsl-mappings.yaml'
    mappings_doc = read_yaml(mappings_path, default={'charts': {}})
    catalogued_charts = mappings_doc.get('charts', {})

    # Phase 11: Register service workloads (also computes OIDC deps).
    _app_oidc_deps = _register_service_workloads(
        name, namespace, services, _lib_key, parsed_values,
        parsed_values_paths, catalogued_charts, labels,
        _domain_value, _bootstrap_done)

    # Phase 12: Register app workloads.
    _register_app_workloads(
        name, _workloads, _lib_key, parsed_values, labels,
        _domain_value, _app_oidc_deps, port)

    # Phase 13: Declarative build block (DO-0016 P1). Consume
    # workloads_resolved[].build from the freshly projected overlay
    # (contract_version >= 1) and register the matching image build.
    # Legacy explicit build args win: a pack build already registered
    # by the language path keeps priority, with a deprecation warning
    # when a block is also present. Absent key = pull, unchanged.
    _register_declared_build(name, parsed_values, _lib_key, language,
                             image_ref, helm_only)

# ─── helm_rdx_chart() — helm-rdx plugin integration (rdx-cli v0.2.0+) ──
#
# Thin chart-rendering primitive that uses the helm-rdx plugin's
# `helm rdx template` (DSL projection + helm template in one shell call,
# no values.generated.yaml on disk) when available, and falls back to
# `rdx render` + Tilt's helm() builtin when not.
#
# Usage in a project Tiltfile:
#
#   load('ext://rdx', 'helm_rdx_chart')
#   helm_rdx_chart(name='my-app', stage='dev')
#   k8s_resource('my-app', port_forwards='8080:8080')
#
# Unlike rdx_app(), helm_rdx_chart() does NOT do pack build, helm dep
# update, namespace creation, port-forwarding, or pull-secret mirror —
# it's the chart-rendering step only. Compose with k8s_resource() for
# port-forwards. For the batteries-included experience, stick with
# rdx_app(); for projects already on rdx-cli v0.2.0+ that want the
# plugin's one-step flow without the legacy machinery, this is the hook.

def _check_ingress_conflicts(chart_path, values_files, namespace):
    """Warn if any ingress hostname is already claimed by another namespace."""
    lib_key = _detect_lib_key(chart_path)
    hosts = []
    for vfile in values_files:
        vals = read_yaml(vfile, default={})
        sl = vals.get(lib_key, {})
        domain = sl.get('domain', '')
        for svc in sl.get('services', []):
            if not svc.get('enabled', False):
                continue
            ing = svc.get('ingress', {})
            svc_hosts = ing.get('hosts', [])
            if ing.get('host'):
                svc_hosts = svc_hosts + [ing['host']]
            for h in svc_hosts:
                h = h.replace('{{.domain}}', domain)
                if h:
                    hosts.append(h)
    if not hosts:
        return
    out = str(local(
        'kubectl get ingress --all-namespaces -o ' +
        "jsonpath='{range .items[*]}{.metadata.namespace} {.spec.rules[*].host}{\"\\n\"}{end}' " +
        '2>/dev/null || true',
        quiet=True, echo_off=True,
    )).strip()
    for line in out.split('\n'):
        parts = line.strip().split(' ', 1)
        if len(parts) < 2:
            continue
        ing_ns, ing_host = parts[0], parts[1]
        if ing_ns == namespace:
            continue
        for h in hosts:
            if h == ing_host:
                warn(
                    ('[rdx] INGRESS CONFLICT: hostname %s is already claimed ' +
                     'by namespace %s — Traefik will route to the wrong service! ' +
                     'Fix: kubectl delete ingress -n %s -l app.kubernetes.io/instance ' +
                     'or tilt down the other project first.') % (h, ing_ns, ing_ns))


def _helm_rdx_plugin_present():
    """True iff `helm plugin list` reports a plugin named 'rdx'."""
    out = str(local(
        "helm plugin list 2>/dev/null | grep -qE '^rdx[[:space:]]' && " +
        "echo yes || echo no",
        quiet=True, echo_off=True,
    )).strip()
    return out == 'yes'


def helm_rdx_chart(
        name,
        chart_path=None,
        stage=None,
        values=None,
        namespace=None,
        set=[]):
    """Render a Helm chart with `helm rdx template` and apply the result.

    Detects the helm-rdx plugin (rdx-cli v0.2.0+); when present, runs
    `helm rdx template` directly — DSL projection and `helm template`
    happen in one shell call, no intermediate file on disk. When the
    plugin is absent, falls back to running `rdx render` and then
    Tilt's helm() builtin, with a one-line warning so the dev knows to
    install the plugin for the faster path.

    Args:
        name (str): Helm release name.
        chart_path (str|None): path to the Helm chart relative to the
            Tiltfile. Default: auto-detected — prefers `deploy/` (bundle
            v0.11.13+ scaffolds), falls back to `chart/`.
        stage (str|None): rdx stage (e.g. 'dev', 'staging'). Passed to
            `helm rdx template --stage`. When None, the plugin uses its
            own default (typically the project's current `.rdx/stage`).
        values (list[str]|None): values files passed to helm (-f).
            Default [chart_path + '/values.yaml'].
        namespace (str|None): target Kubernetes namespace. Default:
            helm's default. Pass an explicit value to land the release
            in a project-scoped namespace.
        set (list[str]): inline value overrides (helm --set). E.g.
            ['image.tag=v2.3.1', 'replicaCount=3'].
    """
    if chart_path == None:
        if os.path.exists('deploy/Chart.yaml'):
            chart_path = 'deploy'
        elif os.path.exists('chart/Chart.yaml'):
            chart_path = 'chart'
        else:
            chart_path = 'chart'

    if values == None:
        values = [chart_path + '/values.yaml']

    # Stage auto-detection for the fallback path (same logic as rdx_app).
    if stage == None:
        _fb_stage = os.getenv('RDX_STAGE', '')
        if not _fb_stage:
            _fb_stage_file = os.path.join(chart_path, '..', '.rdx', 'stage')
            if os.path.exists(_fb_stage_file):
                _fb_stage = str(read_file(_fb_stage_file)).strip()
        if not _fb_stage:
            _fb_stage = 'dev'
        stage = _fb_stage

    if _helm_rdx_plugin_present():
        # Plugin path: one shell call. `helm rdx template` does the DSL
        # projection AND `helm template` — no values.generated.yaml on
        # disk for Tilt to garbage-collect.
        args = ['helm', 'rdx', 'template', name, chart_path]
        if namespace:
            args.extend(['--namespace', namespace])
        if stage:
            args.extend(['--stage', stage])
        for vfile in values:
            args.extend(['-f', vfile])
        for kv in set:
            args.extend(['--set', kv])
        k8s_yaml(local(' '.join(args), quiet=True, echo_off=True))
        return

    # Fallback: helm-rdx plugin absent. Run `rdx render` (writes
    # chart/.rdx/values.generated.yaml) then layer the overlay onto the
    # user's values list before handing off to Tilt's helm() builtin.
    rdx_present = str(local(
        'command -v rdx > /dev/null 2>&1 && echo yes || echo no',
        quiet=True, echo_off=True,
    )).strip()
    if rdx_present == 'yes':
        print('helm_rdx_chart: helm-rdx plugin not installed; falling back ' +
              'to `rdx render` + helm template. Install the plugin for the ' +
              'one-step flow (rdx-cli v0.2.0+).')
        local('rdx render --stage %s' % stage, quiet=True, echo_off=False)
        overlay = chart_path + '/.rdx/values.generated.yaml'
        if os.path.exists(overlay) and overlay not in values:
            values = values + [overlay]
    else:
        print('helm_rdx_chart: warning — neither the helm-rdx plugin nor ' +
              'the `rdx` CLI is on PATH. The chart will render without DSL ' +
              'projection; sub-chart values from rdx-library.services[] ' +
              'will not reach their targets. Install rdx-cli v0.2.0+.')

    k8s_yaml(helm(
        chart_path,
        name=name,
        namespace=namespace or '',
        values=values,
        set=set,
    ))
